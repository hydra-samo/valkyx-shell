import QtQuick 2.15
import QtQuick.Controls 2.15
import QtQuick.Layouts 1.15

Rectangle {
    id: root
    color: "#0a1210"
    property bool loginFailedFlag: false

    // background
    Image {
        anchors.fill: parent
        source: config.background
        fillMode: Image.PreserveAspectCrop
        asynchronous: false
    }
    Rectangle { anchors.fill: parent; color: "#660a1210" }

    ColumnLayout {
        anchors.centerIn: parent
        spacing: 18

        Image {
            source: config.logo
            Layout.alignment: Qt.AlignHCenter
            Layout.preferredWidth: 110
            Layout.preferredHeight: 110
            fillMode: Image.PreserveAspectFit
        }

        Text {
            Layout.alignment: Qt.AlignHCenter
            text: "HYDRA SAMO"
            color: "#00A86B"
            font.family: "Space Grotesk"
            font.pixelSize: 20
            font.letterSpacing: 6
            font.bold: true
        }

        Text {
            id: clockText
            Layout.alignment: Qt.AlignHCenter
            color: "#e6eae8"
            font.family: "Space Grotesk"
            font.pixelSize: 30
            Timer {
                interval: 5000; running: true; repeat: true
                onTriggered: clockText.text = Qt.formatDateTime(new Date(), "HH:mm")
            }
            Component.onCompleted: text = Qt.formatDateTime(new Date(), "HH:mm")
        }

        Text {
            Layout.alignment: Qt.AlignHCenter
            text: sddm.fullName !== "" ? sddm.fullName : sddm.user
            color: "#8a938f"
            font.family: "Space Grotesk"
            font.pixelSize: 12
            font.letterSpacing: 2
        }

        TextField {
            id: password
            Layout.alignment: Qt.AlignHCenter
            Layout.preferredWidth: 260
            echoMode: TextInput.Password
            placeholderText: "password"
            font.family: "Space Grotesk"
            font.pixelSize: 13
            color: "#e6eae8"
            placeholderTextColor: "#5a635f"
            background: Rectangle {
                radius: 10
                color: "#161d1a"
                border.color: password.activeFocus ? "#00A86B" : (root.loginFailedFlag ? "#c96a6a" : "#1e2422")
                border.width: 1
            }
            onAccepted: doLogin()
        }

        Text {
            id: failLabel
            Layout.alignment: Qt.AlignHCenter
            visible: root.loginFailedFlag
            text: "authentication failed"
            color: "#c96a6a"
            font.family: "Space Grotesk"
            font.pixelSize: 11
        }

        RowLayout {
            Layout.alignment: Qt.AlignHCenter
            spacing: 10
            Button {
                text: "Log in"
                onClicked: doLogin()
                contentItem: Text { text: parent.text; color: "#04140d"; font.family: "Space Grotesk"; font.pixelSize: 12; horizontalAlignment: Text.AlignHCenter }
                background: Rectangle { radius: 8; color: parent.enabled ? "#00A86B" : "#0e3d2b" }
            }
            ComboBox {
                id: sessionBox
                model: sddm.sessions2 ? sddm.sessions2 : []
                textRole: "name"
                displayText: currentText
                width: 140
                background: Rectangle { radius: 8; color: "#161d1a"; border.color: "#1e2422" }
                contentItem: Text { text: parent.displayText; color: "#e6eae8"; font.family: "Space Grotesk"; font.pixelSize: 11; verticalAlignment: Text.AlignVCenter; leftPadding: 8 }
            }
        }

        RowLayout {
            Layout.alignment: Qt.AlignHCenter
            spacing: 16
            Text { text: "Reboot"; color: "#8a938f"; font.family: "Space Grotesk"; font.pixelSize: 10
                   MouseArea { anchors.fill: parent; cursorShape: Qt.PointingHandCursor; onClicked: sddm.reboot() } }
            Text { text: "Shut down"; color: "#8a938f"; font.family: "Space Grotesk"; font.pixelSize: 10
                   MouseArea { anchors.fill: parent; cursorShape: Qt.PointingHandCursor; onClicked: sddm.powerOff() } }
        }
    }


    function doLogin() {
        var sess = (sessionBox.count > 0 && sessionBox.currentIndex >= 0)
                 ? sddm.sessions2[sessionBox.currentIndex].key
                 : sddm.lastSession
        sddm.login(sddm.user, password.text, sess)
    }

    Connections {
        target: sddm
        function onLoginFailed() { root.loginFailedFlag = true; password.selectAll(); password.forceActiveFocus() }
    }

    Component.onCompleted: {
        console.log("THEME-LOADED-MARKER")
        if (sddm.lastSession !== "") {
            var lst = sddm.sessions2 || []
            for (var i = 0; i < lst.length; i++) {
                if (lst[i].key === sddm.lastSession) { sessionBox.currentIndex = i; break }
            }
        }
        password.forceActiveFocus()
    }
}
