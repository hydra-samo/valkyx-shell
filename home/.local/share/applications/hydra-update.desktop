[Desktop Entry]
Type=Application
Name=VALKYX Update
GenericName=Apply config
Comment=Validate, snapshot, reload compositor and shell, then verify
Exec=kitty --hold -e $HOME/.local/bin/valkyx-update
Icon=system-software-install
Terminal=false
Categories=System;
Keywords=valkyx;update;apply;reload;config;
NoDisplay=false
StartupNotify=true
