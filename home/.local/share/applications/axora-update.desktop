[Desktop Entry]
Type=Application
Name=AXORA Update
GenericName=Apply config
Comment=Validate, snapshot, reload compositor and shell, then verify
Exec=kitty --hold -e $HOME/.local/bin/axora-update
Icon=system-software-install
Terminal=false
Categories=System;
Keywords=axora;update;apply;reload;config;
NoDisplay=false
StartupNotify=true
