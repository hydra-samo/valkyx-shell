[Desktop Entry]
Type=Application
Name=AXORA Console
Comment=Content uploads, atmosphere & agent (standalone app window)
Exec=/usr/bin/helium-browser --app=http://127.0.0.1:1717/dashboard --class=AXORAStudioDash --user-data-dir=$HOME/.local/share/axora-studio/console-profile --no-first-run --no-default-browser-check
Icon=axora-logo
Terminal=false
Categories=Development;
StartupWMClass=AXORAStudioDash
X-KDE-StartupNotify=false
