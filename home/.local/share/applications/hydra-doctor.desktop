[Desktop Entry]
Type=Application
Name=HYDRA Doctor
GenericName=Health check
Comment=Check compositor, shell, dispatchers, helpers, input and hardware
Exec=kitty --hold -e $HOME/.local/bin/hydra-doctor
Icon=preferences-desktop-display
Terminal=false
Categories=System;
Keywords=hydra;doctor;health;diagnose;check;
NoDisplay=false
StartupNotify=true
