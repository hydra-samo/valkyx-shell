[Desktop Entry]
Type=Application
Name=VALKYX Welcome Report
GenericName=Shell report
Comment=Terminal report: wordmark, system facts and shell health
Exec=kitty --hold -e $HOME/.local/bin/valkyx-welcome
Icon=valkyx
Terminal=false
Categories=System;
Keywords=valkyx;welcome;report;system;
NoDisplay=false
StartupNotify=true
