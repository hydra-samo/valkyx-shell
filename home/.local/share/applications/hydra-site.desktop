[Desktop Entry]
Type=Application
Name=VALKYX LABS
Comment=Live local portfolio (standalone app window)
Exec=/usr/bin/helium-browser --app=http://127.0.0.1:1717/ --class=VALKYXStudioSite --user-data-dir=$HOME/.local/share/valkyx-studio/site-profile --no-first-run --no-default-browser-check
Icon=valkyx
Terminal=false
Categories=Development;
StartupWMClass=VALKYXStudioSite
X-KDE-StartupNotify=false
