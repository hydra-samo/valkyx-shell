#!/bin/bash
# axora-gtk-icons <ThemeName> <AccentHex> — make the GTK icon theme follow the
# shell theme. Builds a tiny per-accent override of the MacTahoe identity set:
# only the ~136 accent SVGs differ, so the override ships just those recolored
# and Inherits the untouched base. Any theme/accent works — nothing hardcoded.
set -euo pipefail
name="${1:-Axora}"
accent="${2:-00A86B}"
accent="#${accent#\#}"
accent="${accent,,}"
base="/usr/share/icons/MacTahoe-green-dark"
dir="/usr/share/icons/MacTahoe-${name}-dark"

# index the accent files once (files in green-dark that differ from the neutral
# variant, or exist only there). green-dark = base identity with green folders;
# the darker variant files they replace are the ones carrying the accent color.
list="/tmp/mactahoe-accent-${name}.txt"
if [ ! -s "$list" ]; then
    diff -rq /usr/share/icons/MacTahoe-dark "$base" 2>/dev/null \
        | sed -n 's/^Files \/usr\/share\/icons\/MacTahoe-dark\/\(.*\) and \/.*\/\(.*\) differ$/\1/p' \
        | sort -u > "$list" || true
fi

# (re)build the override only when needed. The 6 preset themes are pre-built and
# carry an accent stamp — those switch instantly. A different/new accent (future
# theme, or one-off) rebuilds fresh.
stamp="$dir/.accent-${accent}"
if [ ! -f "$stamp" ]; then
    sudo -n rm -rf "$dir"
    sudo -n mkdir -p "$dir"
    while IFS= read -r rel; do
        [ -z "$rel" ] && continue
        src="$base/$rel"
        if [ -f "$src" ]; then
            sudo -n install -Dm644 "$src" "$dir/$rel"
        fi
    done < "$list"

    sudo -n python3 - "$dir" "$accent" <<'PY'
import os, sys, re
root, accent = sys.argv[1], sys.argv[2].lower()
rx = re.compile(r'#27[dD]83[dD]', re.I)
for dp, _, fs in os.walk(root):
    for f in fs:
        if not f.endswith(".svg"): continue
        p = os.path.join(dp, f)
        s = open(p, encoding="utf-8", errors="ignore").read()
        if "#27d83d" in s.lower():
            open(p, "w", encoding="utf-8").write(rx.sub(accent, s))
PY
    sudo -n touch "$stamp"
fi

# index.theme: Name + Inherits the full base set (override is a delta).
# Directories MUST list the dirs we ship — without it GTK cannot enumerate the
# accent SVGs and silently falls back to the inherited base.
# Filter: drop the stray index.theme filename, and put @2x dirs under
# ScaledDirectories (scale=2) not Directories, so HiDPI works.
dirs=$(sed 's@/[^/]*$@@' "$list" | sort -u | rg '^[^@]+/(scalable|symbolic|[0-9]+)$' || true)
scaled=$(sed 's@/[^/]*$@@' "$list" | sort -u | rg '^[^@]+@2x/' || true)
cat > /tmp/mactahoe-index.theme <<EOF
[Icon Theme]
Name=MacTahoe-${name}-dark
Comment=MacOSX Tahoe style icon theme, ${name} accent (shell theme).
Inherits=MacTahoe-green-dark
Example=folder
Directories=$(echo "$dirs" | paste -sd, -)
ScaledDirectories=$(echo "$scaled" | paste -sd, -)
EOF
for d in $dirs; do
    ctx=$(case "${d%%/*}" in actions) echo Actions;; apps) echo Applications;; devices) echo Devices;; emblems) echo Emblems;; emotes) echo Emoticons;; mimes) echo MimeTypes;; places) echo FileSystems;; status) echo Status;; animations) echo Animations;; categories) echo Categories;; preferences) echo Preferences;; *) echo Other;; esac)
    case "$d" in
        */scalable) size="Size=16"; typ=Scalable ;;
        */symbolic) size="Size=16"; typ=Scalable ;;
        *) size="Size=${d##*/}"; typ=Fixed ;;
    esac
    case "$d" in
        */scalable|*/symbolic) minmax="
MinSize=8
MaxSize=512" ;;
        *) minmax= ;;
    esac
    echo "
[$d]
$size
Context=$ctx
Type=$typ$minmax" >> /tmp/mactahoe-index.theme
done
for d in $scaled; do
    ctx=$(case "${d%%/*}" in actions) echo Actions;; apps) echo Applications;; devices) echo Devices;; emblems) echo Emblems;; emotes) echo Emoticons;; mimes) echo MimeTypes;; places) echo FileSystems;; status) echo Status;; animations) echo Animations;; categories) echo Categories;; preferences) echo Preferences;; *) echo Other;; esac)
    case "$d" in
        *@2x/scalable) size="Size=16"; typ=Scalable ;;
        *@2x/symbolic) size="Size=16"; typ=Scalable ;;
        *) size="Size=${d##*/}"; typ=Fixed ;;
    esac
    echo "
[$d]
$size
Context=$ctx
Type=$typ
Scale=2" >> /tmp/mactahoe-index.theme
done
sudo -n install -m644 /tmp/mactahoe-index.theme "$dir/index.theme"

# cache for fast lookup
sudo -n gtk-update-icon-cache -f -q "$dir" 2>/dev/null || true

# apply system-wide so Thunar + every GTK app pick it up.
# settings.ini is read FIRST by GTK3/4 — no gsettings/dconf/Gnome needed.
for f in ~/.config/gtk-3.0/settings.ini ~/.config/gtk-4.0/settings.ini; do
    [ -f "$f" ] || continue
    grep -q '^gtk-icon-theme-name' "$f" \
        && sed -i "s|^gtk-icon-theme-name=.*|gtk-icon-theme-name=MacTahoe-${name}-dark|" "$f" \
        || echo "gtk-icon-theme-name=MacTahoe-${name}-dark" >> "$f"
done

# XSETTINGS broadcast so RUNNING apps (Thunar already open) switch live
if [ -f ~/.xsettingsd ]; then
    grep -q '^Gtk/IconThemeName' ~/.xsettingsd \
        && sed -i "s|^Gtk/IconThemeName.*|Gtk/IconThemeName \"MacTahoe-${name}-dark\"|" ~/.xsettingsd \
        || echo "Gtk/IconThemeName \"MacTahoe-${name}-dark\"" >> ~/.xsettingsd
    pkill -x xsettingsd 2>/dev/null || true
    setsid xsettingsd >/dev/null 2>&1 </dev/null & disown
fi

echo "icon theme -> MacTahoe-${name}-dark (accent ${accent})"