#!/bin/bash
# valkyx-welcome — what this session is, and whether it is healthy.
#
# Shown by the launcher's "VALKYX Welcome" entry. Deliberately just a reader:
# it prints the environment and then delegates the verdict to valkyx-doctor, so
# there is exactly one health check in the system and it can never disagree
# with itself.

set -uo pipefail
G=$'\033[32m'   # green
D=$'\033[2m'    # dim
R=$'\033[0m'

"$HOME/.local/bin/valkyx-figlet" valkyx welcome
echo
printf '  %sVALKYX LABS%s  %s· valkyx shell%s\n' "$G" "$R" "$D" "$R"
printf '  %-18s %s\n' "host"      "$(uname -n)"
printf '  %-18s %s\n' "kernel"    "$(uname -r)"
printf '  %-18s %s\n' "session"   "${XDG_CURRENT_DESKTOP:-unknown} / $(pgrep -c -x Hyprland) hyprland"
printf '  %-18s %s\n' "workspaces" "$(hyprctl workspaces -j 2>/dev/null | python3 -c 'import json,sys
try: print(" ".join(w["name"] for w in json.load(sys.stdin) if not w.get("special")))
except Exception: print("-")' 2>/dev/null)"
printf '  %-18s %s\n' "kb layout" "$(hyprctl getoption input:kb_layout 2>/dev/null | sed -n 's/^str: //p')"
printf '  %-18s %s\n' "theme"     "$(python3 -c 'import json,os
try: print(json.load(open(os.path.expanduser("~/.config/valkyx/state.json")))["themeName"])
except Exception: print("-")' 2>/dev/null)"
printf '  %-18s %s\n' "accent"    "$(python3 -c 'import json,os
try: print(json.load(open(os.path.expanduser("~/.config/valkyx/state.json")))["accent"])
except Exception: print("-")' 2>/dev/null)"
printf '  %-18s %s\n' "uptime"    "$(uptime -p 2>/dev/null | sed 's/^up //')"
echo
echo "  ${D}health:${R}"
"$HOME/.local/bin/valkyx-doctor" -q
echo
printf '  %sfull report:%s valkyx-doctor        %sapply config:%s valkyx-update\n' "$D" "$R" "$D" "$R"
