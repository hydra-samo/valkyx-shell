#!/usr/bin/env bash
# hydra-class-icon <class> — resolve a running window class to a real app icon
# (from .desktop Icon=, resolved against the hicolor/Papirus icon themes).
# Emits "file:///path" or the generic PNG on failure. One class per call.
set -u

cls="${1:-}"
[ -z "$cls" ] && { echo "/usr/share/icons/Papirus/48x48/apps/utilities-terminal.svg"; exit 0; }

icon_name=""
desktop=""
for d in /usr/share/applications /usr/local/share/applications "$HOME/.local/share/applications" /var/lib/flatpak/exports/share/applications; do
  [ -d "$d" ] || continue
  desktop=$(grep -il "StartupWMClass=$cls$" "$d"/*.desktop 2>/dev/null | head -1 || true)
  [ -n "$desktop" ] && break
  # fallback: Exec basename equals class
  desktop=$(grep -ilE "^Exec=${cls}( |$)" "$d"/*.desktop 2>/dev/null | head -1 || true)
  [ -n "$desktop" ] && break
  # flatpak fallback: class matches Icon= (app ID = icon name)
  desktop=$(grep -ilE "^Icon=${cls}$" "$d"/*.desktop 2>/dev/null | head -1 || true)
  [ -n "$desktop" ] && break
  # fuzzy: class matches Name= field (handles "Free Download Manager" vs StartupWMClass=fdm)
  desktop=$(grep -ilE "^Name=.*${cls}" "$d"/*.desktop 2>/dev/null | head -1 || true)
  [ -n "$desktop" ] && break
done

if [ -n "$desktop" ]; then
  icon_name=$(sed -n 's/^Icon=//p' "$desktop" | head -1)
fi
[ -z "$icon_name" ] && icon_name="utilities-terminal"

for base in "$HOME/.local/share/icons" /usr/share/icons; do
  for size in scalable 256x256 128x128 64x64 48x48 32x32 24x24; do
    for ext in svg png; do
      for theme in "$base/hicolor/$size/apps" "$base/Papirus/$size/apps"; do
        p="$theme/$icon_name.$ext"
        if [ -f "$p" ]; then echo "file://$p"; exit 0; fi
      done
    done
  done
done
for ext in png svg; do
  p="/usr/share/pixmaps/$icon_name.$ext"
  if [ -f "$p" ]; then echo "file://$p"; exit 0; fi
done
echo "/usr/share/icons/Papirus/48x48/apps/utilities-terminal.svg"