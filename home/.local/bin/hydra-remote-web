   +'<rect width="6" height="6" x="9" y="9"/>'
   +'<path d="M15 2v2M15 20v2M2 15h2M2 9h2M20 15h2M20 9h2M9 2v2M9 20v2"/>',
 key:'<circle cx="7.5" cy="15.5" r="5.5"/><path d="m21 2-9.6 9.6"/><path d="m15.5 7.5 2.3 2.3a1 1 0 0 0 1.4 0l2.1-2.1a1 1 0 0 0 0-1.4L19 4"/>',
};
// One place that paints an icon, so a rename cannot leave half the buttons blank.
function ico(el,name){ if(el) el.innerHTML='<svg viewBox="0 0 24 24" aria-hidden="true">'+ICON[name]+'</svg>'; }
ico($('hup'),'up'); ico($('hdn'),'dn'); ico($('hexit'),'min');
ico($('shclose'),'x'); ico($('sendt'),'send');
ico($('live'),'play'); ico($('fsbtn'),'max'); ico($('fsauto'),'zap');
ico($('hmode'),'hand');
for(const [sel,name] of [[0,'keyboard'],[1,'cpu'],[2,'inbox'],[3,'grid'],[4,'key']])
  ico(document.querySelectorAll('#rail .ib')[sel],name);
// ── navigation ────────────────────────────────────────────────────────────────
// One sheet, five panes, swapped with a transform. One pane, one job: keys
// sends keys, machine drives panels and windows, queue is the agent, hub is
// channels, token is the secret. Nothing else appears in any of them. No page scroll anywhere, and
// every destination is a single tap on the right edge where the thumb already is.
let pane=null;
const SHEET=$('sheet');
function openPane(p){
  if(p!=='keys') clearMods();   // never walk away holding ctrl
  pane=(pane===p)?null:p;
  for(const el of document.querySelectorAll('#sheet .body>div'))
    el.hidden=(el.id!=='p-'+pane);
  $('shtitle').textContent=pane||'';
  SHEET.classList.toggle('on',!!pane);
  for(const b of document.querySelectorAll('#rail .ib'))
    b.classList.toggle('on',!!pane && b.dataset.p===pane);
  if(pane==='queue'||pane==='hub') paint();
  // A pane opened by a gesture is the one thing here with no pixel evidence:
  // screencap is frozen on this phone and release Brave sends no console to
  // logcat, so "the swipe did nothing" and "the swipe opened the wrong pane"
  // are indistinguishable from the outside. Say which pane, every time.
  report('pane '+(pane||'closed'));
  showChrome();
}
$('shclose').onclick=()=>openPane(pane);
for(const b of document.querySelectorAll('#rail .ib')) b.onclick=()=>openPane(b.dataset.p);
// Tapping the picture is a click on the desktop, so the sheet closes on the grip
// and the close button only -- never on a stray tap, which would eat the click.
$('grip').onclick=()=>openPane(pane);
wireFS();
// Bookmarkable entry point: /shell/?fps=30&live=1 starts the stream at a known
// frame rate. On a ~2 Mbps phone link fps and per-frame bits trade directly
// against each other, so "60" is not free -- 30 is the honest default.
const QP=new URLSearchParams(location.search);
if(QP.has('fps')) fps=Math.min(60,Math.max(5,parseInt(QP.get('fps'),10)||30));
if(QP.has('br')) vbr=Math.min(12000,Math.max(400,parseInt(QP.get('br'),10)||4000));
setInterval(watchdog,2500);
document.getElementById('live').onclick=function(){
  live=!live;
  ico(this,live?'pause':'play'); this.classList.toggle('on',live);
  clearTimeout(window._live);
  if(live){
    // Stream, don't poll: one open socket carrying multipart/x-mixed-replace, so
    // the browser paints frames as they land. Polling spent ~130ms/frame on pure
    // round-trip overhead — more than the capture itself ever cost.
    // The token rides a COOKIE, not a query string: an <img src> cannot send
    // headers, and a secret in the URL would land in the request log forever.
    document.cookie='hydra_token='+encodeURIComponent(T())+'; path=/; SameSite=Strict';
    streaming=true;
    videoStart().catch(e=>{ report('videoStart failed: '+e);   // MSE missing or codec refused: JPEG frames
      stopVideo();                    // still stream, just without video smoothness
      SCR.src='stream?q='+qual+'&fps='+fps;
    });
    // An <img> cannot read a status code, so a dead token here is indistinguishable
    // from a broken image -- except that it is neither: the server answered 401.
    // Probe once with fetch (which CAN see the status) before retrying the poller,
    // or an expired token silently bounces between /video and /stream forever.
    SCR.onerror=async()=>{
      if(streaming&&T()){
        try{
          const h=await fetch('video?fps=1&w=64&h=48',{headers:{'X-Hydra-Token':T()}});
          if(h.status===401||h.status===403){ authFailed(); return; }
        }catch(_){}
      }
      if(streaming&&!videoOn){ streaming=false; frames=0; fpsT=performance.now(); loop(); }
    };
    // No SCR.src here: pointing the <img> at MJPEG as well as decoding H.264
    // spends the link twice over, and the JPEG stream wins the bandwidth.
    METER.textContent='video \\u00b7 '+fps+' fps \\u00b7 q'+qual+' \\u00b7 H.264';
  }else{
    streaming=false;
    stopVideo();
    SCR.removeAttribute('src');
    METER.textContent='paused';
  }
};
if(QP.get('live')==='1') document.getElementById('live').click();
// No seeded rows: refreshHub() is the only writer, so the pane can never show a
// channel that the server does not actually serve.
refreshHub();
// The verb groups used to append their own <section> to <body>, a structure that
// no longer exists. They join the keys pane instead.
// ── remote keypad ───────────────────────────────────────────────────────────
// Arrows, modifiers, navigation and the shell's own keybinds. Every name here is
// one `hydra-remote key` ALREADY accepts, so the pad adds no verb and no server
// path: a keybind IS a chord, and the helper already splits the arg on '+'.
//
// Modifiers are STICKY, because a touchscreen cannot hold a key down: tap ctrl,
// tap a key, it fires once with ctrl and the modifier clears itself. Arrows and
// the nav cluster REPEAT while held, which is the whole difference between
// "arrows exist" and "arrows are usable" -- one 250ms keydown moves ONE pixel on
// a 1366px desktop, so tapping an arrow to cross a room is hopeless.
// Nothing here touches a <video>: the pad has to work when MSE was refused and
// there is no frame at all.
const MODS=['ctrl','alt','shift','super'];
let mods=[];
function clearMods(){ mods=[]; for(const b of padEl.children) b.classList.remove('stick'); }
function padGroup(label,items,kind){
  if(label){ const h=document.createElement('h2'); h.textContent=label; padEl.appendChild(h); }
  for(const it of items){
    // A bare string is its own label; a [label,name] pair is for when they differ
    // (an arrow glyph, or a chord that reads as words).
    const [txt,name]=Array.isArray(it)?it:[it,it];
    const k=(Array.isArray(it)&&it[2])?it[2]:kind;
    const b=document.createElement('button');
    b.className='k'; b.textContent=txt; b.title=name;
    padEl.appendChild(b);
    b.addEventListener('pointerdown',e=>{
      e.preventDefault();
      try{ b.setPointerCapture(e.pointerId); }catch(_){}
      if(k==='mod'){                          // latch, or unlatch if already on
        const i=mods.indexOf(name);
        if(i<0) mods.push(name); else mods.splice(i,1);
        b.classList.toggle('stick',i<0);
        return;                               // a modifier never fires by itself
      }
      // Resolve the chord ONCE and repeat that, so a modifier latched mid-hold
      // cannot change what the held key is sending.
      const chord=(k==='chord')?name:mods.concat(name).join('+');
      // A key the verb does not know prints "unknown key: lefft" and does nothing.
      // On a phone that is invisible, so failures speak and successes stay quiet.
      call('key',chord).then(r=>{ if(!/ ok$/.test(r)) say(r); });
      if(k==='mod'||k==='chord') return;
      clearMods();
      if(k!=='rep') return;
      let t=setTimeout(function tick(){ call('key',chord); t=setTimeout(tick,140); },400);
      const stop=()=>{ clearTimeout(t);
        b.removeEventListener('pointerup',stop); b.removeEventListener('pointercancel',stop); };
      b.addEventListener('pointerup',stop); b.addEventListener('pointercancel',stop);
    });
  }
}
const padEl=$('pad');
padGroup('modifier',MODS,'mod');
padGroup('arrows',[['←','left'],['↑','up'],['↓','down'],['→','right']],'rep');
padGroup('navigation',['home','end','pgup','pgdn','tab','enter','bsp','del','space','esc'],'rep');
// The shell's own keybinds as chords (hydra-remote key already accepts these names).
padGroup('shell',[['term','super+enter'],['launch','super+space'],['files','super+e'],
  ['browser','super+b'],['code','super+c'],['settings','super+i'],['panel','super+s'],
  ['fullscreen','super+f'],['close','super+q'],['float','super+t'],['theme','super+shift+t'],
  ['lock','super+ctrl+alt+l'],['wallpaper','super+w'],['clipboard','super+shift+v'],
  ['scratchpad','super+grave'],['power','super+x'],['prevws','super+comma'],['nextws','super+period']],'chord');
padGroup('function',['f1','f2','f3','f4','f5','f6','f7','f8','f9','f10','f11','f12']);
// Workspace chords labelled with workspace NAMES (that is what hyprctl wants).
// Shell chords mirror hyprland.lua; names live in hydra-remote's kcode table.
padGroup('workspace',[['studio','super+1'],['create','super+2'],['code','super+3'],
  ['research','super+4'],['personal','super+5'],['game','super+6']],'chord');
for(const [title,verbs] of GROUPS){
  const h=document.createElement('h2'); h.textContent=title; $('verbs').appendChild(h);
  for(const v of verbs){
    const b=document.createElement('button');
    b.textContent=v; b.className='k'+(v.startsWith('power')?' warn':'');
    b.title=title;
    b.onclick=()=>go(v); $('verbs').appendChild(b);
  }
}
</script></body></html>"""


