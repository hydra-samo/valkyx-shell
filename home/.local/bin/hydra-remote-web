#!/usr/bin/env python3
"""hydra-remote-web — phone control surface for the HYDRA shell.

Binds 127.0.0.1 ONLY and is published with `tailscale serve`; never bind 0.0.0.0.

Security model (do not weaken):
  * The verb whitelist lives in `hydra-remote`. This server passes exactly ONE
    argument through and lets that script reject anything unknown, so the
    whitelist has a single home and cannot drift from this file.
  * No user input is ever concatenated into a shell string.
  * CSRF: requires header X-Hydra-Token. A cross-origin HTML form cannot set a
    custom header, and no CORS headers are sent, so a random web page the phone
    visits cannot drive this even while it is signed in.
  * Tailscale identity is the outer auth (tailnet-only HTTPS).

Usage: hydra-remote-web [--port N]
"""
import argparse
import hmac
import http.server
import json
import re
import pathlib
import secrets
import struct
import os
import select
import subprocess, threading, time
import sys

TOKEN_FILE = pathlib.Path.home() / ".local/state/hydra/remote-token"
HELPER = str(pathlib.Path.home() / ".local/bin/hydra-remote")
REMOTE_JSON = pathlib.Path.home() / ".config" / "hydra" / "remote.json"

# One-shot kick, set by POST /kick. The server cannot push, so applying new
# defaults means making the phone reconnect; that is what re-reads them.
# Module-level because the video handler runs on its own thread and the flag has
# to be visible to it. Self-clearing: consumed by the first loop that sees it,
# so a kick can never leave the stream permanently down.
KICK = False

_REMOTE_DEFAULTS = {"fps": 30, "br": 4000, "w": 1366, "h": 768, "ladder": True}
_REMOTE_SIZES = ((1366, 768), (1024, 576), (854, 480))


def load_remote_defaults():
    """PC-side defaults for /video. Per request, uncached, never raises.

    Duplicated from the console's settings.py on purpose: this file must not
    import the app (the app is not installed, and a broken console must not take
    the remote down). Both sides validate against the same three sizes, and a
    disagreement would show up immediately as an allowlist rejection.
    """
    global _REMOTE_DEFAULTS
    try:
        raw = json.loads(REMOTE_JSON.read_text())
    except (OSError, ValueError):
        return dict(_REMOTE_DEFAULTS)
    if not isinstance(raw, dict):
        return dict(_REMOTE_DEFAULTS)
    out = dict(_REMOTE_DEFAULTS)
    for k, lo, hi in (("fps", 5, 60), ("br", 400, 12000)):
        v = raw.get(k)
        if isinstance(v, int) and not isinstance(v, bool) and lo <= v <= hi:
            out[k] = v
    pair = (raw.get("w"), raw.get("h"))
    if pair in _REMOTE_SIZES:
        out["w"], out["h"] = pair
    out["ladder"] = bool(raw.get("ladder", True))
    return out

# PAGE must be RAW. As a normal triple-quoted string Python eats the JS escapes:
# '\n\n' became two real newlines inside a single-quoted JS literal, which is a
# SyntaxError — and every HTTP-level check still passed, so the page just rendered
# dead. Found by running `node --check` on the extracted <script>, which is now
# what `hydra-hub-check` does on every health run.
