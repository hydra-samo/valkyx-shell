<script>
const TKEY='hydra.remote.token';
const T=()=>document.getElementById('tok').value.trim();
// Same origin as the /hub console page, so a token saved there is already here.
// Once a token works the box gets out of the way — it is only needed the first
// time, or when rotating it.
const TOKIN=document.getElementById('tok');
const TOKSTAT=document.getElementById('tokstat');
// Re-arm without a phone keyboard: #token=... is a URL *fragment*, and fragments
// are never sent to a server, so it cannot leak into any request log. Scrubbed
// from the address bar immediately so it is not left sitting in view or in history.
if(location.hash.indexOf('#token=')===0){
  const v=decodeURIComponent(location.hash.slice(7));
  TOKIN.value=v;
  // Persist HERE, not on 'change'. Setting .value programmatically fires no
  // change event, so without this the re-arm URL works for exactly one page load
  // and the next reload restores the STALE token from localStorage -- which looks
  // like the rotation never took.
  if(v) localStorage.setItem(TKEY,v); else localStorage.removeItem(TKEY);
  history.replaceState(null,'',location.pathname+location.search);
  tokUI();
}
function tokUI(){
  const has=!!T();
  TOKIN.hidden=has;
  document.getElementById('tokedit').textContent=has?'change':'paste token';
  TOKSTAT.textContent=has?'token saved on this device':'no token';
  TOKSTAT.className=has?'on':'';
}
document.getElementById('tok').value=localStorage.getItem(TKEY)||'';
document.getElementById('tokedit').onclick=()=>{
  TOKIN.hidden=false; TOKIN.focus();
};
TOKIN.addEventListener('change',()=>{
  const v=TOKIN.value.trim();
  if(v) localStorage.setItem(TKEY,v); else localStorage.removeItem(TKEY);
  tokUI();
});
const OUT=document.getElementById('out');
const QLOG=document.getElementById('qlog');   // was id="live": collided with the
// play button, so getElementById('live') returned the BUTTON and paint()
// overwrote its label with the queue log every 10s.
const HUB=document.getElementById('hub');
const say=m=>OUT.textContent=m;
// One place decides what an expired token looks like. A rotated token made every
// control a silent no-op: the page still said "token saved on this device", the
// video fetch 401'd into a catch(()=>{}), and the <img> fallback 401'd into an
// onerror that quietly tried the next thing -- so the user got a black picture
// and a session of tapping dead buttons with no idea why. Auth failure is the
// ONE condition that must never be quiet, so all three paths land here.
function authFailed(){
  localStorage.removeItem(TKEY); TOKIN.value='';
  // Drop the cookie too. It is scoped to the whole origin and the /video and
  // /stream paths authenticate from it, so a stale cookie outlives the token
  // fix-up and keeps 401ing the picture even after a fresh token is pasted.
  document.cookie='hydra_token=; path=/; SameSite=Strict; Max-Age=0';
  streaming=false; videoOn=false;
  if(typeof VID!=='undefined'){ VID.hidden=true; VID.removeAttribute('src'); }
  if(typeof SCR!=='undefined'){ SCR.hidden=false; SCR.removeAttribute('src'); }
  // tokUI() first, then overwrite: it reveals the field (no token -> hidden=false)
  // but derives its label from that, which would overwrite the expiry message
  // with "no token". No extra hidden=false needed -- tokUI() already did it.
  tokUI();
  TOKSTAT.textContent='token expired - paste the new one';
  TOKSTAT.className='';
  say('token expired - paste the new one, then press live');
}
async function call(v,arg){
  if(!T()) return say('paste the token first');
  const b={verb:v}; if(arg) b.arg=arg;
  const t0=performance.now();
  try{
    const r=await fetch('verb',{method:'POST',headers:{
      'Content-Type':'application/json','X-Hydra-Token':T()},body:JSON.stringify(b)});
    const j=await r.json();
    noteRtt(performance.now()-t0);
    if(j.error==='bad token'){ authFailed(); return 'token expired - paste the new one'; }
    return j.ok ? (j.out||v+' ok') : ('error: '+j.error);
  }catch(e){ noteRtt(performance.now()-t0); return 'network error'; }
}
async function go(v){
  say('running '+v+'…');
  const t=await call(v); say(t); if(v.startsWith('queue')) paint();
}
function paint(){
  // Poll, don't stream: the page is a phone on a battery and the 20-min timer is
  // already the clock. An EventSource would add a mechanism for no gain here.
  clearTimeout(window._t);
  window._t=setTimeout(async()=>{
    refreshHub();
    if(T()){
      const [l,tail]=await Promise.all([call('queue:list'),call('queue:tail')]);
      QLOG.textContent=l+'\n\n'+tail;
    }
    // This MUST be the last statement. It is what arms the next tick, and the
    // line above used to throw on an undeclared `t` -- so one bad reference here
    // silently ended all polling after the first 10s: no queue, no hub refresh,
    // no update, with no error anywhere the user could see.
    paint();
  },10000);
}
// ONE source of truth for the channel list, and the server's own live probe.
// The page used to seed a hardcoded list at boot that paint() then replaced ten
// seconds later -- so Studio and OpenCode appeared and silently vanished, which
// read as "the port stopped opening". A row here that cannot be opened is worse
// than no row, so nothing is invented client-side.
async function refreshHub(){
  const c=await call('channels');
  if(!/token expired|^error|^network/.test(c)) hub(c);
}
// Links, not buttons: tapping one should actually open the site. The dot is the
// live up/down probe from the server, since the two backends are loopback-only
// and the phone cannot ask them itself.
function hub(t){
  HUB.innerHTML=t.trim().split('\n').map(l=>{
    const [n,u,s]=l.split('\t');
    if(!u) return '';
    return '<a href="'+u+'" target="_blank" rel="noopener">'+
           '<span class="dot '+(s==='up'?'up':s==='down'?'down':'')+'"></span>'+
           '<span class="chn"><b>'+n+'</b><span>'+u.replace('https://','')+'</span></span>'+
           '</a>';
  }).join('');
}
document.getElementById('qadd').onclick=async()=>{
  const txt=document.getElementById('task').value.trim();
  if(!txt) return say('type a task first');
  say('queueing…');
  const r=await call('queue:add',txt);
  say(r);
  if(r.startsWith('queued')) document.getElementById('task').value='';
  paint();
};
// One group per part of the machine, so the pane reads as that part rather than
// as a flat wall of 26 buttons. Audio/input/system are gone by request; win
// joins machine because closing a window is a machine-level act, not a panel one.
const GROUPS=[
 ['panels',['launcher','launcher:app','launcher:game','launcher:cmd','panel',
   'panel:open','panel:close','settings','power','power:close','theme']],
 ['machine',['wins','procs','win:close']],
 ['audio',['vol:up','vol:down','vol:mute','mic:mute','audio:sink']],
 ['input',['im:toggle','im:en','im:ar']],
 ['panels+',['launcher:win','launcher:dir','launcher:ws','launcher:clip','launcher:emoji','wallpaper','welcome']],
 ['system',['doctor','jobs','layers','cursor']],
];
tokUI();
document.getElementById('tok').addEventListener('input',paint);
// ── link meter ─────────────────────────────────────────────────────────────────
// The phone times its OWN fetch, so this is real end-to-end latency including
// the tunnel, not a guess. When frames come back slow it widens the interval and
// drops JPEG quality, because a slideshow at 60 is worth less than a smooth 40.
const METER={set textContent(v){ setStat(v); }};   // routed to the HUD status line

// Input RTT: the one signal the user actually feels. Until now NOTHING measured
// it -- video had requestVideoFrameCallback, input had no clock at all, so a
// slow link was invisible to the only controller that could have reacted.
// Rolling window of 9, trimmed median: one slow tap is not a verdict, and a
// burst of typing must not degrade an otherwise healthy stream.
const RTT=[]; const RTT_MAX=9;
function noteRtt(ms){
  RTT.push(ms); if(RTT.length>RTT_MAX) RTT.shift();
  window._rttAt=Date.now();
}
function rttMedian(){
  if(!RTT.length) return -1;
  const s=[...RTT].sort((a,b)=>a-b); return Math.round(s[s.length>>1]);
}
// Decays on its own timer, not only on new samples. Without this a stale
// median from one typing burst keeps degrading an idle stream forever --
// silence has to mean "no evidence", never "keep shedding quality".
setInterval(()=>{ if(RTT.length && Date.now()-window._rttAt>20000) RTT.length=0; },5000);
function rttBadge(){
  const m=rttMedian(); return m<0 ? '' : ' input rtt '+m+'ms';
}
let iv=110, qual=82, scale=0, lastMs=0, lastBytes=0;
let frames=0, fpsT=0, realFps=0, lastReport='';
function rearm(){ if(!live) return; clearTimeout(window._live); window._live=setTimeout(loop,Math.max(0,iv-lastCycle)); }
// One frame per cycle, next one scheduled against the cycle START, so the period
// is max(interval, fetch) instead of interval+fetch. Measured, not assumed.
function loop(){
  if(!live) return;
  lastCycle=performance.now();
  grab().finally(rearm);
}
// grim costs ~110ms on this box, so ~8.9 fps is the HARD ceiling no matter how
// fast the link is — and a 800ms poll was therefore a 1.25 fps slideshow wearing a
// health check's clothes. Tune the INTERVAL against that ceiling, and give up
// resolution last, because legibility of text is the payload.
function retune(ms){
  if(ms<300){ iv=150; qual=88; scale=0; }        // direct: aim for the ceiling
  else if(ms<700){ iv=280; qual=86; scale=0; }
  else if(ms<1500){ iv=650; qual=84; scale=0; }
  else if(ms<3000){ iv=1500; qual=80; scale=0; }
  else { iv=2600; qual=72; scale=1100; }          // last resort: shrink
}
function showMeter(){
  const fps=(1000/iv).toFixed(1);
  const kbps=Math.round(lastBytes*1000/iv/1024);
  METER.textContent=lastMs
    ? lastMs+' ms \u00b7 '+lastBytes+' KB \u00b7 ~'+kbps+' KB/s \u00b7 '+fps+' fps \u00b7 q'+qual+
      (scale?' @'+scale+'w':' native')
    : 'tap live to start';
}
// ── remote screen ──────────────────────────────────────────────────────────────
// Poll, don't stream. Two things made this crawl: every frame was a 750 KB PNG,
// and each one did createObjectURL() without revoking the last, so the tab leaked
// a full desktop frame per 1.6s until it dragged. Fixed both.
const SCR=document.getElementById('scr');
// `streaming` was an implicit global, which works only because this page is a
// sloppy-mode <script>. authFailed() assigns it from line 227, ~160 lines ABOVE
// this declaration -- so under a module (strict) that is a ReferenceError inside
// the one handler that must never throw. (videoOn is declared with sb at 522.)
let live=false, busy=false, lastURL=null, SW=1366, SH=768;
let streaming=false;
async function grab(){
  if(streaming||!T()||busy) return;
  busy=true;
  try{
    const t0=performance.now();
    const r=await fetch('verb',{method:'POST',headers:{
      'Content-Type':'application/json','X-Hydra-Token':T(),
      'X-Link':lastReport||'-'},
      body:JSON.stringify({verb:'screen',arg:qual+(scale?','+scale:'')})});
    const sc=r.headers.get('X-Screen');
    if(sc){ const p=sc.split('x').map(Number); SW=p[0]; SH=p[1]; }
    const b=await r.blob();
    lastMs=Math.round(performance.now()-t0);
    lastBytes=Math.round(b.size/1024);
    retune(lastMs);
    frames++;
    const now=performance.now();
    if(now-fpsT>800){ realFps=frames*1000/(now-fpsT); frames=0; fpsT=now;
      lastReport=lastMs+'ms/'+lastBytes+'KB/'+realFps.toFixed(1)+'fps'; }
    showMeter();
    const u=URL.createObjectURL(b);
    SCR.onload=()=>URL.revokeObjectURL(lastURL);  // free the PREVIOUS frame
    lastURL=u; SCR.src=u;
  }catch(e){ say('screen: '+e.message); }
  finally{ busy=false; }
}
SCR.onclick=async ev=>{
  const b=SCR.getBoundingClientRect();
  const kx=SW/b.width, ky=SH/b.height;
  const x=Math.round((ev.clientX-b.left)*kx);
  const y=Math.round((ev.clientY-b.top)*ky);
  say(await call('click',x+' '+y));
};
document.getElementById('sendt').onclick=async()=>{
  const t=document.getElementById('typed').value;
  if(t){ document.getElementById('typed').value=''; say(await call('type',t)); }
};
// Frame rate is a dial, not a constant: 60 is video-like but ~60 Mbps, 15 is
// what a relay can actually carry. One origin, three rates, chosen on the phone.
let fps=30, vbr=4000;
// Adaptive ladder, best first. Bitrate falls BEFORE resolution: at 1366x768 a
// static desktop is already cheap to encode, so cutting pixels first throws away
// sharpness that the link did not actually need to lose. Rung 3 is the "away"
// floor -- small enough to survive a phone on cellular.
const LADDER=[
  {w:1366,h:768,br:4000},
  {w:1366,h:768,br:2500},
  {w:1024,h:576,br:1600},
  {w:854, h:480,br:1000},
];
// PC-side defaults, injected by the server at serve time. The ladder's OWN
// fps/auto picks still win from here on -- this only decides what the picker
// OPENS at, so the phone shows the PC's choice instead of a hardcoded 30.
const RDEF=__REMOTE_DEFAULTS__;
// Declare FIRST, then read. This file used to assign `autoAdapt=false` above its
// own `let`, which is a temporal dead zone ReferenceError -- and `node --check`
// passes that, because it is a runtime fault, not a syntax one. The whole script
// died on load, which looks exactly like "the server stopped serving the page".
let rung=0, autoAdapt=!(RDEF&&RDEF.ladder===false);
if(RDEF&&typeof RDEF==='object'){
  // Make the PC's choice the one that is VISIBLY selected, not just the one in
  // force. Clearing every button without lighting the right one shows 15/30/60
  // all off, so the phone cannot tell what it is actually using.
  if(!/fps=/.test(location.search)){
    for(const b of document.querySelectorAll('#fpssel button'))
      b.classList.toggle('on', b.textContent.trim()===String(RDEF.fps));
  }
}
// Manual wins: if the bookmark pinned br (or a size), the ladder is off. A
// controller that fights an explicit choice is worse than no controller.
if(location.search.indexOf('br=')>=0 || location.search.indexOf('w=')>=0) autoAdapt=false;
// The ladder needs two independent switches, not one. `pinRate` is a deliberate
// capture preset (br=/w= in the URL): size AND bitrate are frozen because that is
// what was asked for. `autoFps` is only "who chooses the frame rate" -- so tapping
// "60" stops the ladder from overriding the frame rate but it still walks size and
// bitrate down. Conflating them is what left the phone asking for 4000k native at
// 60fps on a link delivering 300kB/s: no frames at all, which reads as a crash.
let pinRate=false;
if(location.search.indexOf('br=')>=0 || location.search.indexOf('w=')>=0) pinRate=true;
function vidURL(){
  const r=LADDER[rung];
  return 'video?fps='+fps+'&br='+(pinRate?vbr:r.br)+(pinRate?'':'&w='+r.w+'&h='+r.h);
}
// Pure decision, no DOM and no state of its own, so the thresholds can be tested
// without a browser. Asymmetric on purpose: 3 bad samples to drop (react to
// pain), 8 good ones to climb (don't oscillate on a marginal link).
//
// Any shortfall is bad. The old 0.75 floor looked tolerant but stranded the
// phone at 46 of 60 (0.767) inside a dead band, holding rung 0 for the whole
// session while the user watched it judder: measured, then the ladder had no way
// to discover the rung that would actually hit 60. Climbing needs the target
// genuinely met, not merely better than the rung below.
//
// floor is the best rung already proven not to meet target, -1 for "none yet".
// A link that cannot hold a rung must not re-test it every climb/drop cycle: if
// the cheaper rung meets target (60) while the dearer one cannot (46), the
// 3-drop/8-climb asymmetry alone climbs, drops, climbs -- forever. Climbing into
// a known-bad rung is refused, so the session settles on the cheapest rung that
// actually holds. ponytail: floor is sticky for the page's life; a reload is
// how a link that genuinely improved gets re-probed.
//
// Halving the frame rate is the LAST resort, reached only when the ladder runs
// out of rungs and still cannot meet target. Measured on the phone: every rung
// from 4000k/1366x768 down to 1000k/854x480 presented 46-55 of 60, so the loss
// was never bandwidth and resolution -- the device itself tops out near 50 --
// and spending the whole ladder bought ~8% for a much worse picture. At 30 the
// same phone presented 29.5 of 30. So when 60 is unreachable, asking for 30 and
// going back to full resolution is strictly better: sharp AND actually smooth.
function ladderStep(rung, floor, got, fps, good, bad, x, rtt){
  x = x || {};
  let g=good, b=bad, f=fps, r=rung, fl=floor, move=0;
  if(x.settle){
    // The first window after a restart measures the RE-BUFFER, not the link.
    // Counting it guarantees every drop manufactures the bad sample that causes
    // the next drop, which is a self-feeding loop and reads as a constant flash.
    x.settle=false; g=0; b=0;
  }
  else if(x.pinned){
    // The ceiling is this device, not the link. Stop spending restarts on it.
  }
  else if(x.awaiting){
    // A drop just happened. Did it buy anything? If the rate is still short of
    // target AND barely moved, then resolution and bitrate are not the problem --
    // measured on this phone every rung gave 46-55 of 60 -- so undo the drop and
    // pin the controller rather than walk the whole ladder for nothing.
    x.awaiting=false;
    if(got<f*0.75 && got<x.prevGot*1.15){
      // Disproven: pixels and bitrate are not the bottleneck. This is the whole
      // fix. The old controller kept reading the same number as "degrade further"
      // and walked 0->1->2->3, halved, reset and repeated -- four stream restarts
      // per 30s, each a new connection, a re-buffer and a visible resolution
      // change. Undo the drop, ask for the frame rate this device actually
      // reaches (measured: 29.5 of 30, versus 46-55 of 60 at EVERY rung), keep
      // native pixels, and pin so the ladder stops spending restarts.
      r=0; fl=-1; if(f>30) f=30;
      x.pinned=true; g=0; b=0;
      // move MUST be set: the frame callback restarts the stream on a move, and
      // a silent correction would leave `fps` at 30 in state while the open stream
      // still asks the server for 60 -- a phone stuck at 46fps with adaptation off.
      move=-1;
      return {rung:r, floor:fl, fps:f, good:g, bad:b, move:move, x:x};
    }
  }
  else{
    // INPUT RTT OUTRANKS FPS. Video has always been measured; input never was.
    // When the two disagree, input is the one the user is trying to do: a
    // perfect picture behind a 400ms keypress is useless, while a soft picture
    // with a 40ms keypress is merely less pretty. 400ms is roughly where a tap
    // stops feeling instant on a touchscreen, and it is far above the 2-15ms
    // measured on loopback, so it cannot fire on a healthy path.
    // rtt<0 means "no sample" (an idle page, or a phone too old to send it) and
    // must never degrade anything -- silence is absence of evidence.
    if(rtt>400){ x.slow=(x.slow||0)+1; } else if(rtt>0){ x.slow=0; }
    // LAZY BY DESIGN. The bar is 0.75, NOT 0.90, because 0.90 measures the
    // DEVICE rather than the link: this phone presents ~46 of 60 (0.77) on good
    // WiFi at EVERY rung, so a 0.90 bar reads its normal ceiling as a broken
    // network and walks 0->1->2->3, halves, resets and repeats -- four stream
    // restarts per 30s. Half the samples were healthy and still counted bad.
    if(got<f*0.75){ b++; g=0; } else if(got>=f*0.90){ g++; b=0; } else { g=0; b=0; }
    // Both ends are clamped. Only guarding the top lets a healthy link climb past
    // rung 0 to -1, and LADDER[-1] is undefined -- that TypeError would be thrown
    // inside the frame callback, whose catch tears down a perfectly good stream.
    //
    // FRAME RATE BEFORE RESOLUTION. Every restart costs a new connection, a
    // re-buffer and a black frame, so when the link is genuinely struggling the
    // cheap lever is the one that keeps the picture sharp: halve the frame rate
    // at native resolution first, and only touch pixels if 30 still cannot hold.
    // `uptime` is seconds since this stream started; the first 15s are the
    // settle window measured by a real buffer, not a link verdict.
    if((b>=3 || (x.slow||0)>=3) && (x.uptime||0)>=15){
      const wasRung=r;
      if(f>30){ f=30; move=-1; b=0; g=0; }
      else if(r<LADDER.length-1){ if(fl<0) fl=r; r++; move=-1; b=0; g=0; }
      // Bottom rung AND already down to 30fps: the link is genuinely worse than
      // this ladder goes. Pin instead of halving again -- 15fps is a slideshow,
      // and a pinned stream that holds its target beats a live one that misses.
      else { x.pinned=true; b=0; g=0; }
      if(move){ x.awaiting=true; x.prevGot=got; x.prevRung=wasRung; x.slow=0; }
    }
    else if(g>=8 && r>0 && r-1>fl){ r--; move=1; b=0; g=0; }
  }
  return {rung:r, floor:fl, fps:f, good:g, bad:b, move:move, x:x};
}
const FS=document.getElementById('fpssel');
for(const f of [15,30,60]){
  const b=document.createElement('button');
  b.textContent=f;
  b.className=f===fps?'stick':'';
  b.onclick=()=>{
    fps=f;
    // An explicit frame rate is a manual choice, so the ladder stops driving the
    // FRAME RATE -- otherwise the next 3 bad samples would silently undo the
    // button the user just pressed. Size and bitrate keep adapting: a slow link
    // still cannot carry 4000k native, and freezing that too is what turned a
    // tap on "60" into a dead stream.
    autoAdapt=false;
    AUTO.classList.remove('on');
    for(const k of FS.children) k.className=(+k.textContent===f?'stick':'');
    if(streaming&&videoOn){ stopVideo(); videoStart().catch(()=>{}); }
    else if(streaming){ SCR.src='stream?q='+qual+'&fps='+fps;
      METER.textContent='streaming \u00b7 '+fps+' fps target \u00b7 q'+qual; }
  };
  FS.appendChild(b);
}
// Handing control back to the ladder has to be possible from the phone: the URL
// can pin br/w but a phone cannot type a query string, so without this button a
// single tap on "60" was a one-way door.
// NOTE: getElementById, not `$` -- `$` is a const declared ~130 lines BELOW this
// and top-level `$('fsauto')` is a TDZ ReferenceError that kills the whole script.
const AUTO=document.getElementById('fsauto');
AUTO.onclick=()=>{
  autoAdapt=!autoAdapt;
  AUTO.classList.toggle('on',autoAdapt);
  if(streaming&&videoOn){ stopVideo(); videoStart().catch(()=>{}); }
};
// Video-path failures are invisible here: adb screencap is frozen on this phone,
// so every step of the MSE handshake reports itself to the server journal.
function report(m){ fetch('verb',{method:'POST',headers:{
  'Content-Type':'application/json','X-Hydra-Token':T()},
  body:JSON.stringify({verb:'diag',arg:String(m)})}).catch(()=>{}); }
const VID=document.getElementById('vid');
// Installed once for the life of the element, not once per stream. None of these
// depend on per-stream state -- they only report -- and registering them inside
// videoStart meant every restart added another full set. 'error' is NOT
// {once:true}: the first error was the only one ever seen, so every later
// failure -- including the one that left the phone blank -- was silent.
// Report-only. Recovery is the watchdog's job, not these: a 'pause' event also
// fires when the user deliberately stops the stream, and a handler that fights
// that would make the play button unreliable.
VID.addEventListener('error',()=>{ report('video error code '+(VID.error&&VID.error.code)); });
VID.addEventListener('pause',()=>report('video paused'));
VID.addEventListener('playing',()=>report('video playing'));
VID.addEventListener('stalled',()=>report('video stalled'));
VID.addEventListener('waiting',()=>report('video waiting'));
let sb=null, videoOn=false, videoGen=0, vc=null;
// The element actually showing the picture. `surf()` was CALLED in two places and
// DEFINED in none, so contentRect() threw a ReferenceError -- which killed
// toNative() (a tap on the picture never clicked anything) and showDot() (the
// Touchpad cursor never drew), and surfaceDown() swallowed its own copy inside a
// try/catch, so the surface was never pointer-captured either. `node --check`
// cannot see this: an undefined identifier is perfectly valid syntax. Found by
// dispatching a real touch sequence over CDP, not by reading the file.
const surf=()=>videoOn?VID:SCR;
// Fragmented MP4 has to be handed to the browser a fragment at a time; a <video>
// with an open-ended .mp4 src will not play, which is why this is MSE and not a
// ── RECOVERY ─────────────────────────────────────────────────────────────────
// None of this existed, which is why the phone went black and STAYED black.
// Measured on the device: the server kept streaming 200-700 KB/s while the client
// reported ZERO presented frames for the rest of the session, and only a manual
// reload brought it back. `error` was registered {once:true}, every play()
// rejection was swallowed by .catch(()=>{}), and nothing listened for pause, stall,
// waiting or visibilitychange. So when Android paused the element -- backgrounded
// app, screen asleep, or a stream starved by mobile data -- the
// requestVideoFrameCallback chain died with it and no code path could restart it.
let lastFrameAt=0, tries=0, saidNo=false, okSince=0;

// Restart a stream that has presented nothing for a while. Deliberately based on
// the ABSENCE of frames rather than on an event: a pipeline can die without ever
// firing pause, stalled, waiting or error, and that silent case is exactly the one
// that used to need a human with a reload button. Bounded, because a stream that
// never recovers must end with a message rather than an infinite restart loop.
function watchdog(){
  if(!streaming||!videoOn) return;
  if(document.hidden) return;              // the OS owns it while hidden
  if(!lastFrameAt) return;                 // not started yet
  const idle=performance.now()-lastFrameAt;
  if(idle<5000) return;
  if(tries>=3){
    if(!saidNo){ saidNo=true; say('stream stalled - tap play to retry'); }
    return;
  }
  tries++; saidNo=false;
  say('no frames for '+Math.round(idle/1000)+'s - restarting');
  stopVideo(); videoStart().catch(()=>{});
}

// Android pauses the element when the app is backgrounded or the screen sleeps,
// and it does not always come back by itself. Re-issue play() when the tab
// returns. The rejection is REPORTED, never swallowed: a silent .catch(()=>{})
// makes a blocked autoplay indistinguishable from a working stream.
function wakeVideo(why){
  report('wake '+why+' hidden='+document.hidden+' paused='+(VID&&VID.paused));
  if(!streaming||!videoOn||document.hidden) return;
  const p=VID.play();
  if(p&&p.catch) p.catch(e=>report('play rejected: '+e.name+': '+e.message));
}
document.addEventListener('visibilitychange',()=>{ if(!document.hidden) wakeVideo('visible'); });

// plain src=. Decoding happens in hardware, which is the whole point.
// Pure: how far BEHIND the live edge playback should sit, or null to leave it
// alone. Measured on this phone the buffer sat at 1.5-2.0s forever: the player
// fills ~2s at startup, and because ingest ~= present (27-30 of 30) that depth
// never decays. Nothing ever sought forward, so the picture stayed two seconds
// old for the life of the stream. This is the single biggest latency win and it
// costs no resolution. ponytail: seek, not playbackRate nudging -- one seek per
// interval is deterministic and the video is muted so drift buys nothing.
function liveEdge(behind, slack, floor){
  return behind>slack ? floor : null;
}
async function videoStart(){
  lastFrameAt=performance.now();            // the watchdog's clock starts here
  // okSince resets WITH the stream. Left over from the previous one it makes
  // `now-okSince>=4000` true on the very first frame, so every restart wiped the
  // strike count and the bounded 3-strike stop could never actually engage --
  // an unbounded loop wearing the costume of a bounded one.
  okSince=0;
  if(!window.MediaSource) throw new Error('no MediaSource');
  report('MediaSource present');
  if(!MediaSource.isTypeSupported('video/mp4; codecs="avc1.640020"'))
    report('isTypeSupported avc1.640020 = FALSE');
  const ms=new MediaSource();
  VID.src=URL.createObjectURL(ms);
  await new Promise(r=>ms.addEventListener('sourceopen',r,{once:true}));
  sb=ms.addSourceBuffer('video/mp4; codecs="avc1.640020"');
  report('SourceBuffer ok');
  sb.mode='sequence';
  // The signal is what actually closes the connection. Merely abandoning the
  // reader on the next chunk (what videoGen does) leaves the fetch open, so the
  // socket stays writable, the server never sees a broken pipe, and its handler
  // goes on encoding forever into a response nobody reads -- one ffmpeg and one
  // capture client per restart, which is how three pairs were alive at once and
  // why every reconnect got worse than the last.
  vc=new AbortController();
  let r;
  try{ r=await fetch(vidURL(),{headers:{'X-Hydra-Token':T()},signal:vc.signal}); }
  catch(e){ if(e.name!=='AbortError') report('fetch: '+e.name); return; }
  // 401/403 here means the token, not the codec. Falling through to the MJPEG
  // poller used to be the only response, and that path 401s too -- so a dead
  // token looked like "video codec unsupported" and the user never saw why.
  if(r.status===401||r.status===403){ authFailed(); return; }
  if(!r.ok||!r.body) throw new Error('video http '+r.status);
  report('video http 200');
  const rd=r.body.getReader();
  const gen=++videoGen;
  (async()=>{
    if(gen!==videoGen) return;   // superseded before the first chunk landed
    for(;;){
      const {done,value}=await rd.read();
      if(done) break;
      if(!value) continue;
      // appendBuffer refuses to re-enter, and dropping the buffer is what stutters.
      if(gen!==videoGen) return;  // a newer stream owns the element now
      if(sb.updating) await new Promise(r=>sb.addEventListener('updateend',r,{once:true}));
      if(gen!==videoGen) return;
      try{ sb.appendBuffer(value); }
      catch(e){ if(gen===videoGen) report('appendBuffer: '+e.name+' '+e.message); return; }
      if(!window.__seen){ window.__seen=1; }        // fragments: one line, ever
      if(window.__n===undefined) window.__n=0;
      if(++window.__n===20 && !window.__frag){ window.__frag=1; report('20 fragments appended'); }
    }
  })();
  videoOn=true; VID.hidden=false; SCR.hidden=true;
  const go=()=>{
    const p=VID.play();
    if(p&&p.catch) p.catch(e=>report('play rejected: '+e.name+': '+e.message));
  };
  go();
  VID.addEventListener('loadedmetadata',()=>{ report('loadedmetadata'); go(); },{once:true});
  // The element-level listeners live OUTSIDE videoStart (below), installed once.
  // Registered per start they multiplied: ten restarts meant ten error handlers
  // and ten identical reports for a single failure.
  setTimeout(()=>report('after 6s: vw='+VID.videoWidth+' vh='+VID.videoHeight+
    ' t='+VID.currentTime.toFixed(2)+' paused='+VID.paused),6000);
  // Presented-fps, not stream-fps: this is the number the eye sees and the only
  // honest proof that decode+display keep up with the wire. 6s warmup, then every
  // 2s, so a startup stall is not mistaken for a steady state.
  // Called as a method, never detached: `const rvfc=VID.requestVideoFrameCallback`
  // then `rvfc(tick)` is an unbound DOM call that throws "Illegal invocation" --
  // and that throw lands in videoStart's catch, which tears down a *working* video.
  if(!VID.requestVideoFrameCallback){ report('no requestVideoFrameCallback'); return; }
let n=0, t0=0, good=0, bad=0, lastMove=0, ladderFloor=-1, lastTrim=0, born=0;
// These are per-videoStart, so every restart gets a FRESH settle window for
// free: the first 2s of a new stream is spent decoding from an empty buffer and
// measures ~5fps. Counting that as evidence guarantees the next bad drop, which
// is the loop that restarted the stream every 7-9s. (Assigning to n/t0/ladderX
// from above this line is a TDZ ReferenceError -- they are declared here.)
let ladderX={settle:true, awaiting:false, pinned:false, prevGot:0, prevRung:0};
  const tick=(now,meta)=>{
    if(gen!==videoGen) return;          // superseded: stop rescheduling
    lastFrameAt=now;
    if(!born) born=now;
    // ── live-edge trim ────────────────────────────────────────────────
    // Run on the frame callback (already at display rate) but seek at most
    // twice a second: a seek per frame re-enters the buffering path and trades
    // the lag we are removing for stutter we would then have to remove.
    if(now-lastTrim>=500){
      lastTrim=now;
      if(VID.buffered.length){
        const edge=VID.buffered.end(0);
        const sl=liveEdge(edge-VID.currentTime,0.35,0.12);
        if(sl!==null) VID.currentTime=edge-sl;
      }
    }
    // A run of healthy frames is what forgives earlier strikes. Without this the
    // count could never reset, because every restart goes through videoStart.
    if(!okSince) okSince=now;
    if(now-okSince>=4000){ tries=0; saidNo=false; okSince=now; }
    if(!t0){ t0=now; VID.requestVideoFrameCallback(tick); return; }
    n++;
    if(now-t0>=2000){
      const got=n/((now-t0)/1000);
      const q=VID.getVideoPlaybackQuality?VID.getVideoPlaybackQuality():null;
      report('presented '+got.toFixed(1)+' fps target '+fps+' rung '+rung+
        (pinRate?'':' ('+LADDER[rung].w+'x'+LADDER[rung].h+' '+LADDER[rung].br+'k)')+
        ' at '+(meta.mediaTime||0).toFixed(1)+'s'+
        // lag is buffered.end-currentTime: how old the picture on the phone is.
        // This is the number the user means by "delay", and until it was in the
        // journal the only way to see it was a CDP probe over USB.
        ' lag='+(VID.buffered.length?VID.buffered.end(0)-VID.currentTime:0).toFixed(2)+
        ' dropped='+((q&&q.droppedVideoFrames)||0)+rttBadge());
      {
        // The cooldown gates the controller, not just the restart. Letting
        // ladderStep run while the restart is blocked advanced rung without
        // ever restarting the stream, so the controller tracked a rung no
        // stream was using and the lost drop needed 3 more bad samples.
        if(now-lastMove>5000){
          // Seconds since this stream started. The ladder refuses to act inside
          // the first 15s: that window is the re-buffer being measured, and
          // calling it a link verdict is what turned a settling stream into a
          // restart. `born` is stamped on the first frame callback of this
          // stream (it is per-videoStart, so it resets for free on a restart).
          ladderX.uptime=(now-born)/1000;
          const s=ladderStep(rung, ladderFloor, got, fps, good, bad, ladderX, rttMedian());
          rung=s.rung; ladderFloor=s.floor; good=s.good; bad=s.bad; ladderX=s.x;
          // The ladder always runs, because SIZE and BITRATE must keep adapting
          // even when the frame rate was chosen by hand. Only the frame rate is
          // the user's to keep: a manual fps is not the controller's to halve.
          if(autoAdapt) fps=s.fps;
          ladderX=s.x;
          // pinRate froze the exact numbers a move would change: vidURL() then
          // ignores rung, so every 'move' restarts an identical stream. That is
          // the churn loop, not adaptation. A pinned URL adapts nothing.
          if(s.move && !pinRate){
            lastMove=now;
            report('ladder '+s.move+' -> rung '+rung+' @'+fps+'fps ('+LADDER[rung].w+'x'+LADDER[rung].h+
              ' @'+LADDER[rung].br+'k)');
            stopVideo(); videoStart().catch(()=>{}); return;
          }
        }
      }
      n=0; t0=now;
    }
    VID.requestVideoFrameCallback(tick);
  };
  VID.requestVideoFrameCallback(tick);
}
function stopVideo(){
  videoOn=false; videoGen++;   // orphans the old reader; it exits on the next chunk
  // ...but the reader going quiet is not a disconnect. Aborting the fetch is,
  // and without it every restart leaves the previous stream running server-side.
  try{ if(vc){ vc.abort(); vc=null; } }catch(e){}
  try{ if(sb){ sb.abort(); sb=null; } }catch(e){}
  try{ VID.pause(); VID.removeAttribute('src'); VID.load(); }catch(e){}
  VID.hidden=true; SCR.hidden=false;
}
// ── full-screen remote desktop ────────────────────────────────────────────────
// Direct mode (default) is a touchpad-shaped thing: tap where you mean, drag to
// scroll. Touchpad mode is the honest one for real apps: drag walks the real
// cursor, so a drag that overshoots lands where the pointer ended rather than
// teleporting back to the finger. Both are useless without a drawn cursor, so the
// pointer is drawn here from the server's cursor position -- the screencopy
// protocol on this compositor has no cursor to capture.
// The HUD hides itself because it sits over the picture, and a permanent bar
// across the top of a remote desktop is a permanent thing in the way. It comes
// back from the top edge or the glyph.
const $=id=>document.getElementById(id);
const HUD=$('hud');
let fsMode=false, touchMode=false, hudT=null, lastFsStat='';
function showChrome(){
  HUD.classList.remove('off');
  $('bar').classList.remove('sunk');
  clearTimeout(hudT);
  hudT=setTimeout(()=>{ HUD.classList.add('off'); $('bar').classList.add('sunk'); },3200);
}
function setStat(t){ if(t!==lastFsStat){ lastFsStat=t; $('hstat').textContent=t; } }
function fsStat(){
  setStat(videoOn
    ? ('video '+(VID.videoWidth||'?')+'x'+(VID.videoHeight||'?')+' r'+rung)
    : ('still '+(qual||'')));
}
function enterFS(){
  // Target the stage, not the document: the transport, the rail and the sheets
  // live inside it, so the browser keeps them on screen and they keep working.
  const el=$('stage');
  const rq=el.requestFullscreen||el.webkitRequestFullscreen;
  if(rq) try{ const p=rq.call(el); if(p&&p.then) p.then(()=>fs(true)).catch(()=>{}); }catch(e){}
  else fs(true);
  showChrome(); fsStat();
}
function exitFS(){
  if(document.fullscreenElement||document.webkitFullscreenElement){
    const x=document.exitFullscreen||document.webkitExitFullscreen;
    if(x) try{ x.call(document); }catch(e){}
  }
  fs(false);
}
function fs(on){   // one source of truth; the browser can also leave on its own
  fsMode=on; ico($('fsbtn'),on?'min':'max');
}
addEventListener('fullscreenchange',()=>fs(!!document.fullscreenElement));
addEventListener('webkitfullscreenchange',()=>fs(!!(document.fullscreenElement||document.webkitFullscreenElement)));
// Tap position -> panel pixel. object-fit:contain with a full-viewport box of the
// panel's own aspect ratio means the picture has no bars, so this is one scale
// per axis and a clamp. Anything else needs the letterbox offsets and gets them
// wrong exactly when the window is rotated.
// SW/SH is the PANEL size, which is what a click needs -- not VID.videoWidth,
// which on a lower ladder rung is the downscaled stream and would put every tap
// in the wrong place.
function scaleTo(px, start, size, n){
  if(size<=0) return 0;
  return Math.max(0, Math.min(n-1, Math.round((px-start)/size*n)));
}
// object-fit:contain letterboxes the picture INSIDE the element, so the element
// rect is not where the picture is. Mapping taps over the element box is what
// made a tap in the black band click the top of the desktop -- the very
// "off-by-a-bar click" this layout claims to have removed. Aspect comes from
// SW/SH, the real panel, never videoWidth: a lower ladder rung is a downscaled
// copy of the same desktop, so it shares that aspect and that coordinate space.
function contentRect(){
  const r=surf().getBoundingClientRect();
  const a=SW/SH, box=r.width/r.height;
  if(box>a){ const h=r.height, w=h*a; return {x:r.left+(r.width-w)/2, y:r.top, w:w, h:h}; }
  const w=r.width, h=w/a; return {x:r.left, y:r.top+(r.height-h)/2, w:w, h:h};
}
function toNative(e){
  const c=contentRect();
  return {x:scaleTo(e.clientX, c.x, c.w, SW), y:scaleTo(e.clientY, c.y, c.h, SH)};
}
let drag=null;
const NOTCH=28;              // CSS px of finger travel per scroll notch
const SCROLL_MS=55;          // one POST per gesture step; each is a real spawn
function flushScroll(d, force){
  if(!d||d.mode!=='direct') return;
  const now=performance.now();
  if(!force&&now-d.lastScroll<SCROLL_MS) return;
  const ny=Math.trunc(d.ay/NOTCH);
  if(!ny) return;
  d.lastScroll=now; d.ay-=ny*NOTCH;
  // Finger down scrolls the view up, the same direction the content moves under
  // the thumb. Sign kept from the original one-shot drag.
  call('scroll',String(-ny));
}
// Touchpad cursor overlay. The pointer moves by DELTA (move:rel) and the phone
// never learns where it landed, so track it here: seed from one real cursor read
// when the mode is entered, then add deltas. No extra round-trip per frame --
// the drag path stays a single move:rel. The dot is hidden until seeded, because
// a dot at a guessed 0,0 is worse than no dot.
let cur=null;
function showDot(){
  const d=$('cdot'); if(!d) return;
  if(!cur){ d.classList.remove('on'); return; }
  const c=contentRect();
  // Clamp HERE, not where the delta is applied. hyprctl cursorpos returns raw
  // screen coordinates, which on a multi-monitor setup are legitimately outside
  // this panel -- and the seed below is the untrusted value, not the drag.
  const x=Math.max(0,Math.min(SW,cur.x)), y=Math.max(0,Math.min(SH,cur.y));
  d.classList.add('on');
  d.style.left=(c.x+x/SW*c.w)+'px';
  d.style.top=(c.y+y/SH*c.h)+'px';
}
async function seedCursor(){
  const p=await cursorPos();
  cur=p?{x:p.x,y:p.y}:{x:Math.trunc(SW/2),y:Math.trunc(SH/2)};
  showDot();
}
function surfaceDown(e){
  showChrome();
  // No top-edge special case any more: hidden chrome is pointer-events:none, so
  // nothing is there to intercept, and a tap both reveals the bar and lands on
  // the desktop -- which is what a tap should do.
  if(e.target.closest('#hud,#bar,#rail,#sheet')) return;
  drag={x:e.clientX, y:e.clientY, t:performance.now(), moved:0, sx:e.clientX, sy:e.clientY,
        mode:touchMode?'touch':'direct', ax:0, ay:0, lastScroll:0};
  // Capture in BOTH modes. Without it a Direct drag that slid off the picture
  // never delivered pointerup at all: no scroll, and drag stayed set so the next
  // tap inherited a stale gesture. Direct mode wanted its gesture, not the
  // browser's, and surfaceUp synthesises the tap itself -- so capturing costs
  // nothing and e.preventDefault() only suppresses a click we never needed.
  try{ surf().setPointerCapture(e.pointerId); }catch(err){}
  e.preventDefault();
}
function surfaceMove(e){
  if(!drag) return;
  const dx=e.clientX-drag.x, dy=e.clientY-drag.y;
  const tx=e.clientX-drag.sx, ty=e.clientY-drag.sy;   // from the gesture's origin
  drag.moved+=Math.abs(dx)+Math.abs(dy);
  // A swipe is decided from the gesture's own origin and latched before ANY
  // consumer can spend a pixel of it. It has to sit above the touch branch too:
  // the phone runs in Touchpad mode, so a latch below it meant the swipe never
  // opened the pane at all. The predicate is narrow on purpose -- within 70px of
  // the left edge, rightwards, clearly horizontal -- so the relative cursor keeps
  // working everywhere that is not an edge swipe.
  if(drag.swipe===undefined && (Math.abs(tx)>18||Math.abs(ty)>18)){
    drag.swipe=(drag.sx<70 && tx>0 && Math.abs(tx)>Math.abs(ty)*1.4) ? 1 : 0;
  }
  if(drag.swipe===1) return;       // a sheet gesture, not a scroll and not a drag
  if(drag.mode==='touch'){
    // Deltas, not absolute: this is the whole difference between Touchpad mode and
    // Direct mode. Accumulating deltas also means a dropped frame loses distance,
    // not position.
    if(dx||dy){ call('move:rel',Math.round(dx)+' '+Math.round(dy)); drag.x=e.clientX; drag.y=e.clientY;
      if(cur){ cur.x+=dx; cur.y+=dy; showDot(); } }   // clamp happens in showDot
    e.preventDefault(); return;
  }
  // Direct: scroll WHILE the finger moves. The old code waited for pointerup and
  // fired one jump for the whole drag, so the picture only ever caught up after
  // you lifted -- and a fast flick scrolled by whatever the final delta happened
  // to be. Accumulate, convert whole notches, send on a floor of one POST per
  // 55ms so a long drag cannot flood hydra-remote with spawns.
  drag.ax+=dx; drag.ay+=dy;
  drag.x=e.clientX; drag.y=e.clientY;
  flushScroll(drag,false);
  e.preventDefault();
}
async function surfaceUp(e){
  if(!drag) return;
  const d=drag; drag=null;
  const dt=performance.now()-d.t, dist=Math.abs(e.clientX-d.sx)+Math.abs(e.clientY-d.sy);
  // ABOVE the mode branch, not below it. surfaceMove latches the swipe in BOTH
  // modes, so the completion has to honour it in both modes too: with this check
  // below `if(d.mode==='touch'){...return;}` the phone -- which runs in Touchpad
  // mode -- latched the swipe, correctly consumed no pixel of it, and then threw
  // the latch away on pointerup. The gesture did nothing, which reads as "the
  // swipe doesn't work" rather than as the ordering bug it was.
  if(d.swipe===1){ openPane('hub'); return; }
  if(d.mode==='touch'){
    // A tap in Touchpad mode means "click wherever the pointer already is", so
    // the phone has to know where that is. Poll it; a wrong answer would click
    // the wrong window, which is worse than not clicking.
    if(d.moved<8&&dt<500){
      const p=await cursorPos();
      if(p) call('click',p.x+' '+p.y); else report('cursor unknown');
    }
    return;
  }
  if(dist<10&&dt<500){ const p=toNative(e); call('click',p.x+' '+p.y); return; }
  flushScroll(d,true);   // don't lose the sub-notch remainder of the drag
}
async function cursorPos(){
  try{
    // hyprctl prints "100, 200" -- comma and space, so a /(\d+)\s+(\d+)/ never
    // matches and the tap silently does nothing. Take the numbers in order.
    const m=(await call('cursor','')).match(/-?\d+/g);
    if(m&&m.length>=2) return {x:+m[0], y:+m[1]};
  }catch(e){}
  return null;
}
function wireFS(){
  const b=$('fsbtn'); if(b) b.onclick=()=>enterFS();
  $('hexit').onclick=exitFS;
  $('hmode').onclick=()=>{
    touchMode=!touchMode;
    ico($('hmode'),touchMode?'zap':'hand');   // textContent would delete the svg
    $('hmode').classList.toggle('on',touchMode);
    document.body.classList.toggle('tp',touchMode);
    // Seed on the way IN only: leaving and re-entering should not teleport the
    // dot back to where the pointer was before something else moved it.
    if(touchMode) seedCursor(); else { cur=null; showDot(); }
    report('mode '+(touchMode?'touchpad':'direct'));
    showChrome();
  };
  // Touchpad mode had no scroll at all: the drag belongs to the pointer, so a
  // page with no scrollbar and no reachable gesture simply could not scroll.
  // These are the missing affordance. Hold to repeat, because one 3-notch tap
  // is rarely what you want.
  for(const [id,n] of [['hup',3],['hdn',-3]]){
    const b=$(id), send=()=>{ call('scroll',String(n)); showChrome(); };
    let t=null;
    b.addEventListener('pointerdown',e=>{ e.stopPropagation(); send();
      t=setInterval(send,220); });
    for(const ev of ['pointerup','pointercancel','pointerleave'])
      b.addEventListener(ev,()=>{ clearInterval(t); t=null; });
  }
  for(const el of [SCR,VID]){
    el.addEventListener('pointerdown',surfaceDown);
    el.addEventListener('pointermove',surfaceMove);
    el.addEventListener('pointerup',surfaceUp);
    el.addEventListener('pointercancel',()=>{drag=null;});
  }
  // Any keyboard-looking intent wakes it, so the glyph is never the only way back.
  addEventListener('keydown',showChrome);
  setInterval(fsStat,1000);
  if(/[?&]fs=1/.test(location.search)) enterFS();
}
// ── icons ─────────────────────────────────────────────────────────────────────
