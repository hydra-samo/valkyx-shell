  }
  sb.mode='segments';
  AB=new AbortController();
  let r;
  try{r=await fetch('video?fps='+FPS+'&br=4000',
    {headers:{'X-Hydra-Token':TOK},signal:AB.signal});}
  catch(e){if(my===gen)log('stream aborted','err');return;}
