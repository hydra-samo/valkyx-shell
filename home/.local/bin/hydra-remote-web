async function verb(v,arg){
  try{
    const r=await fetch('verb',{method:'POST',
      headers:{'X-Hydra-Token':TOK,'Content-Type':'application/json'},
      body:JSON.stringify({verb:v,arg:arg||''})});
    const txt=(await r.text()).trim();
    log(v+(arg?' '+arg:'')+'  '+(txt||'HTTP '+r.status), r.ok?'ok':'err');
  }catch(e){log(v+' failed: '+e.message,'err');}
}

