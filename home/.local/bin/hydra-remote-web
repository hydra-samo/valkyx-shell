def token() -> str:
    """Read the shared secret, creating it on first run with 0600."""
    if TOKEN_FILE.exists():
        return TOKEN_FILE.read_text().strip()
    TOKEN_FILE.parent.mkdir(parents=True, exist_ok=True)
    tok = secrets.token_urlsafe(24)
    TOKEN_FILE.write_text(tok + "\n")
    TOKEN_FILE.chmod(0o600)
    return tok


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "hydra-remote"
    tok = ""

    def _send(self, code: int, body: bytes, ctype: str,
              extra: dict[str, str] | None = None) -> None:
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        for k, v in (extra or {}).items():
            self.send_header(k, v)
        # No CORS headers on purpose: cross-origin JS cannot read or drive this.
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self) -> None:  # noqa: N802
        # Compare the PATH, never self.path: "/stream?q=80" != "/stream", which
        # 404s a perfectly good request and looks like a dead endpoint.
        route = self.path.split("?", 1)[0]
        if route in ("/", "/index.html"):
            # Inject the PC-side defaults rather than add a /defaults endpoint:
            # this service is loopback plus tailscale serve, so ANY endpoint is
            # tailnet-reachable, and GET /token was already removed for handing
            # a secret to anything that could reach the port. Numbers are not
            # secret, but a new readable endpoint is the same shape of mistake.
            # Every response is Cache-Control: no-store, so this is never stale.
            # ?desktop=1 is the Hydra-S Console's Remote tab; the phone keeps
            # the bare page. Both ride the same verbs and /video.
            if "desktop=1" in self.path:
                self._send(200, PAGE_DESKTOP.encode(), "text/html; charset=utf-8")
            else:
                blob = json.dumps(load_remote_defaults())
                self._send(200, PAGE.replace("__REMOTE_DEFAULTS__", blob).encode(),
                           "text/html; charset=utf-8")
        elif route == "/video":
            self._video()
        elif route == "/stream":
            self._stream()
        # There is deliberately NO /token route. It used to hand the secret to
        # anyone who could reach the tailnet endpoint, which was merely
        # inconvenient while the whitelist was all fixed no-arg verbs. Once
        # queue:add made this surface execute code, handing out the token turned
        # "can reach :8444" into "can run an agent in $HOME". Read it once on the
        # desktop (`cat ~/.local/state/hydra/remote-token`) and paste it into the
        # phone's token field; the page keeps it for the session.
        else:
            self._send(404, b"not found", "text/plain")

    def _video(self) -> None:
        """H.264 in fragmented MP4, for <video> + MSE.

        This exists because MJPEG cannot reach video-like motion on a phone. At
        1366x768 a JPEG frame is ~148 KB, so 30 fps is ~35 Mbps; the phone's link
        measured 5-8 Mbps and delivered ~7 fps no matter what the server did.
        VAAPI H.264 is ~1.2 Mbps for the same picture — 29x smaller — and the
        browser decodes it in hardware, which is exactly why a video is smooth and
        a JPEG stream was not.
        """
        if not self._authed_cookie():
            self._send(401, b"bad token", "text/plain")
            return
        # PC-side defaults from ~/.config/hydra/remote.json, read per request and
        # UNCACHED so a tweak lands on the next connection with no restart. The
        # query still wins, so the phone's own ?br= pin keeps working over it.
        d = load_remote_defaults()
        fps, br, q = d["fps"], str(d["br"]) + "k", "82"
        # Resolution is an ALLOWLIST, not a free parameter: these three are the
        # rungs the phone's ladder steps through, and a caller cannot ask the
        # encoder for an arbitrary size (which would be a cheap way to burn the
        # GPU from the tailnet).
        SIZES = ((1366, 768), (1024, 576), (854, 480))
        TW = TH = 0
        for kv in (self.path.split("?", 1)[1] if "?" in self.path else "").split("&"):
            if kv.startswith("fps=") and kv[4:].isdigit():
                fps = min(60, max(5, int(kv[4:])))
            elif kv.startswith("br=") and kv[3:].isdigit():
                br = str(min(12000, max(400, int(kv[3:])))) + "k"
            elif kv.startswith("q=") and kv[2:].isdigit():
                q = str(min(95, max(40, int(kv[2:]))))
        # w= and h= must arrive as a PAIR to mean anything, so read them together.
        try:
            qs = dict(p.split("=", 1) for p in
                      (self.path.split("?", 1)[1] if "?" in self.path else "").split("&") if "=" in p)
            pair = (int(qs["w"]), int(qs["h"]))
            if pair in SIZES:
                TW, TH = pair
        except (KeyError, ValueError):
            pass
        TW = TW or d["w"]
        TH = TH or d["h"]
        self.send_response(200)
        self.send_header("Content-Type", "video/mp4")
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.end_headers()
        ff = pump = cap = None
        persistent = False
        W = H = 0
        try:
            # PERSISTENT capture first. The old loop spawned one `grim` per frame,
            # and that process spawn really costs ~18.6ms on this box -- a 53.8fps
            # ceiling no bitrate could buy past. hydra-cap is one long-lived
            # wlr-screencopy client that paces itself and measured a sustained
            # 60.0fps (240/240 frames) with zero spawns.
            #
            # Its stream is a 12-byte header once (b"HCAP" + u32 width + u32 height,
            # little endian) followed by tightly-packed BGRX frames. The header is
            # read HERE, synchronously, because ffmpeg needs -s before it starts.
            try:
                cap = subprocess.Popen(
                    ["$HOME/.local/bin/hydra-cap", "--fps=%d" % fps],
                    stdout=subprocess.PIPE, bufsize=0)
                hdr = b""
                end = time.time() + 3.0
                while len(hdr) < 12 and time.time() < end:
                    b = cap.stdout.read(12 - len(hdr))
                    if not b:
                        break
                    hdr += b
                if len(hdr) == 12 and hdr[:4] == b"HCAP":
                    W, H = struct.unpack("<II", hdr[4:12])
                    persistent = True
                    sys.stderr.write("video: hydra-cap %dx%d @%dfps\n" % (W, H, fps))
            except OSError as e:
                sys.stderr.write("video: hydra-cap unavailable: %s\n" % e)
            if not persistent and cap:
                cap.kill()
                cap = None
                sys.stderr.write("video: falling back to grim-per-frame\n")

            if persistent:
                src = ["-f", "rawvideo", "-pix_fmt", "bgra", "-s", "%dx%d" % (W, H),
                       "-r", str(fps), "-i", "-"]
                # Scale on the GPU, AFTER hwupload. Doing it in software means
                # touching all 4 MB of every frame on the CPU before the encoder
                # ever sees it, which is the one thing the persistent capture was
                # built to stop doing.
                vf = "format=nv12,hwupload"
                if TW and (TW, TH) != (W, H):
                    vf += ",scale_vaapi=w=%d:h=%d" % (TW, TH)
                if TW:
                    sys.stderr.write("video: scale %dx%d -> %dx%d\n" % (W, H, TW, TH))
            else:
                src = ["-f", "image2pipe", "-c:v", "mjpeg", "-framerate", str(fps), "-i", "-"]
                vf = "format=nv12,hwupload"
            # empty_moov+default_base_moof gives MSE its init segment immediately,
            # so playback starts on the first fragment instead of at the first
            # keyframe interval. -g fps => a keypoint every second for reconnects.
            #
            # Those three flags are the LATENCY budget, and every one of them used
            # to spend a second before the phone could show anything:
            #   -bf 0          B-frames must be reordered before display, so they
            #                   add pipeline delay for zero gain on a screen that
            #                   is already lossy and wall-clock bound.
            #   -g fps//2      with frag_keyframe the muxer only cuts a new
            #                   fragment at a keyframe, so the GOP IS the minimum
            #                   time the decoder must wait for data. 1s GOP => 1s
            #                   of mandatory buffering; 0.5s halves it, and the
            #                   cost is more, smaller fragments.
            #   -rc_mode CBR   + a tight bufsize caps the rate controller's VBV
            #   -maxrate/bufsize  queue. Left unbounded it buffers frames to
            #                   smooth quality, which is exactly the 2s lag this
            #                   whole change set exists to remove. Note CBR needs
            #                   -b:v to be present or the encoder refuses to
            #                   open (verified against the real VAAPI encoder).
            vbv = str(max(200, int(br[:-1]) // 2)) + "k"
            ff = subprocess.Popen(
                ["ffmpeg", "-hide_banner", "-loglevel", "error",
                 "-init_hw_device", "vaapi=va:/dev/dri/renderD128",
                 "-filter_hw_device", "va",
                 ] + src + [
                 "-vf", vf, "-c:v", "h264_vaapi",
                 "-b:v", br, "-bf", "0", "-g", str(max(1, fps // 2)),
                 "-rc_mode", "CBR", "-maxrate", br, "-bufsize", vbv,
                 "-movflags", "frag_keyframe+empty_moov+default_base_moof",
                 "-f", "mp4", "-"],
                stdin=subprocess.PIPE, stdout=subprocess.PIPE, bufsize=0)

            def feed():
                if persistent:
                    # Straight copy: hydra-cap already paces and repacks, so this
                    # thread does nothing but move bytes.
                    fsz = W * H * 4
                    while True:
                        chunks, got = [], 0
                        while got < fsz:
                            b = cap.stdout.read(fsz - got)
                            if not b:
                                # The capture client died. LOG IT: a silent
                                # return here starves ffmpeg, which then stalls
                                # the read loop forever and leaks both processes
                                # with no trace in the journal.
                                sys.stderr.write(
                                    "video: capture pipe closed after %d/%d B"
                                    " -> pipeline dead\n" % (got, fsz))
                                return
                            chunks.append(b)
                            got += len(b)
                        try:
                            ff.stdin.write(b"".join(chunks))
                        except (BrokenPipeError, ValueError, OSError):
                            return
                    return
                # Fallback: deadline pacing, not a guessed sleep. No `sh -c`
                # wrapper either -- that was a process spawn per frame.
                per = 1.0 / fps
                nxt = time.perf_counter()
                while True:
                    shot = subprocess.run(["grim", "-t", "jpeg", "-q", q, "-"],
                                          stdout=subprocess.PIPE)
                    if not shot.stdout:
                        return
                    ff.stdin.write(shot.stdout)
                    nxt += per
                    now = time.perf_counter()
                    if nxt > now:
                        time.sleep(nxt - now)
                    elif nxt < now - per:
                        nxt = now          # far behind: resync, never burst
            pump = threading.Thread(target=feed, daemon=True)
            pump.start()
            n = 0
            mark = time.perf_counter()
            # Read the pipe by fd with a poll, because a plain blocking
            # read(65536) has no way to notice that the pipeline is DEAD.
            # feed() returns SILENTLY when hydra-cap's pipe closes -- no log, no
            # exception -- and ffmpeg, starved of input, simply stops producing
            # output while staying alive. The read then blocks forever: the
            # handler never returns, the `finally` never runs, and BOTH ffmpeg
            # and the capture client are leaked for the life of the service.
            # Six such pairs were alive at once, each holding the GPU, which is
            # why the picture kept dying and every reconnect failed worse than
            # the last. A pipe that goes quiet for 15s is a dead pipeline, not a
            # slow one.
            fd = ff.stdout.fileno()
            idle = 0.0
            # A phone that drops off WiFi leaves the socket half-open: writes go
            # into the kernel buffer and then block instead of failing, so the
            # handler parks with two processes held. A timeout makes the write
            # raise so the cleanup below actually runs.
            try:
                self.connection.settimeout(15)
            except OSError:
                pass
            while True:
                # The kick flag, checked on every poll. select() already gives a
                # 5s cadence, so this costs one bool test per poll and bounds
                # kick latency to ~5s. Raising here runs the SAME finally that
                # cleans up ffmpeg + hydra-cap, so a kick cannot become a leak --
                # which is precisely the failure this service already had once.
                global KICK
                if KICK:
                    KICK = False
                    sys.stderr.write("video: kick, dropping stream\n")
                    raise RuntimeError("kicked by console")
                ready, _, _ = select.select([fd], [], [], 5.0)
                if not ready:
                    idle += 5.0
                    if idle >= 15.0:
                        raise RuntimeError("encoder produced no output for 15s")
                    continue
                idle = 0.0
                chunk = os.read(fd, 65536)
                if not chunk:
                    return
                self.wfile.write(chunk)
                self.wfile.flush()
                n += len(chunk)
                if time.perf_counter() - mark >= 1.0:
                    sys.stderr.write("video fps=%s %d KB/s\n" % (fps, n // 1024))
                    n = 0
                    mark = time.perf_counter()
        except (BrokenPipeError, ConnectionResetError):
            return
        except Exception as e:  # noqa: BLE001
            sys.stderr.write("video ended: %s\n" % e)
        finally:
            # A leaked ffmpeg would keep the GPU busy and the pipe open forever,
            # and one per reconnect is how you get to twenty encoders. Same for
            # hydra-cap: a persistent capture client that outlives its socket
            # keeps the GPU reading frames nobody will ever see.
            if ff and ff.poll() is None:
                ff.kill()
            if cap and cap.poll() is None:
                cap.kill()
            # kill() only signals. Without a wait() each disconnect leaves two
            # <defunct> children behind, and a phone that reconnects on every
            # network change grows the zombie table one pair at a time.
            for p in (ff, cap):
                if p is not None:
                    try:
                        p.wait(timeout=1)
                    except Exception:  # noqa: BLE001
                        pass

    def _stream(self) -> None:
        """multipart/x-mixed-replace: one open socket, frames pushed as they land.

        Polling cost the phone ~130ms/frame on top of the capture, almost all of it
        per-request overhead (headers, blob copy, objectURL churn) rather than
        transfer. Same JPEG codec either way — this only removes the round trip,
        which is why it is the cheap rung before reaching for a video codec.
        """
        if not self._authed_cookie():
            self._send(401, b"bad token", "text/plain")
            return
        q = "80"
        fps = 30
        w = 0
        for kv in (self.path.split("?", 1)[1] if "?" in self.path else "").split("&"):
            if kv.startswith("q=") and kv[2:].isdigit():
                q = str(min(98, max(30, int(kv[2:]))))
            elif kv.startswith("w=") and kv[2:].isdigit():
                w = int(kv[2:])
            elif kv.startswith("fps=") and kv[4:].isdigit():
                # Capped because an uncapped stream is ~60 Mbps at 50 fps, which is
                # fine on the LAN and useless over a relay. TCP backpressure would
                # throttle it eventually, but "eventually" is a hung tab.
                fps = min(60, max(1, int(kv[4:])))
        self.send_response(200)
        self.send_header("Content-Type", "multipart/x-mixed-replace; boundary=hydra")
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        # No Content-Length: the body never ends, so the browser keeps painting
        # whatever arrives instead of waiting for a length it will never get.
        self.end_headers()
        try:
            mons = json.loads(subprocess.run(["hyprctl", "monitors", "-j"],
                                             capture_output=True, text=True).stdout)
            self.wfile.write(("--hydra %s\r\n" % f"{mons[0]['width']}x{mons[0]['height']}").encode())
            self.wfile.flush()
            sent = 0
            mark = time.perf_counter()
            while True:
                t0 = time.perf_counter()
                jpg = subprocess.run(["grim", "-t", "jpeg", "-q", q, "-"],
                                     capture_output=True, timeout=25).stdout
                if w:
                    jpg = subprocess.run(
                        ["magick", "-", "-resize", str(w), "-quality",
                         str(max(30, int(q) - 8)), "jpeg:-"], input=jpg,
                        capture_output=True, timeout=25).stdout
                if not jpg:
                    time.sleep(0.05)
                    continue
                self.wfile.write(b"--hydra\r\nContent-Type: image/jpeg\r\n"
                                 b"Content-Length: " + str(len(jpg)).encode() + b"\r\n\r\n")
                self.wfile.write(jpg + b"\r\n")
                self.wfile.flush()
                # Pace to the REQUESTED rate, and never below what the capture
                # actually costs, so the socket is never the reason a frame is late.
                dt = time.perf_counter() - t0
                want = max(1.0 / fps, dt)
                if dt < want:
                    time.sleep(want - dt)
                # One line per second, not per frame: per-frame logging would
                # throttle the very thing it measures.
                sent += 1
                if time.perf_counter() - mark >= 1.0:
                    sys.stderr.write("stream q=%s w=%d fps=%d got %d frames/s %d KB\n"
                                     % (q, w, fps, sent, len(jpg) // 1024))
                    sent = 0
                    mark = time.perf_counter()
        except (BrokenPipeError, ConnectionResetError):
            return  # phone went away; that is normal, not an error
        except Exception as e:  # noqa: BLE001
            sys.stderr.write("stream ended: %s\n" % e)

    def _authed_cookie(self) -> bool:
        raw = self.headers.get("Cookie") or ""
        m = re.search(r"hydra_token=([^;]+)", raw)
        return bool(m and hmac.compare_digest(m.group(1).strip(), Handler.tok))

    def do_POST(self) -> None:  # noqa: N802
        if self.path == "/kick":
            # Same token gate as /verb. It only drops one stream, but an
            # unauthenticated caller must not be able to interrupt anyone's
            # session, so it is not exempt just because it is harmless.
            if not secrets.compare_digest(self.headers.get("X-Hydra-Token", ""), self.tok):
                self._send(403, b'{"ok":false,"error":"bad token"}', "application/json")
                return
            global KICK
            KICK = True
            sys.stderr.write("kick requested\n")
            self._send(200, b'{"ok":true}', "application/json")
            return
        if self.path != "/verb":
            self._send(404, b"not found", "text/plain")
            return
        if not secrets.compare_digest(self.headers.get("X-Hydra-Token", ""), self.tok):
            self._send(403, b'{"ok":false,"error":"bad token"}', "application/json")
            return
        try:
            n = int(self.headers.get("Content-Length", 0))
            if n <= 0 or n > 4096:
                raise ValueError("bad body length")
            payload = json.loads(self.rfile.read(n))
        except Exception as exc:
            self._send(400, f'{{"ok":false,"error":"{exc}"}}'.encode(), "application/json")
            return
        if not isinstance(payload, dict):
            self._send(400, b'{"ok":false,"error":"bad body"}', "application/json")
            return
        verb = payload.get("verb", "")
        # A second argv element, never interpolated into anything. Only queue:add
        # reads it, and it derives a [a-z0-9-] filename from it — no path is ever
        # built out of the argument.
        arg = payload.get("arg", "")
        if not isinstance(arg, str) or len(arg) > 2000:
            self._send(400, b'{"ok":false,"error":"bad arg"}', "application/json")
            return
        # The verb stays a bare identifier; hydra-remote owns the whitelist.
        if not isinstance(verb, str) or not verb or len(verb) > 40:
            self._send(400, b'{"ok":false,"error":"bad verb"}', "application/json")
            return
        if not all(c.isalnum() or c in "-_:" for c in verb):
            self._send(400, b'{"ok":false,"error":"bad verb charset"}', "application/json")
            return
        try:
            # Screenshots are PNG, so they cannot ride the text-only helper. This is
            if verb == "diag":
                # Client-side truth (MediaSource support, appendBuffer errors) that
                # I cannot see: screencap is frozen on this phone.
                sys.stderr.write("diag %s\n" % str(arg)[:300])
                self._send(200, b'{"ok":true}', "application/json")
                return
            # the one verb handled here; every other verb still goes through
            # hydra-remote, so the whitelist stays the single home for the surface.
            if verb == "screen":
                # grim can encode JPEG ITSELF (-t jpeg). Forcing it through PNG
                # first and re-encoding with magick cost 141ms/frame; grim's own
                # JPEG is 13ms — the PNG step, not the capture, was the 110ms.
                # Never scale with grim (-s): it re-encodes and is 4x SLOWER.
                # arg is "<quality>[,<width>]"; native resolution is the default
                # because screen text is the payload.
                a = [x for x in arg.replace(",", " ").split() if x]
                q = a[0] if a else "80"
                w = a[1] if len(a) > 1 else "0"
                q = q if q.isdigit() and 30 <= int(q) <= 98 else "80"
                t0 = time.perf_counter()
                jpg = subprocess.run(["grim", "-t", "jpeg", "-q", q, "-"],
                                     capture_output=True, timeout=25).stdout
                if w not in ("0", ""):
                    jpg = subprocess.run(
                        ["magick", "-", "-resize", w, "-quality", str(int(q) - 6),
                         "jpeg:-"], input=jpg, capture_output=True,
                        timeout=25).stdout
                # The phone chooses quality; only the server knows what it cost.
                # Without this line you cannot tell a slow LINK from a slow PHONE.
                sys.stderr.write("screen q=%s w=%s %dKB %dms  client[ %s ]\n" % (
                    q, w or "native", len(jpg) // 1024,
                    int((time.perf_counter() - t0) * 1000),
                    self.headers.get("X-Link") or "-"))
                # The real desktop size, so the phone can turn a tap on a 1280px
                # wide thumbnail back into a coordinate on the 1366px screen.
                try:
                    mons = json.loads(subprocess.run(["hyprctl", "monitors", "-j"],
                                                     capture_output=True, text=True).stdout)
                    self._send(200, jpg, "image/jpeg",
                               extra={"X-Screen": f"{mons[0]['width']}x{mons[0]['height']}"})
                except Exception:
                    self._send(200, jpg, "image/jpeg")
                return
            argv = [HELPER, verb] + ([arg] if arg else [])
            p = subprocess.run(argv, capture_output=True, text=True, timeout=60)
            out = (p.stdout + p.stderr).strip()[:1600] or f"exit {p.returncode}"
            self._send(200, json.dumps({"ok": p.returncode == 0, "out": out}).encode(),
                       "application/json")
        except subprocess.TimeoutExpired:
            self._send(504, b'{"ok":false,"error":"timeout"}', "application/json")

    def log_message(self, fmt: str, *a) -> None:
        sys.stderr.write("%s %s\n" % (self.address_string(), fmt % a))


def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("--port", type=int, default=8444)
    args = ap.parse_args()
    Handler.tok = token()
    srv = http.server.ThreadingHTTPServer(("127.0.0.1", args.port), Handler)
    print(f"hydra-remote-web on 127.0.0.1:{args.port}")
    # Never print the secret: stdout lands in the user journal, and a token in
    # `journalctl --user -u hydra-remote-web` is a token in every future paste.
    print(f"token loaded ({len(Handler.tok)} chars); read with: cat {TOKEN_FILE}")
    srv.serve_forever()


if __name__ == "__main__":
    main()
