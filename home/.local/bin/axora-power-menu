#!/usr/bin/env bash
# axora-power-menu — open the shell's power menu.
#
# This used to be a second, independent implementation: it piped its own
# lock/logout/reboot/shutdown list into fuzzel and had its own `case`. That
# drifted from the real menu (it never gained Suspend) and is the same class of
# bug that made Logout a silent no-op — two lists, only one maintained.
# AxoraPowerMenu.qml is the real menu and dispatches through axora-power-action.
set -uo pipefail

if ! qs -c axora ipc call power toggle >/dev/null 2>&1; then
    printf 'axora-power-menu: shell not running — start it with axora-shell-reload\n' >&2
    exit 1
fi
