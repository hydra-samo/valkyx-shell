#!/bin/bash
# valkyx-focus <app-pattern> [launch-command]
# Launch an app, or focus its already-open window if one exists (launch-or-focus,
# ported from Omarchy's omarchy-launch-or-focus). Pattern = extended regex
# matched case-insensitively against class then title.
#
# Hyprland 0.56 Lua config note: valkyx-dispatch mangles args, so focus goes
# through hl.dsp.focus via eval. Exec is chained in one shell so tokens in
# LAUNCH_CMD survive without eval.
set -u

PATTERN="${1:?usage: valkyx-focus <pattern> [launch-command...]}"
shift
LAUNCH_CMD=("$@")
if ((${#LAUNCH_CMD[@]} == 0)); then
    LAUNCH_CMD=("$PATTERN")
fi

ADDR=$(
    hyprctl clients -j 2>/dev/null | jq -r --arg p "$PATTERN" '
        map(select((
            (.class // "") | test($p; "i")
        ) or (
            (.title // "") | test($p; "i")
        ))) | .[0].address // empty'
)

if [[ -n "$ADDR" ]]; then
    hyprctl eval "return hl.dispatch(hl.dsp.focus({ window = \"address:$ADDR\" }))" >/dev/null 2>&1
else
    launch_cmd="${LAUNCH_CMD[*]}"
    eval "setsid -f $launch_cmd >/dev/null 2>&1 < /dev/null &"
    disown || true
fi