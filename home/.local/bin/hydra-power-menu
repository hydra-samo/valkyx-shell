#!/usr/bin/env bash
# valkyx-power-menu — open the shell's power menu.
#
# This used to be a second, independent implementation: it piped its own
# lock/logout/reboot/shutdown list into fuzzel and had its own `case`. That
# drifted from the real menu (it never gained Suspend) and is the same class of
# bug that made Logout a silent no-op — two lists, only one maintained.
# ValkyxPowerMenu.qml is the real menu and dispatches through valkyx-power-action.
set -uo pipefail

if ! qs -c valkyx ipc call power toggle >/dev/null 2>&1; then
    printf 'valkyx-power-menu: shell not running — start it with valkyx-shell-reload\n' >&2
    exit 1
fi
