#!/usr/bin/env bash
# hydra-jarvis-rollback — restore the pre system-status state.
# usage: hydra-jarvis-rollback [snapshot]   (default: latest)
# Pairs with the HYDRA_SYSTEM_STATUS=0 keyword for a lighter revert.
set -euo pipefail
ROOT="$HOME/.local/state/hydra/jarvis-system-slice"
SNAP="${1:-}"
[ -n "$SNAP" ] || SNAP="$(ls -1 "$ROOT" 2>/dev/null | sort | tail -1)"
if [ -z "$SNAP" ] || [ ! -f "$ROOT/$SNAP/files.tgz" ]; then
  echo "no snapshot found under $ROOT" >&2
  exit 1
fi
echo "restoring $SNAP"
tar xzf "$ROOT/$SNAP/files.tgz" -C "$HOME"
if [ -f "$ROOT/$SNAP/created.txt" ]; then
  while IFS= read -r f; do
    [ -n "$f" ] && rm -f "$HOME/$f"
  done < "$ROOT/$SNAP/created.txt"
fi
systemctl --user restart hydra-assistant.service 2>/dev/null || true
echo "restored. reload the shell to drop the System rail entry:  hydra-shell-reload"
