#!/usr/bin/env bash
# hydra-hub-check — prove the :8444 page's JavaScript actually parses.
#
# Why this exists: the served page is a Python string literal, so a JS escape like
# '\n\n' can be eaten by Python and land in the browser as a real newline inside a
# quoted string. That is a SyntaxError, and it is INVISIBLE to every other check —
# the endpoints all answer 200, the verbs all work, only the page is dead. This
# shipped once already (Oct 1). `node --check` on the extracted <script> is the
# cheapest thing that actually sees it; there is no browser on this box.
set -uo pipefail

SRC="$HOME/.local/bin/hydra-remote-web"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

python3 - "$SRC" "$tmp/hub.js" <<'PY'
import ast, pathlib, re, sys
src, out = sys.argv[1], sys.argv[2]
tree = ast.parse(pathlib.Path(src).read_text())          # python must parse too
page = next(ast.literal_eval(n.value)
            for n in tree.body
            if isinstance(n, ast.Assign)
            and getattr(n.targets[0], "id", "") == "PAGE")
js = re.search(r"<script>(.*?)</script>", page, re.S)
if not js:
    sys.exit("no <script> block found in PAGE")
pathlib.Path(out).write_text(js.group(1))
PY
rc=$?
[ "$rc" -eq 0 ] || { echo "FAIL: could not extract the page JS"; exit 1; }

if node --check "$tmp/hub.js" 2>"$tmp/err"; then
  echo "hub JS parses ($(wc -c <"$tmp/hub.js") bytes)"
else
  echo "FAIL: the served page JS is a SyntaxError — the page would render dead"
  cat "$tmp/err"
  exit 1
fi