#!/usr/bin/env bash
# valkyx-logout-watchdog <session-id> — end the session, from outside it.
#
# Runs as a `systemd-run --user` unit under user@1000.service/app.slice/, a
# sibling of session-N.scope, so it outlives the session it terminates. A plain
# `&` or `setsid` would die with it — that was the original bug.
#
# There is deliberately no "clean exit" rung. Two were tried and both are dead:
#   - hyprctl eval 'hl.dsp.exit()'  -> returns 0, exits nothing
#   - valkyx-dispatch exit         -> rc=7; 'exit' is not a dispatcher in this
#     Hyprland build (only exec/killwindow/moveactive exist in the binary)
# They cost 10 wasted seconds of a frozen-looking desktop before failing.
# loginctl terminate-session is the only rung that has ever worked here: rc=0,
# three times out of three, and the session is gone immediately.
#
# So: terminate, then make sure a greeter actually appears. That second half is
# not optional — SDDM starts no greeter while any session holds seat0, which is
# why a bare logout used to leave a black screen with a blinking cursor forever.
set -u

sid="${1:-}"
LOG="${XDG_STATE_HOME:-$HOME/.local/state}/valkyx-power.log"
note() { printf '%s logout    %s\n' "$(date -Iseconds)" "$*" >>"$LOG"; }

[ -n "$sid" ] || { note "watchdog: no session id given"; exit 1; }

export XDG_RUNTIME_DIR=/run/user/1000

session_alive() { loginctl show-session "$sid" -p State --value >/dev/null 2>&1; }
greeter_up()    { pgrep -x sddm-greeter >/dev/null 2>&1; }
# session ids currently on seat0, '*' (the active one) stripped
seat_ids() {
    loginctl seat-status seat0 2>/dev/null | sed -n 's/^Sessions: *//p' \
        | tr -s ' ' '\n' | tr -d '*' | grep -v '^$'
}

# ── end the session ─────────────────────────────────────────────────────────
note "watchdog: ending session $sid"
loginctl terminate-session "$sid"
note "watchdog: terminate-session rc=$?"

for _ in 1 2 3 4 5; do
    session_alive || break
    sleep 1
done
if session_alive; then
    note "watchdog: session $sid STILL alive 5s after terminate — giving up on it"
fi

# ── make sure a greeter comes back ──────────────────────────────────────────
# If another session still holds the seat, waiting is pointless: SDDM will
# never start a greeter, so skip straight to the restart instead of stalling.
sleep 2
others=$(seat_ids | grep -vx "$sid" || true)
if [ -n "$others" ]; then
    note "watchdog: session(s) $(echo $others) still hold seat0 — SDDM will not start a greeter, restarting sddm now"
else
    for _ in $(seq 1 8); do
        if greeter_up; then
            note "watchdog: greeter is up"
            exit 0
        fi
        sleep 1
    done
    note "watchdog: seat is free but no greeter after 8s — restarting sddm"
fi

sudo -n systemctl restart sddm
note "watchdog: sddm restart rc=$?"
