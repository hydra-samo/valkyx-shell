#!/usr/bin/env python3
"""axora-gen-theme: one palette in, every visible surface out.

Reads a theme (axora preset in ~/.config/axora/theming/themes/<Name>.json
or omarchy catalog entry in .../catalog/<Name>/) and emits the palette
across: kitty (default), btop, code-oss, gtk icons, cursor, nvim
colorscheme (registry
only), wallpaper (omarchy), and prints the accent/border tokens the shell
consumers.

Surfaces only touched when their config actually exists on this box.
"""
import json, os, re, subprocess, sys, tomllib

HOME = os.path.expanduser("~")
REG = os.path.expanduser("~/.config/axora/theming")
OUT = os.path.join(REG, "out")
CFG_KITTY = os.path.expanduser("~/.config/kitty")
CFG_BTOP = os.path.expanduser("~/.config/btop")
CFG_CODE = os.path.expanduser("~/.config/Code - OSS/User/settings.json")
WALLS = os.path.expanduser("~/Pictures/Wallpapers/omarchy")

PRESETS = ["Axora", "Violet", "Ocean", "Ember", "Amber", "Cyan"]

DRY = "--dry" in sys.argv
# Cursor is owned by the shell (AxoraState) which tracks an explicit user pick;
# standalone CLI use must opt in, or a theme apply would clobber that pick.
CURSOR = "--cursor" in sys.argv

CURSOR_BY_MIN_ACCENT = [  # (accent like themes need, cursor theme)
    ("#00A86B", "Maya-Green"), ("#7C4DFF", "Axora-Violet"),
    ("#2196F3", "Maya-Blue24"), ("#FF5252", "Maya-Red24"),
    ("#FF9800", "Maya-Orange"), ("#00BCD4", "Axora-Cyan"),
]


def rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))


def hexs(t):
    return "#{:02x}{:02x}{:02x}".format(*(round(min(1, max(0, v)) * 255) for v in t))


def mix(a, b, k):
    return tuple(round(ai * (1 - k) + bi * k, 3) for ai, bi in zip(a, b))


def lighten(h, k):
    return hexs(mix(rgb(h), (1, 1, 1), k))


def darken(h, k):
    return hexs(mix(rgb(h), (0, 0, 0), k))


def muted(accent):
    r, g, b = rgb(accent)
    return hexs((0.40 + r * 0.45, 0.43 + g * 0.45, 0.40 + b * 0.45))


def hue(hexcol):
    r, g, b = rgb(hexcol)
    mx, mn = max(r, g, b), min(r, g, b)
    d = mx - mn
    if d < 1e-6:
        return -1
    if mx == r:
        h = ((g - b) / d) % 6
    elif mx == g:
        h = (b - r) / d + 2
    else:
        h = (r - g) / d + 4
    return h * 60


def hue_dist(a, b):
    d = abs(a - b) % 360
    return min(d, 360 - d)


def nearest_cursor(accent):
    # hue-family match (same rule as AxoraState.nearestTheme): color family, never
    # raw RGB — a blue accent must not snap to violet. Achromatic → brand green.
    h = hue(accent)
    if h < 0:
        return "Maya-Green"
    return min(CURSOR_BY_MIN_ACCENT, key=lambda p: hue_dist(h, hue(p[0])))[1]


def load_theme(name):
    preset = os.path.join(REG, "themes", name + ".json")
    if os.path.exists(preset):
        with open(preset) as f:
            return {"name": name, "source": "axora", **json.load(f)}
    cat = os.path.join(REG, "catalog", name)
    if not os.path.isdir(cat):
        sys.exit(f"theme not found: {name}")
    camp = os.path.join(cat, "colors.toml")
    with open(camp, "rb") as f:
        c = tomllib.load(f)
    return {
        "name": name, "source": "omarchy",
        "colors": {
            "accent": c.get("accent", "#ffffff"),
            "bg": c.get("background", c.get("dark_background", "#1a1b26")),
            "surface": c.get("lighter_background", c.get("background", "#24283b")),
            "field": c.get("lighter_background", c.get("background", "#24283b")),
            "line": c.get("darker_background", c.get("background", "#0e0e14")),
            "text": c.get("foreground", "#c0caf5"),
            "muted": c.get("muted", muted(c.get("accent", "#ffffff"))),
            "textOnAccent": c.get("dark_foreground", "#1a1b26"),
            "red": c.get("red", "#f7768e"), "green": c.get("green", "#9ece6a"),
            "yellow": c.get("yellow", "#e0af68"), "blue": c.get("blue", c.get("accent", "#7aa2f7")),
            "magenta": c.get("magenta", "#ad8ee6"), "cyan": c.get("cyan", "#449dab"),
        },
    }


def palette(t):
    c = t["colors"]
    if t["source"] == "axora":
        c = dict(c)
        c["red"], c["green"], c["yellow"] = c["danger"], "#3fd68a", c["warning"]
        c["blue"], c["magenta"], c["cyan"] = c["accent"], "#b69dff", "#55c5d9"
    def sc(k, dflt):
        return c.get(k, dflt)
    base = {
        "accent": sc("accent", "#00a86b"), "muted": sc("muted", None),
        "bg": sc("bg", "#101614"), "surface": sc("surface", "#141d19"),
        "field": sc("field", "#1a2420"), "line": sc("line", "#1a2420"),
        "text": sc("text", "#e6eae8"), "textOnAccent": sc("textOnAccent", "#04140d"),
        "red": c["red"], "green": c["green"], "yellow": c["yellow"],
        "blue": c["blue"], "magenta": c["magenta"], "cyan": c["cyan"],
    }
    if base["muted"] is None:
        base["muted"] = muted(base["accent"])
    base["color0"] = base["bg"]
    base["color1"] = base["red"]; base["color2"] = base["green"]; base["color3"] = base["yellow"]
    base["color4"] = base["blue"]; base["color5"] = base["magenta"]; base["color6"] = base["cyan"]
    base["color7"] = base["text"]; base["color8"] = base["muted"]
    base["color9"] = lighten(base["color1"], 0.25); base["color10"] = lighten(base["color2"], 0.25)
    base["color11"] = lighten(base["color3"], 0.25); base["color12"] = lighten(base["color4"], 0.25)
    base["color13"] = lighten(base["color5"], 0.25); base["color14"] = lighten(base["color6"], 0.25)
    base["color15"] = lighten(base["color7"], 0.25)
    return base


# ── surfaces ────────────────────────────────────────────────────────────

def emit_kitty(name_text, p):
    d = os.path.join(OUT, "dry", "kitty") if DRY else os.path.join(CFG_KITTY, "axora-themes")
    os.makedirs(d, exist_ok=True)
    path = os.path.join(d, name_text + ".conf")
    lines = [f"# generated by axora-gen-theme: {name_text}", "",
             f"foreground            {p['text']}", f"background            {p['bg']}",
             f"selection_foreground   {p['bg']}", f"selection_background   {p['accent']}",
             f"cursor                {p['accent']}", f"cursor_text_color     {p['textOnAccent']}"]
    for i in range(16):
        lines.append(f"color{i}                 {p['color%d' % i]}")
    with open(path, "w") as f:
        f.write("".join(l + "\n" for l in lines))
    if DRY:
        return path
    sym = os.path.join(CFG_KITTY, "current-theme.conf")
    target = os.path.join("axora-themes", os.path.basename(path))
    if os.path.islink(sym):
        os.unlink(sym)
    if not os.path.exists(sym):
        os.symlink(target, sym)
    return path


def emit_btop(name_text, p):
    d = os.path.join(OUT, "dry", "btop") if DRY else os.path.join(CFG_BTOP, "themes")
    os.makedirs(d, exist_ok=True)
    path = os.path.join(d, name_text + ".theme")
    grad = [p["bg"], p["line"], p["field"], p["muted"], lighten(p["accent"], 0.45),
            lighten(p["accent"], 0.65), p["accent"], p["text"]]
    with open(path, "w") as f:
        f.write(f"theme[main_bg]=\"{p['bg']}\"\n")
        f.write(f"theme[main_fg]=\"{p['text']}\"\n")
        f.write(f"theme[title]=\"{p['text']}\"\n")
        f.write(f"theme[hi_fg]=\"{p['muted']}\"\n")
        f.write(f"theme[selected_bg]=\"{p['accent']}\"\n")
        f.write(f"theme[selected_fg]=\"{p['textOnAccent']}\"\n")
        f.write(f"theme[inactive_fg]=\"{p['muted']}\"\n")
        f.write(f"theme[graph_text]=\"{p['text']}\"\n")
        f.write(f"theme[meter_bg]=\"{p['line']}\"\n")
        f.write(f"theme[proc_misc]=\"{p['muted']}\"\n")
        for box in ["cpu_box", "mem_box", "net_box", "proc_box", "div_line"]:
            f.write(f"theme[{box}]=\"{p['line']}\"\n")
        for grp in ["temp", "cpu", "free", "cached", "available", "used", "download", "upload", "process"]:
            f.write(f"theme[{grp}_start]=\"{p['accent']}\"\n")
            f.write(f"theme[{grp}_mid]=\"{lighten(p['accent'], 0.5)}\"\n")
            f.write(f"theme[{grp}_end]=\"{p['text']}\"\n")
        for i, col in enumerate(grad):
            f.write(f"theme[gradient_color_{i}]=\"{col}\"\n")
    if DRY:
        return path
    conf = os.path.join(CFG_BTOP, "btop.conf")
    if os.path.exists(conf):
        s = open(conf).read()
        s = re.sub(r'color_theme\s*=.*', f'color_theme = "{name_text}"', s, count=1)
        open(conf, "w").write(s)
    return path


def emit_code(name_text, p):
    if not os.path.exists(CFG_CODE):
        return None
    with open(CFG_CODE) as f:
        d = json.load(f)
    cc = d.setdefault("workbench.colorCustomizations", {})
    cc.update({
        "editor.background": p["bg"], "editor.foreground": p["text"],
        "editorCursor.foreground": p["accent"],
        "editor.selectionBackground": p["accent"] + "55",
        "sideBar.background": p["surface"], "sideBar.foreground": p["text"],
        "activityBar.background": p["field"], "activityBar.foreground": p["muted"],
        "activityBar.activeBorder": p["accent"],
        "statusBar.background": p["accent"], "statusBar.foreground": p["textOnAccent"],
        "titleBar.background": p["surface"], "titleBar.foreground": p["text"],
        "panel.background": p["bg"],
        "input.background": p["field"], "focusBorder": p["accent"],
    })
    dest = os.path.join(OUT, "dry", "code-oss-settings.json") if DRY else CFG_CODE
    if DRY:
        os.makedirs(os.path.dirname(dest), exist_ok=True)
    with open(dest, "w") as f:
        json.dump(d, f, indent=2)
    return dest


def emit_nvim(name_text, p):
    d = os.path.join(OUT, "nvim")
    os.makedirs(d, exist_ok=True)
    path = os.path.join(d, "axora-" + name_text.lower() + ".lua")
    with open(path, "w") as f:
        f.write(f"-- generated by axora-gen-theme: {name_text}\n")
        f.write(f"vim.g.axora_bg = '{p['bg']}'\n")
    return path


def build_catalog():
    """Write catalog-full.json: one normalized entry per theme (axora presets +
    imported omarchy), so the shell picker can offer the whole catalog."""
    entries = []
    tdir = os.path.join(REG, "themes")
    for fn in sorted(os.listdir(tdir)):
        if not fn.endswith(".json"):
            continue
        with open(os.path.join(tdir, fn)) as f:
            t = json.load(f)
        c = t["colors"]
        entries.append({"name": t["name"], "source": "axora", "light": False,
                        "accent": c["accent"], "bg": c["bg"], "surface": c["surface"],
                        "field": c["field"], "line": c["line"], "wallpaper": None})
    cdir = os.path.join(REG, "catalog")
    for name in sorted(os.listdir(cdir)):
        cp = os.path.join(cdir, name, "colors.toml")
        if not os.path.isfile(cp):
            continue
        with open(cp, "rb") as f:
            c = tomllib.load(f)
        wall = os.path.join(WALLS, name)
        wps = [os.path.join(wall, x) for x in sorted(os.listdir(wall))] if os.path.isdir(wall) else []
        entries.append({
            "name": name, "source": "omarchy", "light": c.get("mode") == "light",
            "accent": c.get("accent", "#ffffff"),
            "bg": c.get("background", "#1a1b26"),
            "surface": c.get("lighter_background", c.get("background", "#24283b")),
            "field": c.get("lighter_background", c.get("background", "#24283b")),
            "line": c.get("darker_background", c.get("background", "#0e0e14")),
            "wallpaper": wps[0] if wps else None,
        })
    path = os.path.join(REG, "catalog-full.json")
    with open(path, "w") as f:
        json.dump({"themes": entries}, f, indent=2)
        f.write("\n")
    return path


def emit_wallpaper(name):
    """Resolve the theme's wallpaper. Never applies it: the caller (AxoraState
    .setWallpaper) owns the live desktop. Prints path for chaining."""
    wall = os.path.join(WALLS, name)
    if not os.path.isdir(wall):
        return None
    files = [os.path.join(wall, x) for x in sorted(os.listdir(wall))]
    return files[0] if files else None


def apply_gtk(accent, name):
    path = os.path.expanduser("~/.local/bin/axora-gtk-icons")
    if os.path.exists(path):
        subprocess.run([path, name, accent.lower()], capture_output=True)


def apply_cursor(accent):
    path = os.path.expanduser("~/.local/bin/axora-cursor")
    if os.path.exists(path):
        subprocess.run([path, nearest_cursor(accent), "34"], capture_output=True)


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("-")]
    if "--list" in sys.argv:
        names = sorted(os.path.basename(x)[:-5] for x in os.scandir(os.path.join(REG, "themes"))) + \
                sorted(os.path.basename(x) for x in os.scandir(os.path.join(REG, "catalog")))
        print("\n".join(dict.fromkeys(names)))
        return
    if not args:
        sys.exit("usage: axora-gen-theme <ThemeName|--list>")
    name = args[0]
    build_catalog()
    t = load_theme(name)
    p = palette(t)
    # self-test: mixed/derived colors must round-trip
    assert len(p["color0"]) == 7 and all(p[f"color{i}"] for i in range(16))
    # cursor must match by HUE family (regression: blue used to snap to violet)
    assert nearest_cursor("#7aa2f7") == "Maya-Blue24"
    assert nearest_cursor("#e06c75") == "Maya-Red24"
    assert nearest_cursor("#00a86b") == "Maya-Green"
    os.makedirs(OUT, exist_ok=True)
    with open(os.path.join(OUT, name + ".json"), "w") as f:
        json.dump({"name": t["name"], "source": t["source"], **p}, f, indent=2)
        f.write("\n")
    theme_name = (name[0].lower() + name[1:]).replace("-", "_")
    for fn, a in [(emit_kitty, (theme_name, p)),
                  (emit_btop, (theme_name, p)),
                  (emit_code, (theme_name, p)), (emit_nvim, (theme_name, p))]:
        r = fn(*a)
        if r:
            print(f"  {fn.__name__}: {r}")
    wp = emit_wallpaper(name)
    if wp:
        print(f"  wallpaper: {wp}")
    if DRY:
        print(f"dry {t['name']} | accent={p['accent']} muted={p['muted']} cursor={nearest_cursor(p['accent'])}")
        return
    apply_gtk(p["accent"], name)
    if CURSOR:
        apply_cursor(p["accent"])
    subprocess.run(["pkill", "-USR1", "-x", "kitty"], capture_output=True)
    # foot has NO config-reload signal (only SIGUSR1/SIGUSR2 = toggle dark/light),
    # so there is nothing to poke: foot reads foot.ini at startup and picks the new
    # current-theme.ini up on the next window. SIGHUP is deliberately NOT sent — it
    # does not reload, and its default action is terminate.
    print(f"ok {t['name']} | accent={p['accent']} muted={p['muted']} cursor={nearest_cursor(p['accent'])}")


if __name__ == "__main__":
    main()