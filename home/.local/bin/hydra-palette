#!/usr/bin/env bash
# Derive a HYDRA accent + dark surface family from a wallpaper via matugen.
# Writes ~/.cache/hydra-palette.json: {accent, bg, surface, field, line}
# Accepts an image path (or none = re-derive from the persisted wallpaper).
set -euo pipefail

IMG="${1:-}"
[ -z "$IMG" ] && IMG="$HOME/.local/share/backgrounds/hydra-samo-wallpaper.svg"
[ -f "$IMG" ] || { echo "no wallpaper at $IMG" >&2; exit 1; }

TMP="$(mktemp)"
trap 'rm -f "$TMP"' EXIT
# matugen exits non-zero without a TTY (multi-source-color backtrace); ignore that,
# stdout still carries the full scheme. Run via a temp file to avoid set -e killing
# the command substitution.
# --prefer=saturation pulls the wallpaper's dominant vibrant color into the accent;
# base16 still yields neutral-dark surfaces for the acrylic family.
matugen image -q --mode dark --json hex --prefer=saturation -t scheme-tonal-spot "$IMG" > "$TMP" 2>/dev/null || true

mkdir -p "$HOME/.cache"
python3 - "$TMP" "$HOME/.cache/hydra-palette.json" "$IMG" <<'PY'
import json, sys, colorsys
from PIL import Image
# HYDRA palette post-process: matugen's tonal/dark accents are pale & washed
# (was #FFB2BC on a dark wallpaper) and its base02/base03 surfaces are too
# bright. Saturate + darken the accent toward the wallpaper's own color and
# pull surface/line down toward base00 so panels read deep, not "clear".
d = json.load(open(sys.argv[1]))
def c(o, path):
    cur = o
    for k in path: cur = cur[k]
    return cur
def hex2rgb(h):
    h = h.lstrip('#')
    return tuple(int(h[i:i+2],16) for i in (0,2,4))
def rgb2hex(c_):
    return '#%02X%02X%02X' % tuple(max(0,min(255,round(v))) for v in c_)
def mix(a, b, t):
    return tuple(a[i]+(b[i]-a[i])*t for i in range(3))
base00 = hex2rgb(c(d,["base16","base00","dark","color"]))
base01 = hex2rgb(c(d,["base16","base01","dark","color"]))
base02 = hex2rgb(c(d,["base16","base02","dark","color"]))
base03 = hex2rgb(c(d,["base16","base03","dark","color"]))
accent = hex2rgb(c(d,["colors","primary","dark","color"]))
h, s, v = colorsys.rgb_to_hsv(*(x/255 for x in accent))
s = max(s, 0.62)                     # saturate toward the wallpaper's color
v = 0.60 + v*0.12                    # darker, less washed
accent_o = rgb2hex(tuple(x*255 for x in colorsys.hsv_to_rgb(h, s, min(v,1.0))))
# dominant = the wallpaper's own dominant color (PIL quantize, skip near-black/gray)
# so the accent family reflects what the image actually is, not matugen's synthetic
# tonal-spot primary. Same extraction rule as hydra-wallhues.
def dominant_of(path):
    try:
        im = Image.open(path).convert("RGB").copy()
        im.thumbnail((24, 24))
        q = im.quantize(colors=8, method=2).convert("RGB")
        counts = sorted(q.getcolors(maxcolors=8) or [], reverse=True)
        for _cnt, rgb in counts:
            hh, ss, vv = colorsys.rgb_to_hsv(*(x/255 for x in rgb))
            if ss >= 0.12 and vv >= 0.16:                  # s>12%, v>16% = colorful enough
                return "#%02X%02X%02X" % rgb
    except Exception:
        pass
    return accent_o
dominant = dominant_of(sys.argv[3])
pal = {
    "accent": accent_o,
    "dominant": dominant,
    "bg":     rgb2hex(base00),
    "surface": rgb2hex(mix(base00, base01, 0.85)),
    "field":  rgb2hex(mix(base00, base01, 0.55)),
    "line":   rgb2hex(mix(base00, base02, 0.55)),
}
json.dump(pal, open(sys.argv[2], "w"))
print(pal["dominant"])
PY