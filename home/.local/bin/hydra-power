#!/usr/bin/env bash
#
# valkyx-power — CPU power profile control for VALKYX
#
# Works around a firmware limitation: the HP platform_profile driver
# (hp-wmi ACPI) ignores profile writes and always reports "balanced", so
# power-profiles-daemon cannot hold performance/power-saver. Direct
# intel_pstate EPP + governor + RAPL PL1 writes DO stick, so we use those.
# The reported "effective profile" below is derived from EPP/governor, NOT
# from the firmware-locked platform_profile.
#
# PL1 (sustained package power limit): performance=28W, balanced=15W (firmware
# default), power-saver=10W. PL2 (turbo burst) is left untouched.
#
# Commands:
#   valkyx-power set <performance|balanced|power-saver>
#   valkyx-power get
#   valkyx-power status
#   valkyx-power menu        (rofi menu)
#   valkyx-power persist     (store current selection to be reapplied at login)
#
set -euo pipefail

STATE_FILE="$HOME/.config/valkyx/power-profile"

mkdir -p "$HOME/.config/valkyx"

_apply() {
    local profile="$1"
    case "$profile" in
        performance|balanced|power-saver) ;;
        *) echo "unknown profile: $profile"; exit 2 ;;
    esac
    sudo /usr/local/sbin/valkyx-power-helper cpu "$profile"
}

_effective() {
    case "$(cat /sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference 2>/dev/null || echo n/a)" in
        performance) echo "performance" ;;
        power)       echo "power-saver" ;;
        *)           echo "balanced" ;;
    esac
}

cmd_set() {
    local profile="$1"
    _apply "$profile"
    echo "$profile" > "$STATE_FILE"
    ~/.local/bin/valkyx-gpu profile >/dev/null 2>&1 || true
    if command -v notify-send >/dev/null && [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
        notify-send -a "VALKYX Power" -i "power-profile-battery" "Power profile: $profile" \
            "CPU governor/EPP/PL1 set (Intel pstate). NVIDIA remains on-demand via SUPER+SHIFT+G." || true
    fi
    echo "valkyx-power: $profile applied"
}

cmd_get() {
    echo "effective=$(_effective)  governor=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo n/a)  EPP=$(cat /sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference 2>/dev/null || echo n/a)"
}

cmd_status() {
    echo "=== VALKYX Power State ==="
    echo "effective profile: $(_effective)"
    echo "intel_pstate EPP:  $(cat /sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference 2>/dev/null || echo n/a)"
    echo "governor:          $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo n/a)"
    echo "saved profile:     $(cat "$STATE_FILE" 2>/dev/null || echo none)"
    echo "RAPL PL1/PL2:      $(( $(cat /sys/class/powercap/intel-rapl:0/constraint_0_power_limit_uw 2>/dev/null) / 1000000 ))W / $(( $(cat /sys/class/powercap/intel-rapl:0/constraint_1_power_limit_uw 2>/dev/null) / 1000000 ))W"
    echo "platform_profile:  $(cat /sys/firmware/acpi/platform_profile 2>/dev/null || echo n/a) (firmware-only; HP BIOS ignores it)"
}

cmd_menu() {
    local choice
    choice=$(printf 'performance\nbalanced\npower-saver' | rofi -dmenu -i -p "Power profile (CPU)")
    [ -z "$choice" ] && exit 0
    cmd_set "$choice"
}

cmd="${1:-status}"
case "$cmd" in
    set)      [ $# -ge 2 ] || { echo "usage: valkyx-power set <profile>"; exit 2; }; cmd_set "$2" ;;
    get)      cmd_get ;;
    status)   cmd_status ;;
    menu)     cmd_menu ;;
    persist)  echo "persisted: $(cat "$STATE_FILE" 2>/dev/null || echo none)" ;;
    *) echo "usage: valkyx-power {set <profile>|get|status|menu|persist}"; exit 2 ;;
esac
