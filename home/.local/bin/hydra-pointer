#!/bin/bash
# hydra-pointer: absolute cursor move (+ optional click) via REL deltas
# usage: hydra-pointer X Y [click]
# REL-only ydotoold: compute delta from current cursorpos (flat accel = 1:1)
cur=$(hyprctl cursorpos | tr -d ' ')
IFS=, read -r cx cy <<< "$cur"
dx=$(( $1 - cx ))
dy=$(( $2 - cy ))
ydotool mousemove -x "$dx" -y "$dy"
if [ "$3" = "click" ]; then ydotool click 0xC0; fi