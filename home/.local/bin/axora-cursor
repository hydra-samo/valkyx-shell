#!/bin/bash
# axora-cursor [theme] [size] — set cursor theme+size system-wide (GTK/gsettings/xcursor).
theme="${1:-Maya-Green}"; size="${2:-24}"
gsettings set org.gnome.desktop.interface cursor-theme "$theme" 2>/dev/null
gsettings set org.gnome.desktop.interface cursor-size "$size" 2>/dev/null
gsettings set org.mate.interface cursor-theme "$theme" 2>/dev/null
for f in ~/.config/gtk-3.0/settings.ini ~/.config/gtk-4.0/settings.ini; do
    [ -f "$f" ] || continue
    grep -q '^gtk-cursor-theme-name' "$f" \
      && sed -i "s/^gtk-cursor-theme-name=.*/gtk-cursor-theme-name=$theme/" "$f" \
      || echo "gtk-cursor-theme-name=$theme" >> "$f"
    grep -q '^gtk-cursor-theme-size' "$f" \
      && sed -i "s/^gtk-cursor-theme-size=.*/gtk-cursor-theme-size=$size/" "$f" \
      || echo "gtk-cursor-theme-size=$size" >> "$f"
done
mkdir -p ~/.icons/default
cat > ~/.icons/default/index.theme <<EOF
[Icon Theme]
Inherits=$theme
EOF

# XSETTINGS daemon broadcast: gives running GTK apps the new cursor theme/size
# live (xsettingsd re-reads ~/.xsettingsd on restart). Without a settings daemon,
# GTK apps cache the cursor at launch and only refresh on re-entry.
cat > ~/.xsettingsd <<EOF
Net/ThemeName "$theme"
Gtk/CursorThemeName "$theme"
Gtk/CursorThemeSize $size
EOF
pkill -x xsettingsd 2>/dev/null
setsid xsettingsd >/dev/null 2>&1 </dev/null & disown

# Persist for boot + apply live to the Hyprland compositor cursor (setcursor swaps
# theme+size live; reload re-reads lua). Both folded here so ONE call does everything.
HYPR_LUA="$HOME/.config/hypr/hyprland.lua"
if [ -f "$HYPR_LUA" ]; then
    sed -i "s|^hl.env(\"XCURSOR_THEME\", \".*\")|hl.env(\"XCURSOR_THEME\", \"$theme\")|" "$HYPR_LUA"
    sed -i "s|^hl.env(\"XCURSOR_SIZE\", \".*\")|hl.env(\"XCURSOR_SIZE\", \"$size\")|" "$HYPR_LUA"
    # NOTE: NO `hyprctl reload` here — reload re-reads config and would clobber the
    # live active/inactive border accent set by the shell. setcursor swaps live itself.
    hyprctl setcursor "$theme" "$size" >/dev/null 2>&1
fi

# Persist for the SDDM greeter (cursor would otherwise fall back to default black).
SDDM_CONF="/etc/sddm.conf.d/axora.conf"
if [ -w "$SDDM_CONF" ] || sudo -n true 2>/dev/null; then
    SUDO=""; [ -w "$SDDM_CONF" ] || SUDO="sudo"
    # ensure [Theme] section exists
    grep -q '^\[Theme\]' "$SDDM_CONF" 2>/dev/null || { $SUDO sh -c "printf '\n[Theme]\n' >> '$SDDM_CONF'"; }
    # drop CursorTheme/CursorSize if absent, then rewrite both within [Theme]
    $SUDO grep -q '^CursorTheme=' "$SDDM_CONF" || $SUDO sh -c "sed -i '/^\[Theme\]/a CursorTheme=$theme' '$SDDM_CONF'"
    $SUDO grep -q '^CursorSize=' "$SDDM_CONF" || $SUDO sh -c "sed -i '/^\[Theme\]/a CursorSize=$size' '$SDDM_CONF'"
    $SUDO sed -i "/^\[Theme\]/,/^$/{s|^CursorTheme=.*|CursorTheme=$theme|;s|^CursorSize=.*|CursorSize=$size|}" "$SDDM_CONF"
fi
