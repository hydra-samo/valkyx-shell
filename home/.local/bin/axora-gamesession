#!/usr/bin/env bash
# axora-gamesession - suspend background services for the duration of a game.
#
# Wired to Lutris's per-game `prelaunch_command`. Lutris starts this when the
# game launches and terminates it when the game exits.
#
# Robustness: a clean signal (TERM/INT/HUP) restores immediately. A hard kill
# (SIGKILL) or power loss cannot run any trap, so a marker file is written on
# suspend and a login-time service restores from it. See:
#   ~/.config/systemd/user/axora-gamesession-recover.service
set -uo pipefail

CONF="${AXORA_GAMESESSION_CONF:-$HOME/.config/axora/gamesession.conf}"
RUNDIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
MARKER="$RUNDIR/axora-gamesession.suspended"
RESTORED=0

log() { printf 'gamesession: %s\n' "$*" >&2; }

# Restore from the marker file. Safe to call repeatedly - the marker is the
# single source of truth and is removed only after a successful restore.
restore_from_marker() {
    [ -f "$MARKER" ] || return 0
    local unit ok=1
    while IFS= read -r unit; do
        [ -z "$unit" ] && continue
        systemctl --user start "$unit" 2>/dev/null || { ok=0; log "WARN could not restart $unit"; }
    done < "$MARKER"
    if [ "$ok" = "1" ]; then
        rm -f "$MARKER"
        log "restored services from marker"
    else
        log "some services failed; leaving marker for next login"
    fi
}

# Also runs at login so a power loss mid-game cannot leave services suspended.
restore_from_marker

read_conf() {
    [ -f "$CONF" ] || return 0
    local line unit
    while IFS= read -r line; do
        line="${line%%#*}"
        line="$(printf '%s' "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
        [ -z "$line" ] && continue
        unit="${line%%[[:space:]]*}"
        printf '%s\n' "$unit"
    done < "$CONF"
}

trap 'restore_from_marker; exit 0' TERM INT HUP
trap 'restore_from_marker' EXIT

# Record what we are about to suspend BEFORE suspending it, so the marker is
# on disk even if this process dies in the next millisecond.
: > "$MARKER"
while IFS= read -r unit; do
    [ -z "$unit" ] && continue
    if [ "$(systemctl --user is-active "$unit" 2>/dev/null)" = "active" ]; then
        echo "$unit" >> "$MARKER"
    fi
done < <(read_conf)

if [ ! -s "$MARKER" ]; then
    log "nothing running to suspend"
    rm -f "$MARKER"
    exit 0
fi

while IFS= read -r unit; do
    systemctl --user stop "$unit" 2>/dev/null && log "suspended $unit"
done < "$MARKER"

log "holding; awaiting game exit"

# Idle as a child so the TERM trap fires immediately rather than waiting.
while :; do
    sleep 5 & wait $!
done