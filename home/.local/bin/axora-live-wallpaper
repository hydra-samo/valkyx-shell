#!/usr/bin/env python3
"""axora-live-wallpaper — download mp4 live wallpapers from moewalls.com.

Usage:
    axora-live-wallpaper <query> [count]     # e.g. axora-live-wallpaper spiderman 2
    axora-live-wallpaper --url <detail-url>  # one specific wallpaper page

Saves into ~/Pictures/Wallpapers/video/ (picked up by the shell's wallpaper
scan). Re-runnable: existing files are skipped.

Why a script: moewalls hides the real file behind an obfuscated data-url that
resolves to https://go.moewalls.com/download.php?video=<data-url>, and their JS
gateway opens popups/redirects. We skip the JS and hit the endpoint directly.
"""
import os
import re
import sys
import urllib.request
import urllib.parse

UA = ("Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
      "(KHTML, like Gecko) Chrome/130.0 Safari/537.36")
DEST = os.path.expanduser("~/Pictures/Wallpapers/video")
BASE = "https://moewalls.com"
DL = "https://go.moewalls.com/download.php?video="

DETAIL_RE = re.compile(r'href="(https://moewalls\.com/[a-z-]+/[a-z0-9-]+-live-wallpaper/)"')
DATAURL_RE = re.compile(r'id\s*=\s*"moe-download"[^>]*data-url\s*=\s*"([^"]+)"')


def get(url, timeout=30):
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    return urllib.request.urlopen(req, timeout=timeout)


def search(query):
    """Return detail-page URLs for a search query, in site order."""
    html = get(BASE + "/?s=" + urllib.parse.quote(query)).read().decode("utf-8", "replace")
    seen, out = set(), []
    for u in DETAIL_RE.findall(html):
        if u not in seen:
            seen.add(u)
            out.append(u)
    return out


def resolve(detail_url):
    """Detail page -> (download_url, suggested_filename)."""
    html = get(detail_url).read().decode("utf-8", "replace")
    m = DATAURL_RE.search(html)
    if not m:
        raise RuntimeError("no data-url on " + detail_url)
    slug = detail_url.rstrip("/").split("/")[-1]
    return DL + m.group(1), slug + ".mp4"


def download(detail_url):
    url, fallback = resolve(detail_url)
    dest = os.path.join(DEST, fallback)
    if os.path.exists(dest) and os.path.getsize(dest) > 0:
        print("skip (exists):", os.path.basename(dest))
        return dest
    os.makedirs(DEST, exist_ok=True)
    part = dest + ".part"
    with get(url, timeout=120) as r:
        # server sends the canonical name; trust it over the slug
        cd = r.headers.get("Content-Disposition", "")
        mm = re.search(r'filename="([^"]+)"', cd)
        if mm:
            dest = os.path.join(DEST, re.sub(r'[^A-Za-z0-9._-]', '-', mm.group(1)))
            part = dest + ".part"
        total = int(r.headers.get("Content-Length") or 0)
        got = 0
        with open(part, "wb") as f:
            while True:
                chunk = r.read(1 << 16)
                if not chunk:
                    break
                f.write(chunk)
                got += len(chunk)
    # a truncated transfer must never land as a wallpaper (that broke mpv)
    if total and got < total:
        os.remove(part)
        raise RuntimeError("truncated %d/%d bytes" % (got, total))
    os.replace(part, dest)
    print("saved: %s (%.1f MB)" % (os.path.basename(dest), got / 1e6))
    return dest


def main():
    args = [a for a in sys.argv[1:]]
    if not args:
        print(__doc__)
        return 2
    if args[0] == "--url":
        for u in args[1:]:
            download(u)
        return 0
    count = int(args[1]) if len(args) > 1 else 1
    targets = search(" ".join(args[:1]))
    if not targets:
        print("no results for", args[0])
        return 1
    for u in targets[:count]:
        download(u)
    return 0


if __name__ == "__main__":
    sys.exit(main())
