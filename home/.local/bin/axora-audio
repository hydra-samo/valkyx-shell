#!/bin/bash
# axora-audio - list audio I/O devices and set defaults.
# Outputs JSON. Sink IDs are PipeWire node IDs; source select by name.
# Handles the Speaker/Headphones exclusive-profile quirk (sof-hda).
CARD="alsa_card.pci-0000_00_1f.3-platform-skl_hda_dsp_generic"

list() {
  python3 - << 'PY'
import json, subprocess, re, os, sys, shutil
def sh(*a):
    try: return subprocess.run(a, capture_output=True, text=True).stdout
    except Exception: return ""
card = __import__('os').environ.get('CARD', 'alsa_card.pci-0000_00_1f.3-platform-skl_hda_dsp_generic')

# current profile from pactl
prof = ""
out = sh("pactl","list","cards")
for line in out.splitlines():
    if "Active Profile:" in line: prof = line.split(":",1)[1].strip()

# sinks: pactl list sinks short -> Name
sinks=[]
for line in sh("pactl","list","sinks","short").splitlines():
    parts=line.strip().split("\t")
    if len(parts)>=2: sinks.append(parts[1])
# sources
sources=[]
for line in sh("pactl","list","sources","short").splitlines():
    parts=line.strip().split("\t")
    if len(parts)>=2 and "monitor" not in parts[1]: sources.append(parts[1])

def defby(kind):
    # default sink/source via pactl
    got=sh("pactl","get-default-"+("source" if kind=="source" else "sink")).strip()
    return got

ds=defby("sink"); dso=defby("source")

def label(n):
    n=n.replace("alsa_output.pci-0000_00_1f.3-platform-skl_hda_dsp_generic.HiFi__","")
    n=n.replace("alsa_input.pci-0000_00_1f.3-platform-skl_hda_dsp_generic.HiFi__","")
    n=n.replace("alsa_output.usb-Sony_Interactive_Entertainment_Wireless_Controller-00.analog-stereo","DS4 Controller")
    n=n.replace("alsa_input.usb-Sony_Interactive_Entertainment_Wireless_Controller-00.analog-stereo","DS4 Controller")
    n=n.replace("alsa_output.usb-","USB ").replace("alsa_input.usb-","USB ")
    n=n.replace("__sink","").replace("__source","")
    return n.replace("_"," ")

# drop nodes whose active port reports "not available" (phantom HDMI ports,
# unplugged headset jack mic). Parse sink AND source blocks.
unavail = set()
def unavail_from(detail, prefix, portglobs):
    block = {}
    out = set()
    for line in detail.splitlines():
        if line.startswith(prefix):
            if block and block.get("Name"):
                ports = block.get("Ports", "")
                act = block.get("Active", "")
                if act and any(ln.strip().startswith(act.strip()) and "not available" in ln for ln in ports.splitlines()):
                    out.add(block["Name"])
            block = {}
        elif line.startswith("\tName:"):
            block["Name"] = line.split(":",1)[1].strip()
        elif line.startswith("\tActive Port:"):
            block["Active"] = line.split(":",1)[1].strip()
        elif line.lstrip().startswith(portglobs):
            block["Ports"] = block.get("Ports","") + line + "\n"
    if block and block.get("Name"):
        ports = block.get("Ports","")
        act = block.get("Active","")
        if act and any(ln.strip().startswith(act.strip()) and "not available" in ln for ln in ports.splitlines()):
            out.add(block["Name"])
    return out

unavail |= unavail_from(sh("pactl","list","sinks"), "Sink ", ("[Out]","analog-output"))
unavail |= unavail_from(sh("pactl","list","sources"), "Source ", ("[In]","analog-input"))

out_sinks=[{"id":s,"name":s,"label":label(s),"default": s==ds} for s in sinks if s not in unavail]
out_sources=[{"id":s,"name":s,"label":label(s),"default": s==dso} for s in sources if s not in unavail]

# sof-hda exclusive-slot quirk: the ANALOG path is Speaker XOR Headphones,
# decided by the ACTIVE PROFILE (not by which sinks happen to linger in pactl —
# a half-failed profile switch leaves stale nodes that would fool existence checks).
# Ground truth = profile string. Expose exactly the profile's analog slab and the
# NEED_ switch that activates the other one.
if "Speaker" in prof:
    # Speaker profile → Headphones is NOT a real slot here; offer the switch.
    out_sinks = [s for s in out_sinks if "Headphones__sink" not in s["name"]]
    if not any("Speaker__sink" in s["name"] for s in out_sinks):
        out_sinks.insert(0, {"id":"NEED_Speaker","name":"Speaker (switch profile)","label":"Speaker","default":False})
    out_sinks.insert(0, {"id":"NEED_Headphones","name":"Headphones (switch profile)","label":"Headphones","default":False})
else:
    # Headphones profile → Speaker is NOT a real slot here; offer the switch.
    out_sinks = [s for s in out_sinks if "Speaker__sink" not in s["name"]]
    if not any("Headphones__sink" in s["name"] for s in out_sinks):
        out_sinks.insert(0, {"id":"NEED_Headphones","name":"Headphones (switch profile)","label":"Headphones","default":False})
    out_sinks.insert(0, {"id":"NEED_Speaker","name":"Speaker (switch profile)","label":"Speaker","default":False})

print(json.dumps({"profile":prof,"sinks":out_sinks,"sources":out_sources,
                  "defaultSink":ds,"defaultSource":dso}))
PY
}

set_sink() {
  local want="$1"
  if [ "$want" = "NEED_Speaker" ] || [ "$want" = "NEED_Headphones" ]; then
    local prof='HiFi (HDMI1, HDMI2, HDMI3, Mic1, Mic2, Speaker)'
    local nodepat='Speaker__sink'
    [ "$want" = "NEED_Headphones" ] && prof='HiFi (HDMI1, HDMI2, HDMI3, Headphones, Mic1, Mic2)' && nodepat='Headphones__sink'
    # the ALC236 profile switch is known-flaky (spa.alsa "Connection timed out");
    # retry until the target slot actually appears (or give up after 8 tries).
    local i=0
    while [ $i -lt 8 ]; do
      pactl set-card-profile "$CARD" "$prof"
      local cur
      cur=$(pactl list sinks short | grep "$nodepat" | head -1 | cut -f2)
      if [ -n "$cur" ]; then want=$cur; break; fi
      sleep 0.6
      i=$((i+1))
    done
  fi
  if [ -n "$want" ]; then
    # set by NAME not id — ids churn across restarts and WirePlumber restores
    # the default by name; id-based sets get overridden on the next rescan.
    case "$want" in
      *__sink) want=$(pactl list sinks short | grep "$want" | head -1 | cut -f2) ;;
    esac
    pactl set-default-sink "$want"
  fi
}

set_source() {
  [ -n "$1" ] && pactl set-default-source "$1"
}

case "${1:-list}" in
  list) list ;;
  set-sink) set_sink "$2" ;;
  set-source) set_source "$2" ;;
esac