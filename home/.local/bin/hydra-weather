#!/usr/bin/env python3
"""valkyx-weather — fetch wttr.in, cache JSON. Prints key=value lines:
   temp, feels, desc, code, hum, wind
   Falls back to cache on network failure."""
import json, os, sys, urllib.request, urllib.error

CACHE = os.path.expanduser("~/.cache/valkyx-weather.json")
LOC = os.path.expanduser("~/.config/valkyx/weather-location")
URL = "https://wttr.in/?format=j1"

def fetch():
    loc = ""
    if os.path.exists(LOC):
        loc = open(LOC).read().strip()
    url = URL if not loc else f"https://wttr.in/{loc}?format=j1"
    req = urllib.request.Request(url, headers={"User-Agent": "curl/8.0"})
    with urllib.request.urlopen(req, timeout=12) as r:
        data = json.loads(r.read().decode())
    open(CACHE, "w").write(json.dumps(data))
    return data

def out(data):
    c = data["current_condition"][0]
    desc = c.get("weatherDesc", [{}])[0].get("value", "")
    print(f'temp={c.get("temp_C", "?")}')
    print(f'feels={c.get("FeelsLikeC", "?")}')
    print(f'desc={desc}')
    print(f'code={c.get("weatherCode", 113)}')
    print(f'hum={c.get("humidity", "?")}')
    print(f'wind={c.get("windspeedKmph", "?")}')

if __name__ == "__main__":
    try:
        out(fetch())
    except Exception as e:
        # stale cache better than nothing
        try:
            out(json.load(open(CACHE)))
        except Exception:
            print("temp=?")
            print("feels=?")
            print("desc=offline")
            print("code=0")
            print("hum=?")
            print("wind=?")