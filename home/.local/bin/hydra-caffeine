#!/usr/bin/env bash
# Hydra caffeine timed override. "on" = disable idle now; "<minutes>" = disable
# idle then auto-restore; "off" = restore hypridle now.
set -u
MIN="${1:-on}"
CACHE="$HOME/.cache/hydra-caffeine.min"

case "$MIN" in
  off|0)
    { pgrep -x hypridle >/dev/null || setsid hypridle >/dev/null 2>&1 </dev/null & }; echo "0" > "$CACHE"
    ;;
  on)
    pkill -x hypridle 2>/dev/null; echo "-1" > "$CACHE"
    ;;
  *)
    if [[ "$MIN" =~ ^[0-9]+$ ]] && [ "$MIN" -gt 0 ]; then
      pkill -x hypridle 2>/dev/null; echo "$MIN" > "$CACHE"
      setsid sh -c "sleep ${MIN}m; pgrep -x hypridle >/dev/null || setsid hypridle >/dev/null 2>&1 </dev/null & echo 0 > '$CACHE'" >/dev/null 2>&1 </dev/null &
    else
      pkill -x hypridle 2>/dev/null; echo "-1" > "$CACHE"
    fi
    ;;
esac
echo "caffeine=$MIN"