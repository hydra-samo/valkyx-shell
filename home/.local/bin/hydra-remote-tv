#!/usr/bin/env python3
import evdev, json, os, select, subprocess, time

TARGET = 'xing wei'
LOG = '/tmp/valkyx-remote-tv.log'
LETTERS = tuple(getattr(evdev.ecodes, 'KEY_%s' % c, None) for c in 'ABCDEFGHIJKLMNOPQRSTUVWXYZ')

KEYS = {
    evdev.ecodes.KEY_POWER: 'toggle',
    evdev.ecodes.KEY_SLEEP: 'toggle',
    evdev.ecodes.KEY_BACK: 4,
    evdev.ecodes.KEY_HOMEPAGE: 3,
    evdev.ecodes.KEY_MENU: 82,
    evdev.ecodes.KEY_UP: 19,
    evdev.ecodes.KEY_DOWN: 20,
    evdev.ecodes.KEY_LEFT: 21,
    evdev.ecodes.KEY_RIGHT: 22,
    evdev.ecodes.KEY_ENTER: 23,
    evdev.ecodes.KEY_VOLUMEUP: 24,
    evdev.ecodes.KEY_VOLUMEDOWN: 25,
    evdev.ecodes.KEY_MUTE: 164,
    evdev.ecodes.KEY_PLAYPAUSE: 85,
    evdev.ecodes.KEY_PLAY: 126,
    evdev.ecodes.KEY_PAUSE: 127,
    evdev.ecodes.KEY_NEXTSONG: 87,
    evdev.ecodes.KEY_PREVIOUSSONG: 88,
    evdev.ecodes.KEY_STOP: 86,
}

def session_env():
    env = dict(os.environ)
    if not env.get('WAYLAND_DISPLAY'):
        rt = env.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}')
        try:
            socks = [s for s in os.listdir(rt) if s.startswith('wayland-')]
            socks.sort(key=lambda s: os.path.getmtime(f'{rt}/{s}'), reverse=True)
            # prefer the real compositor socket (wayland-1/wayland-0) over
            # daemon-injected ones (awww wallpaper writes wayland-1-awww-daemon.sock)
            main = next((s for s in socks if s in ('wayland-1', 'wayland-0')), None)
            env['WAYLAND_DISPLAY'] = main or (socks[0] if socks else None)
        except OSError:
            pass
    if not env.get('DISPLAY'):
        try:
            xs = sorted(os.listdir('/tmp/.X11-unix'), key=lambda f: os.path.getmtime(f'/tmp/.X11-unix/{f}'), reverse=True)
            if xs:
                env['DISPLAY'] = ':' + xs[0][1:]
        except OSError:
            pass
    return env

def log(msg):
    with open(LOG, 'a') as f:
        f.write('%s %s\n' % (time.strftime('%H:%M:%S'), msg))

def tv_on():
    # the TV is "on" only when its window is actually mapped and present in the
    # compositor. A show-full-ui process alone can be a ghost (crashed mid-boot,
    # dead socket) that counts as "on" and makes power kill instead of revive.
    try:
        # systemd --user services lack HYPRLAND_INSTANCE_SIGNATURE; hyprctl fails
        # without it -> detect the live instance from the runtime dir (newest).
        rt = os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}')
        sig = sorted(os.listdir(rt + '/hypr') if os.path.isdir(rt + '/hypr') else [],
                     key=lambda d: os.path.getmtime(f'{rt}/hypr/{d}'), reverse=True)
        env = dict(os.environ)
        if sig:
            env['HYPRLAND_INSTANCE_SIGNATURE'] = sig[0]
        out = subprocess.run(['hyprctl', 'clients', '-j'], env=env,
                             capture_output=True, timeout=5).stdout
        for c in (json.loads(out) or []):
            if c.get('class') == 'Waydroid' and c.get('mapped'):
                return True
    except Exception:
        pass  # hyprctl down means no confirmed window -> treat as off (revive)
    return False

def container_on():
    try:
        return subprocess.run(['systemctl', 'is-active', 'waydroid-container'],
                              capture_output=True, timeout=5).stdout.strip() == b'active'
    except Exception:
        return False

def key(code):
    subprocess.Popen(['sudo', '-n', 'waydroid', 'shell', 'input', 'keyevent', str(code)],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def focus_ws(ws):
    # Return to the studio workspace when turning the TV OFF (so the teardown
    # black frame isn't left on whatever workspace the guest was fullscreen on).
    # Waydroid itself opens on the ACTIVE workspace (60-rules.lua), so turning
    # ON focuses nothing extra. Needs the live instance signature (systemd
    # --user services don't inherit it).
    try:
        rt = os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}')
        sig = sorted(os.listdir(rt + '/hypr') if os.path.isdir(rt + '/hypr') else [],
                     key=lambda d: os.path.getmtime(f'{rt}/hypr/{d}'), reverse=True)
        env = dict(os.environ)
        if sig:
            env['HYPRLAND_INSTANCE_SIGNATURE'] = sig[0]
        subprocess.run(['hyprctl', 'eval', 'hl.dispatch(hl.dsp.focus({ workspace = "name:%s" }))' % ws],
                       env=env, capture_output=True, timeout=5)
    except Exception:
        pass

_last_toggle = 0.0

def toggle_tv():
    # The wanted file is the single source of truth for user intent; the toggle
    # FLIPS it, never reacts to the live window (a window that briefly reads
    # unmapped mid-switch made an OFF press re-fire the ON branch = the TV kept
    # "turning itself back on"). tmpfs path -> a reboot always starts OFF.
    global _last_toggle
    now = time.monotonic()
    if now - _last_toggle < 3.0:
        return
    _last_toggle = now
    wanted = '%s/valkyx-waydroid-wanted' % os.environ.get(
        'XDG_RUNTIME_DIR', '/run/user/%d' % os.getuid())
    if os.path.exists(wanted):
        focus_ws('01 studio')  # leave the guest's fullscreen workspace before tearing down
        subprocess.Popen(['sudo', '-n', 'waydroid', 'session', 'stop'],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        try:
            os.remove(wanted)
        except FileNotFoundError:
            pass
        log('TV OFF')
    else:
        # the keeper only heals while this file exists — mark intent first so
        # its watcher doesn't tear down/ignore the session we're about to start
        with open(wanted, 'w') as f:
            f.write('1')
        # a ghosted session (show-full-ui proc alive but window unmapped) blocks a
        # fresh start with "Already tracking a session" — clear it before reviving
        if subprocess.run(['pgrep', '-f', 'waydroid show-full-u[i]'],
                          capture_output=True).returncode == 0:
            subprocess.Popen(['sudo', '-n', 'waydroid', 'session', 'stop'],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            log('TV RESET')
        subprocess.Popen(['setsid', 'waydroid', 'show-full-ui'], env=session_env(),
                         stdout=open('/dev/null', 'w'), stderr=subprocess.STDOUT)
        # Waydroid fullscreens on the active workspace — no workspace jump needed.
        log('TV ON')
        # session restart wipes the default routes from netd's legacy_* tables;
        # re-apply once the guest has booted (background, fire-and-forget)
        subprocess.Popen(['setsid', '/usr/local/bin/valkyx-waydroid-netfix'],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def remotes(existing=None):
    existing = existing or {}
    found = {}
    for p in evdev.list_devices():
        try:
            d = evdev.InputDevice(p)
        except OSError:
            continue
        if TARGET in d.name.lower():
            keys = d.capabilities(absinfo=False).get(evdev.ecodes.EV_KEY, [])
            has_power = evdev.ecodes.KEY_POWER in keys or evdev.ecodes.KEY_SLEEP in keys
            is_keyboard = any(k in LETTERS for k in keys)
            if has_power and not is_keyboard:
                if p in existing:
                    try:
                        d.ungrab()
                    except OSError:
                        pass
                    d.close()
                    found[p] = existing[p]
                else:
                    try:
                        d.grab()
                    except OSError:
                        pass
                    found[p] = d
                continue
            d.close()
    return found

def main():
    devs = remotes()
    while True:
        if not devs:
            time.sleep(1.5)
            devs = remotes()
            continue
        try:
            r, _, _ = select.select(list(devs.values()), [], [], 5.0)
        except OSError:
            devs = remotes(devs)
            continue
        for dev in r:
            try:
                for e in dev.read():
                    if e.type != evdev.ecodes.EV_KEY or e.value != 1:
                        continue
                    target = KEYS.get(e.code)
                    if target is None:
                        continue
                    if (target == 'toggle'):
                        # drain any queued power repeats so one physical press = one toggle
                        while True:
                            try:
                                if not any(dev.read()):
                                    break
                            except (BlockingIOError, OSError):
                                break
                        toggle_tv()
                        break  # outer read() generator now stale; stop iterating it
                    elif container_on():
                        key(target)
            except OSError:
                dev.close()
                del devs[dev.path]
        devs = remotes(devs)

if __name__ == '__main__':
    main()