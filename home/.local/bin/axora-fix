#!/usr/bin/env python3
"""axora-fix — Autonomous system + codebase fixer.
Reads last-report.json from axora-diagnose, applies fixes using
fix-patterns.json knowledge base, learns from results.
Usage: axora-fix [--dry-run|--undo|--status]
"""
import json, os, sys, subprocess, shutil, time
from pathlib import Path
from datetime import datetime

STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state")) / "axora-diagnose"
REPORT_PATH = STATE_DIR / "last-report.json"
PATTERNS_PATH = STATE_DIR / "fix-patterns.json"
LOG_PATH = STATE_DIR / "fix-log.json"
BACKUP_DIR = STATE_DIR / "backups"

DRY_RUN = "--dry-run" in sys.argv
UNDO = "--undo" in sys.argv
STATUS = "--status" in sys.argv

# ── Helpers ──
def run(cmd, timeout=15, sudo=False):
    """Run command, return (stdout, returncode). Never hangs."""
    prefix = "sudo -n " if sudo else ""
    try:
        r = subprocess.run(
            f"{prefix}{cmd}", shell=True,
            capture_output=True, text=True, timeout=timeout
        )
        return r.stdout.strip(), r.returncode
    except subprocess.TimeoutExpired:
        return "TIMEOUT", 1
    except Exception as e:
        return str(e), 1


def can_sudo():
    """Check if passwordless sudo is available."""
    out, rc = run("true", sudo=True)
    return rc == 0


# ── Fix functions ──
# Each returns (success: bool, message: str)

def fix_service_failed(unit):
    out, rc = run(f"systemctl restart {unit}")
    if rc != 0:
        return False, f"restart failed: {out}"
    time.sleep(1)
    active, rc2 = run(f"systemctl is-active {unit}")
    return active == "active", f"status={active}"


def fix_user_service_failed(unit):
    out, rc = run(f"systemctl --user restart {unit}")
    if rc != 0:
        return False, f"restart failed: {out}"
    time.sleep(1)
    active, rc2 = run(f"systemctl --user is-active {unit}")
    return active == "active", f"status={active}"


def fix_journal_vacuum(_):
    out, rc = run("journalctl --vacuum-size=200M", sudo=True, timeout=30)
    return True, "vacuumed"


def fix_package_orphans(_):
    orphans, rc = run("pacman -Qtdq")
    if rc != 0 or not orphans:
        return True, "no orphans"
    count = len(orphans.split("\n"))
    out, rc2 = run(f"pacman -Rns --noconfirm {orphans}", sudo=True, timeout=60)
    return rc2 == 0, f"removed {count} packages"


def fix_world_readable_secrets(_):
    # Quick targeted fix — only ~/.config/opencode and ~/.ssh and ~/.local/share
    dirs_to_check = [
        Path.home() / ".config" / "opencode",
        Path.home() / ".ssh",
        Path.home() / ".local" / "share",
        Path.home() / "Projects AXORA",
    ]
    fixed = 0
    for d in dirs_to_check:
        if not d.exists():
            continue
        out, _ = run(
            f'find "{d}" -maxdepth 4 -type f '
            f'\\( -name "*.key" -o -name "*.pem" -o -name "*.env" -o -name "auth.json" \\) '
            f'-perm -o+r 2>/dev/null | head -20'
        )
        for f in out.strip().split("\n"):
            f = f.strip()
            if f:
                run(f'chmod 600 "{f}"')
                fixed += 1
    return True, f"fixed {fixed} files"


def fix_stale_dist(_):
    dist = Path("dist")
    if dist.exists():
        shutil.rmtree(dist)
        return True, "removed dist/"
    return True, "no dist/ found"


def fix_stuck_session_lock(_):
    """A SIGTERMed hyprlock exits without releasing ext_session_lock, so the
    session stays locked: every key and click goes nowhere and hyprctl stops
    answering, while the compositor keeps painting. That reads exactly like a
    crash, but restarting the compositor would log the user out and fix
    nothing. SIGKILL is the only thing that releases it."""
    r, rc = run("pgrep -x hyprlock", timeout=5)
    if rc != 0 or not r.strip():
        return False, "no hyprlock running — cannot clear a stuck lock"
    _, rc = run("pkill -9 -x hyprlock", timeout=5)
    if rc != 0:
        return False, "pkill -9 -x hyprlock failed"
    time.sleep(0.5)
    return True, "SIGKILLed the stale hyprlock, session lock released"


def fix_sddm_restart(_):
    if not can_sudo():
        return False, "sudo not available"
    out, rc = run("systemctl restart sddm", sudo=True, timeout=10)
    if rc != 0:
        return False, f"restart failed: {out}"
    time.sleep(2)
    active, _ = run("systemctl is-active sddm")
    return active == "active", f"status={active}"


def fix_oom_logging(_):
    top, _ = run("ps aux --sort=-%mem | head -10")
    log_file = STATE_DIR / "memory-snapshot.log"
    with open(log_file, "a") as f:
        f.write(f"\n=== Memory snapshot {datetime.now().isoformat()} ===\n")
        f.write(top + "\n")
    return True, f"logged to {log_file}"


def fix_disk_cleanup(_):
    cmds = [
        ("paccache -rk1", True, 30),
        ("journalctl --vacuum-size=200M", True, 30),
    ]
    for cmd, sudo, timeout in cmds:
        run(cmd, sudo=sudo, timeout=timeout)
    usage, _ = run("df -h / | tail -1 | awk '{print $5}'")
    return True, f"cleaned, current usage={usage}"


# ── Pattern registry ──
# signature_prefix → { tier, fix_fn, description }
PATTERNS = {
    "service_failed": {
        "tier": "auto",
        "fix_fn": fix_service_failed,
        "description": "Restart crashed system service",
        "extract": lambda s: s.split(":", 1)[1],
    },
    "user_service_failed": {
        "tier": "auto",
        "fix_fn": fix_user_service_failed,
        "description": "Restart crashed user service",
        "extract": lambda s: s.split(":", 1)[1],
    },
    "journal_large": {
        "tier": "auto",
        "fix_fn": fix_journal_vacuum,
        "description": "Vacuum large journal",
        "extract": lambda s: s.split(":", 1)[1],
    },
    "package_orphans": {
        "tier": "semi",
        "fix_fn": fix_package_orphans,
        "description": "Remove orphaned packages",
        "extract": lambda s: s.split(":", 1)[1],
    },
    "world_readable_secrets": {
        "tier": "semi",
        "fix_fn": fix_world_readable_secrets,
        "description": "Fix world-readable sensitive file permissions",
        "extract": lambda s: "",
    },
    "stale_dist": {
        "tier": "auto",
        "fix_fn": fix_stale_dist,
        "description": "Remove stale dist/ build artifact",
        "extract": lambda s: "",
    },
    "session_lock_stuck": {
        "tier": "auto",
        "fix_fn": fix_stuck_session_lock,
        "description": "Release a session lock stranded by a terminated hyprlock",
        "extract": lambda s: "",
    },
    "sddm_errors": {
        "tier": "manual",  # NEVER auto-restart — kills user session
        "fix_fn": None,
        "description": "SDDM errors — report only, manual restart needed",
        "extract": lambda s: "",
    },
    "oom_kills": {
        "tier": "semi",
        "fix_fn": fix_oom_logging,
        "description": "Log memory usage for OOM analysis",
        "extract": lambda s: s.split(":", 1)[1],
    },
    "disk_usage_high": {
        "tier": "semi",
        "fix_fn": fix_disk_cleanup,
        "description": "Clean disk usage",
        "extract": lambda s: s.split(":", 1)[1],
    },
}

# Manual-only patterns (never auto-fix)
MANUAL_ONLY = {"nvidia_errors", "hypr_config_errors", "quickshell_errors",
               "ts_errors", "open_ports", "kernel_panic", "disk_io_errors",
               "sddm_errors"}


def load_report():
    if not REPORT_PATH.exists():
        print("❌ No report. Run: axora-diagnose --system")
        sys.exit(1)
    with open(REPORT_PATH) as f:
        return json.load(f)


def load_learned():
    if PATTERNS_PATH.exists():
        try:
            with open(PATTERNS_PATH) as f:
                return json.load(f)
        except (json.JSONDecodeError, KeyError):
            pass
    return {}


def save_learned(data):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with open(PATTERNS_PATH, "w") as f:
        json.dump(data, f, indent=2)


def load_fix_log():
    if LOG_PATH.exists():
        try:
            with open(LOG_PATH) as f:
                return json.load(f)
        except (json.JSONDecodeError, KeyError):
            pass
    return {"runs": []}


def save_fix_log(log):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with open(LOG_PATH, "w") as f:
        json.dump(log, f, indent=2)


def match_pattern(signature):
    """Match a signature to a fix pattern. Returns (key, pattern) or (None, None)."""
    for prefix, pat in PATTERNS.items():
        if signature.startswith(prefix):
            return prefix, pat
    return None, None


def undo_last():
    log = load_fix_log()
    if not log.get("runs"):
        print("❌ No fix runs to undo.")
        return
    last = log["runs"][-1]
    print(f"↩️  Undoing run from {last['timestamp']}...")
    for fix in last.get("applied", []):
        if fix.get("backup") and Path(fix["backup"]).exists():
            shutil.copy2(fix["backup"], fix["path"])
            print(f"   Restored: {fix['path']}")
    print("✅ Done.")


def show_status():
    log = load_fix_log()
    learned = load_learned()
    print(f"Fix log: {len(log.get('runs', []))} runs")
    print(f"Learned patterns: {len(learned)}")
    if log.get("runs"):
        last = log["runs"][-1]
        print(f"Last run: {last['timestamp']}")
        print(f"  Applied: {len(last.get('applied', []))}")
        print(f"  Failed:  {len(last.get('failed', []))}")
        print(f"  Manual:  {len(last.get('manual', []))}")


def main():
    if UNDO:
        undo_last()
        return
    if STATUS:
        show_status()
        return

    report = load_report()
    issues = report.get("issues", [])
    summary = report.get("summary", {})

    if not issues:
        print("✅ No issues to fix.")
        return

    print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    print(f"  AXORA FIX — {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    if DRY_RUN:
        print("  (DRY RUN)")
    print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    print(f"  {summary.get('critical',0)} critical · {summary.get('warning',0)} warning · {summary.get('info',0)} info")
    print()

    applied, skipped, failed, manual = [], [], [], []

    for issue in issues:
        sig = issue.get("signature", "")
        sev = issue.get("severity", "info")
        desc = issue.get("summary", "")

        # Check manual-only first
        is_manual = any(sig.startswith(m) for m in MANUAL_ONLY)
        if is_manual:
            manual.append(sig)
            print(f"  📋 MANUAL: {desc}")
            continue

        # Match pattern
        prefix, pat = match_pattern(sig)
        if pat is None:
            skipped.append(sig)
            continue

        # Extract target
        target = pat["extract"](sig)

        if DRY_RUN:
            print(f"  🔧 WOULD FIX: {desc}")
            applied.append({"sig": sig, "dry": True})
            continue

        # Apply
        print(f"  🔧 FIXING: {desc}")
        try:
            ok, msg = pat["fix_fn"](target)
        except Exception as e:
            print(f"     ❌ ERROR: {e}")
            failed.append({"sig": sig, "error": str(e)})
            continue

        if ok:
            print(f"     ✅ {msg}")
            applied.append({"sig": sig, "msg": msg})
            # Learn
            learned = load_learned()
            if sig not in learned:
                learned[sig] = {
                    "first_fixed": datetime.now().isoformat(),
                    "count": 0,
                    "description": pat["description"],
                }
            learned[sig]["count"] = learned[sig].get("count", 0) + 1
            learned[sig]["last_fixed"] = datetime.now().isoformat()
            save_learned(learned)
        else:
            print(f"     ⚠️ {msg}")
            failed.append({"sig": sig, "msg": msg})

    # Save run log
    if not DRY_RUN:
        log = load_fix_log()
        log["runs"].append({
            "timestamp": datetime.now().isoformat(),
            "applied": applied,
            "failed": failed,
            "manual": manual,
            "skipped": skipped,
        })
        log["runs"] = log["runs"][-20:]
        save_fix_log(log)

    # Summary
    print()
    print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    print(f"  ✅ {len(applied)} fixed · ⏭ {len(skipped)} skipped · ❌ {len(failed)} failed · 📋 {len(manual)} manual")
    print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")


if __name__ == "__main__":
    main()
