#!/usr/bin/env python3
import json, os
p = os.path.expanduser("~/.cache/axora-weather.json")
try:
    d = json.load(open(p))
    c = d["current_condition"][0]
    area = d["nearest_area"][0]["areaName"][0]["value"]
    desc = c["weatherDesc"][0]["value"]
    print(f'{area}  {c["temp_C"]}\u00b0C  Feels {c["FeelsLikeC"]}\u00b0  H{c["humidity"]}%  W{c["windspeedKmph"]}  {desc}')
except Exception:
    print("weather offline")
