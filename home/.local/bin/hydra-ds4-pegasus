#!/usr/bin/env python3
import evdev, os, select, subprocess, time
BTN_MODE = 316
HOLD = 0.5
DIV = ('wireless controller', 'dualshock', 'sony interactive')

def session_env():
    env = dict(os.environ)
    if not env.get('WAYLAND_DISPLAY'):
        rt = env.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}')
        try:
            socks = [s for s in os.listdir(rt) if s.startswith('wayland-')]
            if socks:
                env['WAYLAND_DISPLAY'] = max(socks, key=lambda s: os.path.getmtime(f'{rt}/{s}'))
        except OSError:
            pass
    if not env.get('DISPLAY'):
        try:
            xs = sorted(os.listdir('/tmp/.X11-unix'), key=lambda f: os.path.getmtime(f'/tmp/.X11-unix/{f}'), reverse=True)
            if xs:
                env['DISPLAY'] = ':' + xs[0][1:]
        except OSError:
            pass
    return env

def gamepads(existing=None):
    existing = existing or {}
    found = {}
    for p in evdev.list_devices():
        try:
            d = evdev.InputDevice(p)
        except OSError:
            continue
        cap = d.capabilities(absinfo=False).get(evdev.ecodes.EV_KEY, [])
        if BTN_MODE in cap and any(k in d.name.lower() for k in DIV):
            if p in existing:
                d.close()
                found[p] = existing[p]
            else:
                found[p] = d
        else:
            d.close()
    return found

def toggle_pegasus():
    if subprocess.run(['pgrep', '-x', 'pegasus-fe'], capture_output=True).returncode == 0:
        subprocess.run(['pkill', '-9', '-x', 'pegasus-fe'])
        subprocess.Popen(['hydra-gamemode'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) if subprocess.run(['pgrep','-f','gamemoded -r'],capture_output=True).returncode==0 else None
    else:
        subprocess.Popen(['setsid', '-f', 'pegasus-fe'], env=session_env(), stdout=open('/tmp/pegasus.log', 'a'), stderr=subprocess.STDOUT)
        if subprocess.run(['pgrep','-f','gamemoded -r'],capture_output=True).returncode!=0:
            subprocess.Popen(['hydra-gamemode'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def main():
    devs = gamepads()
    pressed_at = None
    while True:
        if not devs:
            time.sleep(1.5)
            devs = gamepads()
            continue
        try:
            r, _, _ = select.select(list(devs.values()), [], [], 5.0)
        except OSError:
            devs = gamepads(devs)
            continue
        for dev in r:
            try:
                for e in dev.read():
                    if e.type == evdev.ecodes.EV_KEY and e.code == BTN_MODE:
                        if e.value == 1:
                            pressed_at = time.time()
                        elif e.value == 0 and pressed_at and time.time() - pressed_at >= HOLD:
                            pressed_at = None
                            toggle_pegasus()
                        elif e.value == 0:
                            pressed_at = None
            except OSError:
                dev.close()
                del devs[dev.path]
        devs = gamepads(devs)

if __name__ == '__main__':
    main()