#!/usr/bin/env bash
# valkyx-lock-supervise — take the session lock and stay alive as its supervisor.
#
# Must be run as a transient unit's main process, never as a plain background
# job. valkyx-lock returns ~4s after handing off (it watches the session-lock
# grant for a revoke), but hyprlock itself keeps running. If this script is the
# unit's main process and it exits, systemd SIGKILLs everything left in the unit
# cgroup — which killed the lock ~9s in, and a SIGKILLed hyprlock latches
# Hyprland's "a lockscreen crashed" so every later grant gets revoked ("yeeten")
# and the desktop can never be locked again. Hence: stay until the lock is gone.
#
# Used by BOTH the pre-suspend path (so the machine sleeps already-locked and the
# resume has nothing to wait for) and the post-resume path.
set -u

LOG="${XDG_STATE_HOME:-$HOME/.local/state}/valkyx-power.log"
note() { printf '%s %-9s %s\n' "$(date -Iseconds)" "wakelock" "$*" >>"$LOG" 2>/dev/null; }

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/1000}"
# Compositor signature from disk, never from the environment: a systemd unit gets
# no inherited HYPRLAND_INSTANCE_SIGNATURE and hyprlock then cannot connect.
sig=$(ls -1t /run/user/1000/hypr/ 2>/dev/null | head -1)
[ -n "$sig" ] && export HYPRLAND_INSTANCE_SIGNATURE="$sig"
if [ -z "${WAYLAND_DISPLAY:-}" ]; then
    for s in "$XDG_RUNTIME_DIR"/wayland-1 "$XDG_RUNTIME_DIR"/wayland-0; do
        [ -S "$s" ] && { WAYLAND_DISPLAY="$(basename "$s")"; export WAYLAND_DISPLAY; break; }
    done
fi

$HOME/.local/bin/valkyx-lock &

# Report how fast the lock mapped. Callers poll on the same signal, so a normal
# run is ~150ms and this is diagnostic, not a gate.
i=0
while [ "$i" -lt 40 ]; do
    pgrep -x hyprlock >/dev/null 2>&1 && break
    sleep 0.05
    i=$((i + 1))
done
pgrep -x hyprlock >/dev/null 2>&1 && up=yes || up=no
note "lock_up=$up after $((i * 50))ms"

# Let valkyx-lock finish its grant-watch and retry, then supervise until the user
# unlocks. Exiting here is the bug described at the top of this file.
wait
while pgrep -x hyprlock >/dev/null 2>&1; do
    sleep 1
done
note "lock released"
