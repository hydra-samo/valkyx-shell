#!/bin/bash
# VALKYX game mode — full gaming focus
# ON:  gamemoded -r (holds request), blur+animations off, kill desktop bloat
# OFF: kill request, restore blur+animations
# Always keeps: kitty (terminal session), FDM (downloads), SimpMusic, shell

KEEP='kitty|fdm|freedownloadmanager|SimpMusic|quickshell|qs |mako|pipewire|wireplumber|waydroid|ydotoold|awww'
# apps that steal CPU/RAM while gaming
BLOAT='helium-browser|google-chrome|chrome|brave|code-oss|code |thunar|firefox|discord|steam'

if pgrep -f "[g]amemoded -r" >/dev/null; then
    pkill -f "[g]amemoded -r"
    hyprctl eval 'hl.config({ decoration = { blur = { enabled = true } } })'
    hyprctl eval 'hl.config({ animations = { enabled = true } })'
    # syncthing/valkyx-studio left alone
    notify-send "VALKYX" "Game mode OFF" 2>/dev/null || true
    echo "game mode off"
else
    setsid gamemoded -r </dev/null >/dev/null 2>&1 &
    hyprctl eval 'hl.config({ decoration = { blur = { enabled = false } } })'
    hyprctl eval 'hl.config({ animations = { enabled = false } })'
    pkill -f "$BLOAT" 2>/dev/null
    # syncthing/valkyx-studio keep running
    notify-send "VALKYX" "Game mode ON — bloat killed, blur/animations off" 2>/dev/null || true
    echo "game mode on"
fi
