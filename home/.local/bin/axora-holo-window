#!/bin/sh
# axora-holo-window — toggle the assistant as a REAL resizable window.
# Separate `qs -c axora-holo` config (Window root sharing AxoraAssistantUi);
# the panel holo (`qs -c axora`) is untouched. One instance max either way.
export XDG_RUNTIME_DIR=/run/user/1000 WAYLAND_DISPLAY=wayland-1
if [ -z "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
    HYPRLAND_INSTANCE_SIGNATURE=$(ls -1t /run/user/1000/hypr/ | head -1)
    export HYPRLAND_INSTANCE_SIGNATURE
fi
if pgrep -f 'axora-holo/shell.qml' >/dev/null 2>&1 || pgrep -f '^qs -c axora-holo$' >/dev/null 2>&1; then
    pkill -f 'axora-holo/shell.qml'; pkill -f '^qs -c axora-holo$'
else
    # The window boots fullscreen and owns its own mode (chrome toggle);
    # the compositor only floats it — no forced size/center anymore.
    setsid -f sh -c 'qs -c axora-holo > /tmp/qs-holo.log 2>&1 < /dev/null &'
fi
