#!/usr/bin/env bash
#
# hydra-gpu — HYDRA GPU control (Pop!_OS-style hybrid graphics on-demand)
#
#   Intel Iris Xe  = default (desktop, browser, compositor)
#   NVIDIA MX450   = on-demand via PRIME render offload (prime-run)
#
# Works in every power profile (performance / balanced / power-saver).
# The NVIDIA GPU is left on-demand: it wakes only when an app requests it
# via prime-run and can return to a low-power state when idle (PCI runtime PM).
#
# Commands:
#   hydra-gpu status     Show GPU + power state
#   hydra-gpu menu       Rofi menu to launch an app on the discrete GPU
#   hydra-gpu notif      Show GPU state as a desktop notification
#   hydra-gpu profile    Re-apply on-demand GPU policy for current power profile
#   hydra-gpu policy auto|on   Set NVIDIA PCI runtime PM control (needs root)
#   hydra-gpu run <cmd>  Run <cmd> with PRIME offload on the NVIDIA GPU
#   hydra-gpu auto on|off|status
#                           Auto-run demanding apps (blender, godot, obs, ...)
#                           on the NVIDIA GPU; Intel stays default for the rest
#
set -euo pipefail

NV_DEV="0000:01:00.0"
NV_SYS="/sys/bus/pci/devices/${NV_DEV}"
PRIME_ENV=(__NV_PRIME_RENDER_OFFLOAD=1 __VK_LAYER_NV_optimus=NVIDIA_only __GLX_VENDOR_LIBRARY_NAME=nvidia)
APP_ICON="display-driver"

_notify() {
    local title="$1" msg="$2" icon="${3:-$APP_ICON}"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -a "HYDRA GPU" -i "$icon" "$title" "$msg"
    fi
}

_nv_available() {
    command -v nvidia-smi >/dev/null 2>&1
}

_nv_state() {
    if ! _nv_available; then
        echo "not available"
        return
    fi
    nvidia-smi --query-gpu=utilization.gpu,temperature.gpu,power.draw,memory.used,pstate \
        --format=csv,noheader 2>/dev/null || echo "not accessible"
}

_nv_runtime() {
    local s c
    s=$(cat "$NV_SYS/power/runtime_status" 2>/dev/null || echo "n/a")
    c=$(cat "$NV_SYS/power/control" 2>/dev/null || echo "n/a")
    echo "runtime=$s (control=$c)"
}

_effective_profile() {
    case "$(cat /sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference 2>/dev/null || echo n/a)" in
        performance) echo "performance" ;;
        power)       echo "power-saver" ;;
        *)           echo "balanced" ;;
    esac
}

cmd_status() {
    local profile epp nv
    profile=$(_effective_profile)
    epp=$(cat /sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference 2>/dev/null || echo "n/a")
    nv=$(_nv_state)
    printf 'Intel renderer : %s\n' "$(glxinfo -B 2>/dev/null | grep -i 'OpenGL renderer' | head -1 | cut -d: -f2 | xargs)"
    printf 'Power profile  : %s (EPP=%s)\n' "$profile" "$epp"
    printf 'NVIDIA GPU     : %s\n' "$nv"
    printf 'NVIDIA PM      : %s\n' "$(_nv_runtime)"
    echo "On-demand      : prime-run <app>  (or press SUPER+SHIFT+G)"
}

cmd_notif() {
    local profile nv
    profile=$(_effective_profile)
    nv=$(_nv_state)
    _notify "GPU status" "Power profile: $profile
NVIDIA: $nv
$( _nv_runtime )
On-demand: SUPER+SHIFT+G or 'prime-run <app>'"
}

# Rofi menu of apps that benefit from the discrete GPU (Pop!_OS-style).
cmd_menu() {
    local entries=() app cmd
    _add() { local name="$1"; shift; if command -v "$1" >/dev/null 2>&1 || [ -x "$1" ]; then entries+=("$name"); fi; }

    _add "Blender" blender
    _add "mpv" mpv
    _add "VLC" vlc
    _add "OBS Studio" obs
    _add "Godot" godot
    _add "Inkscape" inkscape
    _add "GIMP" gimp
    _add "Krita" krita
    _add "DaVinci Resolve" resolve
    _add "glxgears (GL test)" glxgears
    _add "ffmpeg (terminal)" ffmpeg
    _add "Shell with NVIDIA env" bash

    local choice
    choice=$(printf '%s\n' "${entries[@]}" | rofi -dmenu -i -p "Launch on Discrete GPU (NVIDIA MX450)")
    [ -z "$choice" ] && exit 0

    case "$choice" in
        "Blender")           cmd="blender" ;;
        "mpv")               cmd="mpv" ;;
        "VLC")               cmd="vlc" ;;
        "OBS Studio")        cmd="obs" ;;
        "Godot")             cmd="godot" ;;
        "Inkscape")          cmd="inkscape" ;;
        "GIMP")              cmd="gimp" ;;
        "Krita")             cmd="krita" ;;
        "DaVinci Resolve")   cmd="resolve" ;;
        "glxgears (GL test)") cmd="glxgears" ;;
        "ffmpeg (terminal)") cmd="ffmpeg" ;;
        "Shell with NVIDIA env") cmd="${SHELL:-bash} -l" ;;
        *) cmd="$choice" ;;
    esac

    _notify "Discrete GPU" "Launching '$choice' on NVIDIA MX450"
    # Run in the background so the compositor is not blocked.
    env "${PRIME_ENV[@]}" setsid "$SHELL" -c "exec $cmd" >/dev/null 2>&1 &
    disown || true
    exit 0
}

# Apply the on-demand GPU policy. Every power profile keeps on-demand
# availability (Pop!_OS hybrid semantics); nothing here disables NVIDIA.
cmd_profile() {
    local profile
    profile=$(_effective_profile)
    cmd_policy auto
    _notify "GPU on-demand" "Power profile: $profile — NVIDIA MX450 available via prime-run when needed."
}

# NVIDIA PCI runtime PM control through the scoped privileged helper.
cmd_policy() {
    local mode="${1:-auto}"
    case "$mode" in
        auto|on) ;;
        *) echo "policy: use 'auto' or 'on'"; exit 2 ;;
    esac
    local cur
    cur=$(cat "$NV_SYS/power/control" 2>/dev/null || echo "unknown")
    if [ "$cur" = "$mode" ]; then
        echo "NVIDIA runtime PM already '${mode}'"
        return 0
    fi
    sudo /usr/local/sbin/hydra-power-helper nvidia "$mode"
    echo "NVIDIA runtime PM set to '${mode}'"
}

# Run a command on the discrete GPU with full PRIME offload.
cmd_run() {
    [ $# -ge 1 ] || { echo "usage: hydra-gpu run <cmd> [args...]"; exit 2; }
    _notify "Discrete GPU" "Running on NVIDIA MX450: $*"
    env "${PRIME_ENV[@]}" "$@"
}

# Auto-offload: whitelisted demanding apps automatically launch on NVIDIA via
# PATH wrappers. Intel stays the default GPU for everything else. Reversible.
AUTO_APPS=(blender godot godot4 unity-hub obs resolve davinci-resolve darktable krita)

cmd_auto() {
    local mode="${1:-status}" app active=()
    case "$mode" in
        on)
            for app in "${AUTO_APPS[@]}"; do
                [ -e "$HOME/.local/bin/$app" ] || ln -s hydra-auto-prime "$HOME/.local/bin/$app"
            done
            echo "Auto-offload ON — on NVIDIA when launched: ${AUTO_APPS[*]}"
            echo "Everything else keeps the Intel GPU. To disable: hydra-gpu auto off"
            ;;
        off)
            for app in "${AUTO_APPS[@]}"; do
                rm -f "$HOME/.local/bin/$app"
            done
            echo "Auto-offload OFF — all apps use the Intel GPU."
            ;;
        status|*)
            for app in "${AUTO_APPS[@]}"; do
                [ -L "$HOME/.local/bin/$app" ] && active+=("$app")
            done
            if [ "${#active[@]}" -gt 0 ]; then
                echo "Auto-offload ON — auto-NVIDIA apps: ${active[*]}"
            else
                echo "Auto-offload OFF — all apps use the Intel GPU."
            fi
            ;;
    esac
}

cmd="${1:-status}"
shift || true
case "$cmd" in
    status)  cmd_status ;;
    notif)   cmd_notif ;;
    menu)    cmd_menu ;;
    profile) cmd_profile ;;
    policy)  cmd_policy "${1:-auto}" ;;
    run)     cmd_run "$@" ;;
    auto)    cmd_auto "${1:-status}" ;;
    *) echo "usage: hydra-gpu {status|notif|menu|profile|policy|run|auto}"; exit 2 ;;
esac
