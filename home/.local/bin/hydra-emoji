#!/bin/bash
# VALKYX emoji picker — hands off to the Valkyx launcher's EMOJI section,
# which lists the same curated set and copies/typess the pick. The picker used to
# be its own `fuzzel --dmenu` window: a second, unaccented list for the same job.
# Usage: valkyx-emoji [search-term]

LIST="$HOME/.local/share/valkyx-emoji.txt"

# Generate list on first run (curated common emojis)
