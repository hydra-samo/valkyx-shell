#!/usr/bin/env bash
#
# axora-auto-prime — run a demanding app on the NVIDIA MX450 automatically.
#
# Invoked through symlinks named after the target app inside ~/.local/bin
# (e.g. ~/.local/bin/blender -> axora-auto-prime). Because ~/.local/bin is
# first in PATH, launching `blender` from a terminal, rofi, or .desktop entry
# automatically uses PRIME render offload (NVIDIA). Everything else keeps
# using the Intel Iris Xe as the default GPU.
#
# Safe by design:
#   * Intel stays the system GPU — nothing is ever globally switched.
#   * Only whitelisted app names are wrapped (see axora-gpu auto).
#   * Fully reversible: `axora-gpu auto off` removes every wrapper.
#   * If the real app is not installed, this prints a clear error and exits
#     non-zero instead of silently failing.
#
set -uo pipefail

WRAP_DIR="$HOME/.local/bin"

if [ "${1:-}" = "--run" ]; then
    APP="${2:-}"
    shift 2 || true
else
    APP="$(basename "$0")"
fi

if [ -z "$APP" ]; then
    echo "usage: $(basename "$0") [--run <app>] [args...]" >&2
    exit 2
fi

# Locate the real binary, ignoring this wrapper directory so we never
# recurse into ourselves. Covers /usr/bin, /usr/local/bin, /opt, etc.
real="$(type -aP "$APP" 2>/dev/null | grep -v "^${WRAP_DIR}/" | head -1)"
# Vendored apps live outside PATH (e.g. /opt/resolve/bin/resolve). Without this
# the wrapper reports "'resolve' is not installed" even though it is installed.
if [ -z "$real" ] && [ -x "/opt/$APP/bin/$APP" ]; then
    real="/opt/$APP/bin/$APP"
fi

if [ -z "$real" ]; then
    echo "axora-auto-prime: '$APP' is not installed." >&2
    echo "  Install it, or launch manually with: axora-gpu run $APP" >&2
    exit 1
fi

# Hand off to the standard PRIME offload wrapper (Intel stays default;
# only this process uses NVIDIA).
if command -v prime-run >/dev/null 2>&1; then
    exec prime-run "$real" "$@"
else
    exec "$real" "$@"
fi
