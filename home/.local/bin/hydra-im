#!/bin/sh
# valkyx-im — the compositor's keyboard layout (hyprland.lua: input.kb_layout).
# State lives in Hyprland, so every app follows, native + XWayland. fcitx is NOT
# in this path: its hotkeys never fired in this session and SetCurrentIM only
# reached some clients.
#
#   valkyx-im            -> prints "us" or "ara"
#   valkyx-im toggle     -> switches to the other one, prints the new one
#   valkyx-im set us|ara -> absolute set, idempotent (what the UI should call)
#   valkyx-im restore    -> re-apply the cached state after a config reload
#
# The read-modify-write below runs under flock and re-reads *inside* the lock.
# Without it, N concurrent toggles all read the same pre-toggle value and all
# write the same target: 6 presses = 1 switch. That was the "press it 1000
# times" bug. Do not drop the lock.
LOCK="$HOME/.cache/valkyx-im.lock"

# state read: one cheap IPC call. `hyprctl devices` also works but greps 15
# keyboards and is ~10x slower.
cur() {
	case "$(hyprctl getoption input:kb_layout 2>/dev/null)" in
		*arabic*|*ara*) echo ara ;;
		*) echo us ;;
	esac
}

apply() {
	hyprctl eval "hl.config({ input = { kb_layout = '$1' } })" >/dev/null 2>&1
	echo "$1" >"$HOME/.cache/valkyx-im-state" 2>/dev/null
}

# called from hyprland.lua on config load: every `hyprctl reload` rebuilds the
# keymap from the file's kb_layout, which would silently snap back to "us"
[ "$1" = restore ] && exec 9>>"$LOCK" && flock 9 && {
	w=$(cat "$HOME/.cache/valkyx-im-state" 2>/dev/null)
	case "$w" in
		ara | us) apply "$w" ;;
		*) apply us ;;
	esac
	exit 0
}

case "$1" in
	'') exec 9>>"$LOCK" && flock 9 && cur && exit 0 ;;
	set)
		[ "$2" = us ] || [ "$2" = ara ] || { echo "usage: valkyx-im set us|ara" >&2; exit 2; }
		exec 9>>"$LOCK" && flock 9 && apply "$2" && cur
		exit 0
		;;
	toggle) : ;;
	*) echo "usage: valkyx-im [toggle|set us|ara|restore]" >&2; exit 2 ;;
esac

# who asked — Hyprland bind (exec_cmd) or the topbar (quickshell Process)?
# Distinguishes "the key never fired" from "the key fired but the switch failed".
# via=Hyprland = a key fired, via=qs = topbar click.
echo "$(date +%T) via=$(ps -o comm= -p $PPID 2>/dev/null | tr -d ' ') arg=$1" \
	>>"$HOME/.cache/valkyx-im.log" 2>/dev/null

exec 9>>"$LOCK" && flock 9

# read INSIDE the lock — this ordering is the whole fix
case "$(cur)" in
	ara) want=us ;;
	*) want=ara ;;
esac
apply "$want"

# the keymap rebuild is async; poll briefly so the topbar label is never stale
i=0
while [ "$i" -lt 12 ]; do
	got=$(cur)
	[ "$got" = "$want" ] && break
	sleep 0.08
	i=$((i + 1))
done
echo "$got"
