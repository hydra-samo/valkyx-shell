#!/usr/bin/env bash
# hydra-tailscale-status — compact tailscale status lines for the top bar.
# Output: up:<1|0> / self:<host>|<ip> / peer:<host>|<ip>|<os>|<online>
ts=$(tailscale status --json 2>/dev/null) || { echo "up:0"; exit 0; }
echo "$ts" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    print("up:0"); sys.exit(0)
s = d.get("Self", {}) or {}
ip = (s.get("TailscaleIPs") or [None])[0] or ""
ips = s.get("TailscaleIPs")
print("up:" + ("1" if d.get("BackendState") == "Running" and ips else "0"))
print("self:%s|%s" % (s.get("HostName", ""), ip))
for k, p in (d.get("Peer", {}) or {}).items():
    pip = (p.get("TailscaleIPs") or [None])[0] or ""
    print("peer:%s|%s|%s|%s" % (p.get("HostName", k), pip, p.get("OS", ""), "1" if p.get("Online") else "0"))
'