#!/usr/bin/env bash
# Ask one web seat. Retries ONCE, but never after the prompt has already been
# sent into the conversation: a retry then would post a second copy into the
# same persistent chat, which is the echo/self-loop, not a recovery.
#
# The seat kit lives in ~/axora-assistant/webai (moved out of ~/automata).
# The prompt goes on stdin: a full agent payload is past the 128 KB argv limit
# and execve would fail with E2BIG.
set -u
SVC="${1:-}"; shift || true
P="$*"
[ -n "$P" ] || P="$(cat)"
SEAT_PY="$HOME/axora-assistant/webai/seat.py"
run_once() {
  case "$SVC" in
    gemini|chatgpt|kimi|claude) printf '%s' "$P" | python3 "$SEAT_PY" "$SVC" ;;
    *) echo "usage: axora-ai <gemini|chatgpt|kimi|claude> [prompt]" >&2; exit 2;;
  esac
}
ERR="$(mktemp)"; trap 'rm -f "$ERR"' EXIT
if run_once 2>"$ERR"; then cat "$ERR" >&2; exit 0; fi
cat "$ERR" >&2                      # keep the AIWEB_* reason visible to the caller
grep -q 'AIWEB_SENT:' "$ERR" && exit 1   # already delivered: do not send twice
run_once
