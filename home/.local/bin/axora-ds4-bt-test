#!/usr/bin/env bash
# Wireless study: capture a whole controller-initiated BT link from PS press.
# Usage (pad MUST be unplugged, powered from BT, then press PS to connect):
#   axora-ds4-bt-test [seconds]
set -u
SECS="${1:-25}"
SIG="/tmp/ds4-wireless-sig-$(date +%Y%m%d-%H%M%S).btsnoop"
echo "capturing $SECS s to $SIG - press the PS button now"
sudo btmon -w "$SIG" >/tmp/btmon-cap.log 2>&1 &
BTM=$!
sleep "$SECS"
sudo kill "$BTM" 2>/dev/null
echo "===== signature ====="
sudo btmon -r "$SIG" 2>/dev/null | rg 'PSM 17|Refusing|reap|set_encryption|Encryption Change|0x0005|SUCCESS|AUTHENTICATION|Connect Pending|Confirm|Unknown|Reject' | head -30
echo "===== key line ====="
sudo btmon -r "$SIG" 2>/dev/null | rg -B2 -A2 'PSM 17|Refusing' | head -12