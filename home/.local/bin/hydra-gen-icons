#!/usr/bin/env bash
# hydra-gen-icons — render HYDRA's custom glyph icons, tinted per accent theme.
# Output: ~/.cache/hydra-icons/<theme>/<name>.png for every theme (or one theme).
# Themes + accents mirror HydraTheme.themes (hydra shell). rsvg-convert renders.
set -euo pipefail

# themeName | accentHex | bgHex
themes() {
  printf '%s\n' \
    "Hydra|#00A86B|#0a1210" \
    "Violet|#7C4DFF|#0d0a14" \
    "Ocean|#2196F3|#0a1016" \
    "Ember|#FF5252|#140a0a" \
    "Amber|#FF9800|#14100a" \
    "Cyan|#00BCD4|#0a1214"
}

accent_of() { # theme name → accent hex (default Hydra)
  themes | awk -F'|' -v t="$1" '$1==t{print $2; exit}'
  echo "#00A86B"
}

# ── glyph SVG templates (viewBox 0 0 48 48, monoline geometric)
# ACCENT / BG are substituted. stroke-width 2.75, round joins (matches the
# angular cobra mark without turning into a literal snake).
glyph_tpl() { # $1 = glyph name
  case "$1" in
    terminal)
      cat <<SVG
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48">
<rect x="5" y="7" width="38" height="34" rx="7" fill="none" stroke="ACCENT" stroke-width="2.75"/>
<path d="M14 18 L21 24 L14 30" fill="none" stroke="ACCENT" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
<path d="M25 30 H33" stroke="ACCENT" stroke-width="2.5" stroke-linecap="round"/>
</svg>
SVG
      ;;
    browser)
      cat <<SVG
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48">
<circle cx="24" cy="29" r="14" fill="none" stroke="ACCENT" stroke-width="2.75"/>
<path d="M24 29 L34 19" stroke="ACCENT" stroke-width="2.5" stroke-linecap="round"/>
<path d="M9 18 L39 18" stroke="ACCENT" stroke-width="2.75" stroke-linecap="round"/>
<path d="M17 5 L17 12 M31 5 L31 12" stroke="ACCENT" stroke-width="2.75" stroke-linecap="round"/>
</svg>
SVG
      ;;
    files)
      cat <<SVG
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48">
<path d="M5 15 a4 4 0 0 1 4-4 h9 l4 5 h17 a4 4 0 0 1 4 4 v15 a4 4 0 0 1-4 4 H9 a4 4 0 0 1-4-4 Z"
  fill="BGTLIGHT" stroke="ACCENT" stroke-width="2.75" stroke-linejoin="round"/>
<path d="M5 20 H43" stroke="ACCENT" stroke-width="2.5" stroke-linecap="round"/>
</svg>
SVG
      ;;
    editor)
      cat <<SVG
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48">
<path d="M13 12 L4 24 L13 36" fill="none" stroke="ACCENT" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"/>
<path d="M35 12 L44 24 L35 36" fill="none" stroke="ACCENT" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"/>
<path d="M27 9 L21 39" stroke="ACCENT" stroke-width="2.75" stroke-linecap="round"/>
</svg>
SVG
      ;;
    blender)
      cat <<SVG
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48">
<circle cx="24" cy="24" r="14.5" fill="none" stroke="ACCENT" stroke-width="2.75"/>
<circle cx="24" cy="24" r="5" fill="none" stroke="ACCENT" stroke-width="2.5"/>
<path d="M24 9.5 A14.5 14.5 0 0 1 38.5 24 M24 38.5 A14.5 14.5 0 0 1 9.5 24" fill="none" stroke="ACCENT" stroke-width="2.5" stroke-dasharray="6 6"/>
</svg>
SVG
      ;;
    resolve)
      cat <<SVG
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48">
<rect x="6" y="6" width="36" height="36" rx="9" fill="none" stroke="ACCENT" stroke-width="2.75"/>
<path d="M19 15 L34 24 L19 33 Z" fill="ACCENT" stroke="none" opacity="0.92"/>
</svg>
SVG
      ;;
    game)
      cat <<SVG
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48">
<rect x="4" y="13" width="40" height="22" rx="11" fill="none" stroke="ACCENT" stroke-width="2.75"/>
<path d="M14 21 V27 M11 24 H17" stroke="ACCENT" stroke-width="2.5" stroke-linecap="round"/>
<circle cx="33" cy="22" r="1.8" fill="ACCENT"/><circle cx="37" cy="26" r="1.8" fill="ACCENT"/>
</svg>
SVG
      ;;
    folder)
      cat <<SVG
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48">
<path d="M5 14 a4 4 0 0 1 4-4 h9 l4 5 h17 a4 4 0 0 1 4 4 v15 a4 4 0 0 1-4 4 H9 a4 4 0 0 1-4-4 Z"
  fill="none" stroke="ACCENT" stroke-width="2.75" stroke-linejoin="round"/>
</svg>
SVG
      ;;
    window)
      cat <<SVG
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48">
<rect x="5" y="8" width="38" height="32" rx="6" fill="none" stroke="ACCENT" stroke-width="2.75"/>
<path d="M5 17 H43" stroke="ACCENT" stroke-width="2.5"/>
<circle cx="11" cy="12.5" r="1.4" fill="ACCENT"/><circle cx="16" cy="12.5" r="1.4" fill="ACCENT"/>
<path d="M15 25 L22 30 L15 35" fill="none" stroke="ACCENT" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
<path d="M26 35 H34" stroke="ACCENT" stroke-width="2.5" stroke-linecap="round"/>
</svg>
SVG
      ;;
    terminal-app)
      cat <<SVG
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">
<rect x="6" y="6" width="52" height="52" rx="14" fill="BGTLIGHT" stroke="ACCENT" stroke-width="3"/>
<path d="M20 26 L29 33 L20 40" fill="none" stroke="ACCENT" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
<path d="M34 40 H44" stroke="ACCENT" stroke-width="3" stroke-linecap="round"/>
</svg>
SVG
      ;;
    browser-app)
      cat <<SVG
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">
<rect x="6" y="6" width="52" height="52" rx="14" fill="BGTLIGHT" stroke="ACCENT" stroke-width="3"/>
<circle cx="32" cy="40" r="15" fill="none" stroke="ACCENT" stroke-width="3"/>
<path d="M32 40 L44 28" stroke="ACCENT" stroke-width="2.75" stroke-linecap="round"/>
<path d="M14 25 L50 25" stroke="ACCENT" stroke-width="3" stroke-linecap="round"/>
<circle cx="23" cy="17" r="2.5" fill="ACCENT"/><circle cx="33" cy="17" r="2.5" fill="ACCENT"/>
</svg>
SVG
      ;;
    files-app)
      cat <<SVG
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">
<rect x="6" y="6" width="52" height="52" rx="14" fill="BGTLIGHT" stroke="ACCENT" stroke-width="3"/>
<path d="M10 22 a4 4 0 0 1 4-4 h11 l5 6 h20 a4 4 0 0 1 4 4 v20 a4 4 0 0 1-4 4 H14 a4 4 0 0 1-4-4 Z"
  fill="none" stroke="ACCENT" stroke-width="3" stroke-linejoin="round"/>
<path d="M10 28 H54" stroke="ACCENT" stroke-width="2.75" stroke-linecap="round"/>
</svg>
SVG
      ;;
    editor-app)
      cat <<SVG
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">
<rect x="6" y="6" width="52" height="52" rx="14" fill="BGTLIGHT" stroke="ACCENT" stroke-width="3"/>
<path d="M18 17 L6 32 L18 47" fill="none" stroke="ACCENT" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
<path d="M46 17 L58 32 L46 47" fill="none" stroke="ACCENT" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
<path d="M36 12 L28 52" stroke="ACCENT" stroke-width="3" stroke-linecap="round"/>
</svg>
SVG
      ;;
    blender-app)
      cat <<SVG
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">
<rect x="6" y="6" width="52" height="52" rx="14" fill="BGTLIGHT" stroke="ACCENT" stroke-width="3"/>
<circle cx="32" cy="32" r="17" fill="none" stroke="ACCENT" stroke-width="3"/>
<circle cx="32" cy="32" r="6" fill="none" stroke="ACCENT" stroke-width="2.75"/>
<path d="M32 15 A17 17 0 0 1 49 32 M32 49 A17 17 0 0 1 15 32" fill="none" stroke="ACCENT" stroke-width="2.75" stroke-dasharray="6 6"/>
</svg>
SVG
      ;;
    resolve-app)
      cat <<SVG
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">
<rect x="6" y="6" width="52" height="52" rx="14" fill="BGTLIGHT" stroke="ACCENT" stroke-width="3"/>
<path d="M24 18 L46 32 L24 46 Z" fill="ACCENT" stroke="none" opacity="0.92"/>
</svg>
SVG
      ;;
    swap)
      cat <<SVG
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48">
<path d="M14 6 L5 14 L14 22" fill="none" stroke="ACCENT" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"/>
<path d="M5 14 H36" stroke="ACCENT" stroke-width="2.75" stroke-linecap="round"/>
<path d="M34 26 L43 34 L34 42" fill="none" stroke="ACCENT" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"/>
<path d="M43 34 H12" stroke="ACCENT" stroke-width="2.75" stroke-linecap="round"/>
</svg>
SVG
      ;;
    clip)
      cat <<SVG
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48">
<path d="M17 9 h14 v6 h-14 Z" fill="BGTLIGHT" stroke="ACCENT" stroke-width="2.5" stroke-linejoin="round"/>
<rect x="8" y="15" width="32" height="26" rx="5" fill="none" stroke="ACCENT" stroke-width="2.75"/>
<path d="M15 22 H33 M15 28 H33 M15 34 H27" stroke="ACCENT" stroke-width="2.5" stroke-linecap="round"/>
</svg>
SVG
      ;;
    brand)
      # HYDRA control-panel mark: rounded plate + angular cobra-hood hood top
      # + three picker/slider rows (sidebar · launcher · settings spirit).
      cat <<SVG
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48">
<rect x="3" y="3" width="42" height="42" rx="11" fill="BGTLIGHT" stroke="ACCENT" stroke-width="2.75"/>
<path d="M24 9 L33 18 L15 18 Z" fill="ACCENT" stroke="none" opacity="0.9"/>
<path d="M15 18 L33 18 L30 25 L18 25 Z" fill="none" stroke="ACCENT" stroke-width="2.5" stroke-linejoin="round"/>
<path d="M18 30 H30 M20 35 H28" stroke="ACCENT" stroke-width="2.5" stroke-linecap="round"/>
</svg>
SVG
      ;;
  esac
}

# ── render one theme's glyph into the cache dir ──
render_theme() { # $1 = theme name, $2 = accent hex, $3 = bg hex
  local dir="$HOME/.cache/hydra-icons/$1"
  mkdir -p "$dir"
  # brighten bg for plate fills so glyphs read on translucent panels
  local tfill="#1d2a24"
  case "$1" in
    Violet) tfill="#241d33" ;; Ocean) tfill="#1d2833" ;;
    Ember)  tfill="#33201e" ;; Amber) tfill="#33291d" ;;
    Cyan)   tfill="#1d2c30" ;; esac
  for g in terminal browser files editor blender resolve game folder window \
           terminal-app browser-app files-app editor-app blender-app resolve-app clip brand swap; do
    local svg="$dir/.$g.svg" png="$dir/$g.png"
    glyph_tpl "$g" | sed "s/ACCENT/$2/g; s/BGTLIGHT/$tfill/g" > "$svg"
    rsvg-convert -w 96 -h 96 -b none "$svg" -o "$png" 2>/dev/null
    rm -f "$svg"
  done
  echo "icons:$1"
}

# ── entrypoint ──
case "${1:-}" in
  --all)
    while IFS='|' read -r t a b; do render_theme "$t" "$a" "$b"; done < <(themes)
    ;;
  *)
    t="${1:-Hydra}"; a="$(accent_of "$t")"; b="#0a1210"
    case "$t" in Violet) b="#0d0a14" ;; Ocean) b="#0a1016" ;; Ember) b="#140a0a" ;; Amber) b="#14100a" ;; Cyan) b="#0a1214" ;; esac
    render_theme "$t" "$a" "$b"
    ;;
esac