#!/usr/bin/env bash
# axora-shell-sync — sync config between LIVE and SANDBOX (direction required).
# Live is a REAL dir at ~/.config/quickshell/axora (permanent since Sep 13);
# the sandbox is the git-backed copy. State: live uses state.json, sandbox uses
# state.dev.json (the path lives inside AxoraState.qml, so each direction
# re-asserts its own persist path) — state.json files are excluded from rsync.
# Usage:
#   axora-shell-sync to-sandbox   # live → sandbox (re-baseline experiments on fresh live state)
#   axora-shell-sync to-live      # sandbox → live (promote verified experiments)
set -euo pipefail

LIVE=$HOME/.config/quickshell/axora
SBOX=$HOME/axora-sandbox/shell
DIR="${1:-}"

case "$DIR" in
  to-sandbox)
    rsync -a --delete --exclude='.git/' --exclude='state.json' --exclude='state.dev.json' "$LIVE/" "$SBOX/"
    sed -i 's#_persistPath: "$HOME/.config/axora/state.json"#_persistPath: "$HOME/.config/axora/state.dev.json"#' "$SBOX/core/AxoraState.qml"
    echo "live → sandbox synced (state isolation re-applied)."
    ;;
  to-live)
    rsync -a --delete --exclude='.git/' --exclude='state.json' --exclude='state.dev.json' "$SBOX/" "$LIVE/"
    sed -i 's#_persistPath: "$HOME/.config/axora/state.dev.json"#_persistPath: "$HOME/.config/axora/state.json"#' "$LIVE/core/AxoraState.qml"
    echo "sandbox → live synced (persist path re-asserted to state.json)."
    echo "reload: axora-shell-reload   (do NOT hand-roll this: a bare pkill is SIGTERM, which orphans the PanelWindows as pid: -1 surfaces that hold the seat's input grab)"
    ;;
  *)
    echo "usage: $0 to-sandbox|to-live" >&2; exit 1;;
esac