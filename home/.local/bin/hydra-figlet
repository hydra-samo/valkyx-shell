#!/bin/bash
# hydra-figlet — the HYDRA wordmark in slanted ASCII, coloured with the
# CURRENT accent so the three tools never disagree with the running theme.
#
#   hydra-figlet            # the bare wordmark
#   hydra-figlet hydra doctor   # wordmark + a right-aligned caption on its last row
#
# figlet is the source of truth for the glyphs (fonts live in
# /usr/share/figlet). `slant` is the one that reads as italic at 80 columns.
set -uo pipefail

FONT=slant
WORD="${1:-hydra}"
CAPTION="${2:-}"

# 24-bit ANSI from the persisted accent, so the banner follows the theme.
read -r R G B <<<"$(python3 - <<'PY' 2>/dev/null || echo "0 168 107"
import json, os
try:
    h = json.load(open(os.path.expanduser("~/.config/hydra/state.json")))["accent"].lstrip("#")
    print(int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16))
except Exception:
    print(0, 168, 107)
PY
)"
A=$'\033[38;2;'"${R}"';'"${G}"';'"${B}"'m'
D=$'\033[2m'
RST=$'\033[0m'

# figlet -w keeps the 5-line slant block from wrapping in an 80-col terminal.
figlet -f "$FONT" -w 74 "$WORD" 2>/dev/null | while IFS= read -r line; do
	printf '  %s%s%s\n' "$A" "$line" "$RST"
done

# Caption sits on the wordmark's baseline row, right-aligned to the block.
if [ -n "$CAPTION" ]; then
	w=$(figlet -f "$FONT" -w 74 "$WORD" 2>/dev/null | awk 'NR==1{print length($0)}')
	pad=$(printf '%.0s ' $(seq 1 $((w - ${#CAPTION} - 1))))
	printf '  %s%s%s%s%s\n' "$A" "$pad" "$RST" "$D" "$CAPTION"
fi
