#!/usr/bin/env bash
# Append an AI summary of a note to the note itself.
# Usage: axora-obsidian-ai <note.md>  (reads the note, runs a free local
# subagent over it, appends the reply as a block at the bottom).
set -u
NOTE="${1:-}"
[ -z "$NOTE" ] && { echo "usage: axora-obsidian-ai <note.md>"; exit 2; }
[ -f "$NOTE" ] || { echo "no such note: $NOTE"; exit 2; }
BODY="$(cat "$NOTE")"
PROMPT="Summarize the key points and extract any to-dos from the following note. Be concise and use markdown bullets.\n\n$BODY"
if command -v opencode >/dev/null; then
  OUT="$(timeout 90 opencode run "$PROMPT" 2>/dev/null | tail -n +1)"
else
  OUT=""
fi
if [ -z "$OUT" ]; then
  OUT="_(no AI response — run a free model)_"
fi
{
  echo ""
  echo "---"
  echo "### AI note ($(date '+%Y-%m-%d %H:%M'))"
  echo "$OUT"
} >> "$NOTE"
echo "appended AI note to $NOTE"
