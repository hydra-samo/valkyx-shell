#!/usr/bin/env python3
import json, subprocess, sys
try:
    d = json.loads(subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True).stdout or "[]")
except Exception:
    sys.exit(0)
w = {}
for c in d:
    cls, ws = c.get("class"), c.get("workspace") or {}
    n = ws.get("name")
    if c.get("mapped") and cls and n:
        w.setdefault(n, []).append(cls)
for n in sorted(w):
    print(f"{n}:{','.join(sorted(set(w[n])))}")