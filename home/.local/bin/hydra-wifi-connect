#!/usr/bin/env bash
# valkyx-wifi-connect <ssid> <security> — connect via nmcli, prompting for the
# password in the shell's own masked prompt when the network is secured.
#
# The prompt has been three things: `fuzzel -d --password`, then `zenity --password`
# (correct, but the last foreign GTK surface left in the session), now
# shell/ValkyxPassword.qml. It cannot be a launcher SECTION: a launcher is
# search-and-select, a WiFi password is one masked field.
#
# Handshake: this script picks a private tmpfs path and asks the shell to prompt.
# The shell writes the secret there (":" means cancelled) and this script polls.
set -uo pipefail

ssid="${1:?usage: valkyx-wifi-connect <ssid> [security]}"
sec="${2:-}"

if [ "$sec" = "" ] || [ "$sec" = "--" ]; then
    nmcli dev wifi connect "$ssid" >/dev/null 2>&1
    exit 0
fi

if ! command -v qs >/dev/null 2>&1; then
    printf 'valkyx-wifi-connect: shell not available, cannot prompt for a password\n' >&2
    exit 1
fi

# Not pre-created: the shell must be the only writer, so "file exists and is
# non-empty" unambiguously means the user answered. A cancelled prompt writes the
# ":" sentinel, which is also non-empty — so both outcomes end the wait at once.
target="$(mktemp -u "${XDG_RUNTIME_DIR:-/tmp}/valkyx-pass.XXXXXXXX")"
trap 'rm -f "$target"' EXIT

if ! qs -c valkyx ipc call password open "Join ${ssid}|${target}" >/dev/null 2>&1; then
    printf 'valkyx-wifi-connect: could not reach the shell to prompt (is it running?)\n' >&2
    exit 1
fi

pass=""
for _ in $(seq 1 180); do   # 90s ceiling: a human, not a timeout race
    if [ -s "$target" ]; then
        pass="$(cat "$target" 2>/dev/null)"
        break
    fi
    sleep 0.5
done

[ -n "$pass" ] || exit 0            # timed out == treat as cancelled
[ "$pass" = ":" ] && exit 0         # explicit cancel

nmcli dev wifi connect "$ssid" password "$pass" >/dev/null 2>&1
# Persist the key. nmcli creates the profile agent-owned (psk-flags=1), which
# hands the secret to a secret agent — and no agent is registered in this session,
# so the password is discarded and you get re-prompted every single time.
# psk-flags=0 stores it in the root-only system connection file, same as the
# profiles that already work (A2030, idoomAdsl).
nmcli con modify "$ssid" 802-11-wireless-security.psk-flags 0 >/dev/null 2>&1
