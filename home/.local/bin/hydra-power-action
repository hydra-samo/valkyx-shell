#!/usr/bin/env bash
# hydra-power-action <lock|logout|suspend|reboot|shutdown>
#
# Single entry point for the power menu, and the reason a broken button can
# never be silent again. The shell's exec runner discards stdout+stderr, which
# is how `hydra-logout` shipped as a button that did nothing at all: the command
# was exec'd, failed instantly, and left no trace. Everything now lands in
# hydra-power.log.
set -u

LOG="${XDG_STATE_HOME:-$HOME/.local/state}/hydra-power.log"
mkdir -p "$(dirname "$LOG")"
action="${1:-}"
note() { printf '%s %-9s %s\n' "$(date -Iseconds)" "${action:-none}" "$*" >> "$LOG"; }

note "requested"
# Absolute paths for the hydra-* helpers: this script is exec'd from a Quickshell
# `sh -c` that inherits Hyprland's PATH, which does NOT include ~/.local/bin.
case "$action" in
    lock)
        exec /home/hydrasamo/.local/bin/hydra-lock
        ;;
    logout)
        exec /home/hydrasamo/.local/bin/hydra-logout
        ;;
    reboot|shutdown|hibernate)
        what=poweroff; [ "$action" = reboot ] && what=reboot
        # --no-block so the caller's exec runner is not held for the whole
        # shutdown, and so a failure comes back as an exit code we can log.
        systemctl --no-block "$what"
        rc=$?
        note "systemctl rc=$rc"
        exit $rc
        ;;
    suspend)
        # Blank first, for instant feedback. /sys/power/mem_sleep is s2idle-only
        # on this box (firmware reports S0/S4/S5, no S3), so user space keeps
        # running and the panel stays lit — without this the button reads as
        # "nothing happened".
        #
        # The LOCK deliberately lives in the system-sleep 'pre' hook, not here.
        # systemd runs that hook for EVERY trigger — lid close, logind idle, this
        # button — so putting the lock here meant closing the lid suspended with
        # the session unlocked and the panel lit, while this button did it right.
        # One hook, one behaviour. The 'pre' hook blanks again, which is a no-op.
        hydra-dispatch dpms off >/dev/null 2>&1
        systemctl --no-block suspend
        rc=$?
        note "systemctl rc=$rc"
        # If the suspend was refused, do not leave the user staring at a black
        # screen — put the panel straight back.
        [ "$rc" -ne 0 ] && hydra-dispatch dpms on >/dev/null 2>&1
        exit $rc
        ;;
    *)
        note "unknown action"
        exit 2
        ;;
esac
