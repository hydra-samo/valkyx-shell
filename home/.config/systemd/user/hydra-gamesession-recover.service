[Unit]
# Restores services suspended by hydra-gamesession if the session ended while
# suspended - a crash, a kill -9, or a power cut. No-ops when no marker exists.
Description=Recover Hydra services left suspended by a game session
DefaultDependencies=no
After=default.target

[Service]
Type=oneshot
RemainAfterExit=no
ExecStart=%h/.local/bin/hydra-gamesession-recover

[Install]
WantedBy=default.target
