[Unit]
Description=HYDRA SAMO LABS - always-on local portfolio (vite, HMR)
After=network.target

[Service]
WorkingDirectory=%h/Projects HYDRA/HYDRA SAMO LABS/PORTFOLIO
# Binds 0.0.0.0 so ONE process serves every origin that matters:
#   http://127.0.0.1:1717  -> the Hydra Console / Hydra Studio app windows
#   http://100.71.210.6:1717 -> the plain-HTTP tailnet URL the phone bookmarks
#   tailscale serve /      -> proxies to 127.0.0.1:1717 (HTTPS :443)
# Passing --host twice did NOT do this: Vite keeps only the last one, which left
# loopback unbound and the desktop windows pointing at nothing.
ExecStart=$HOME/.config/nvm/versions/node/v24.18.1/bin/npm run dev -- --port=1717 --host=0.0.0.0 --strictPort
Restart=always
RestartSec=3
Environment=BROWSER=none

[Install]
WantedBy=default.target
