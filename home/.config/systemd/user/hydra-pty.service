[Unit]
Description=hydra terminal pty bridge (opencode over ws)
After=network-online.target

[Service]
WorkingDirectory=$HOME/.local/lib/hydra-hub
Environment=PORT=7682
Environment=TERM=xterm-256color
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
