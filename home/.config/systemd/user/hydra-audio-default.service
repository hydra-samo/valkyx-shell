[Unit]
Description=Set default audio input to DMIC (Mic1)
After=pipewire.service pipewire-pulse.service wireplumber.service
PartOf=pipewire-pulse.service

[Service]
Type=oneshot
Restart=on-failure
RestartSec=3
ExecStart=/bin/bash -c 'for i in $(seq 1 20); do pactl get-default-sink && break; sleep 1; done; pactl set-default-source alsa_input.pci-0000_00_1f.3-platform-skl_hda_dsp_generic.HiFi__Mic1__source; amixer -c0 sset "Dmic0" 60% >/dev/null 2>&1 || true'

[Install]
WantedBy=default.target
