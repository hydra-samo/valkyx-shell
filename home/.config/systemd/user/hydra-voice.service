[Unit]
Description=Hydra Assistant voice (mic -> wake word -> whisper -> TTS)
After=hydra-assistant.service
StartLimitIntervalSec=30
StartLimitBurst=2

[Service]
ExecStart=%h/hydra-assistant/.venv/bin/python %h/hydra-assistant/voice/wake.py
Restart=on-failure
RestartSec=3
Environment=PATH=%h/.opencode/bin:%h/.local/bin:/usr/local/bin:/usr/bin
Environment=XDG_RUNTIME_DIR=/run/user/1000

[Install]
WantedBy=default.target
