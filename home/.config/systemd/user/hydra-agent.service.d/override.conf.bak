# Bind the tailnet IP too so the phone can reach opencode at
# http://100.71.210.6:17171/ . NOT 0.0.0.0 — that would publish a remote-code-
# execution surface to every device on the cafe wifi.
[Service]
ExecStart=
ExecStart=$HOME/.opencode/bin/opencode serve --port=17171 --hostname=100.71.210.6 --log-level=WARN
