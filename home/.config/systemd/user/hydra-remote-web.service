[Unit]
Description=HYDRA phone control surface - loopback only, published by tailscale serve

[Service]
Type=simple
ExecStart=%h/.local/bin/hydra-remote-web-wrap --port 8444
Restart=on-failure
RestartSec=3
# Loopback only. tailscale serve is the network boundary; this process never binds
# a routable address, so it cannot be reached even if the machine is on a LAN.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
