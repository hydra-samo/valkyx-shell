[Unit]
Description=Hydra council + seat sync (refresh the free tier, re-seat, doctor the opencode config)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/home/hydrasamo/council-harness/hydra-council-sync
# systemd's default PATH is minimal: without this the unit cannot find
# `opencode` and the catalogue comes back empty.
Environment=PATH=/home/hydrasamo/.local/bin:/home/hydrasamo/.opencode/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/hydrasamo
# The sync talks to the provider, to Helium (for the web seats) and to the
# opencode server. Give it room; it is a timer job, not a daemon.
TimeoutStartSec=1800
# stdout is the point: systemd captures it into the user journal.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
