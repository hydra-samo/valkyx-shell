[Unit]
Description=HYDRA Shell Sandbox agent - scoped opencode for the shell sandbox (port 17172)
After=hydra-studio.service

[Service]
WorkingDirectory=%h/hydra-sandbox/shell
ExecStart=/home/hydrasamo/.opencode/bin/opencode serve --port=17172 --hostname=127.0.0.1 --log-level=warn
EnvironmentFile=%h/.config/opencode/explabs.env
Restart=always
RestartSec=3

[Install]
WantedBy=default.target